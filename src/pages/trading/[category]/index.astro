---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import Section from '../../../components/ui/Section.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { categoryList, categoryPath, projectPath } from '../../../config/tracks';
import { breadcrumbLd, collectionPageLd } from '../../../config/seo';
import { accentFor, categoryAccent } from '../../../config/accents';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  return categoryList('trading').map(([category, meta]) => ({
    params: { category },
    props: { category, meta },
  }));
}

const { category, meta } = Astro.props;

const catAccent = categoryAccent(category);

const products = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'trading' && data.category === category
)).sort((a, b) => a.data.order - b.data.order);

// Colour is positional, so the grid and each product page agree on the hue.
const productIds = products.map((p) => p.id);

// One tile icon per shelf.
const categoryIcon: Record<string, string> = {
  'expert-advisors': 'mingcute:stock-line',
  tools: 'mingcute:tool-line',
};
const tileIcon = categoryIcon[category] ?? 'mingcute:tool-line';

const statusLabel: Record<string, string> = {
  live: 'Live now',
  waitlist: 'Waitlist open',
  'coming-soon': 'Coming soon',
};
---
<BaseLayout
  title={`${meta.label} for MetaTrader 5 | Foxe Labs`}
  description={`${meta.label} by Foxe Labs — engineered risk-first for prop firm and serious retail traders.`}
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Trading', path: '/trading' },
      { name: meta.label, path: categoryPath('trading', category) },
    ]),
    collectionPageLd({
      name: `${meta.label} for MetaTrader 5`,
      description: `${meta.label} by Foxe Labs — engineered risk-first for prop firm and serious retail traders.`,
      url: categoryPath('trading', category),
      items: products.map((p) => ({ name: p.data.name, path: projectPath('trading', p.data.category, p.id) })),
    }),
  ]}
>
  <Nav />
  <main id="main">
    <PageHeader
      back={{ href: '/trading/', label: 'All trading' }}
      eyebrow="Trading"
      color={catAccent.color}
      title={meta.label}
      lead={meta.description}
    />

    <Section>
      {products.length > 0 ? (
        <div class="grid-3">
          {products.map((p) => (
            <a
              href={projectPath('trading', p.data.category, p.id)}
              class="card card--pad"
              style={`gap:var(--space-150);padding:var(--space-300);border-top:4px solid ${accentFor(productIds, p.id).color}`}
            >
              <div class="icon-tile" style={`background:color-mix(in srgb, ${accentFor(productIds, p.id).color} 10%, transparent);color:${accentFor(productIds, p.id).color}`}>
                <Icon name={p.data.icon ?? tileIcon} size={24} aria-hidden="true" />
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                <span class="kicker">{p.data.platform}</span>
                <span class="badge">
                  {statusLabel[p.data.status] ?? p.data.status}
                </span>
              </div>
              <h2 style="font-size:var(--text-h3);font-weight:var(--fw-heading)">{p.data.name}</h2>
              <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--text-subtle)">
                {p.data.summary}
              </p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px">
                <span class="chip chip--sm chip--muted">{p.data.market}</span>
                {p.data.price && <span class="chip chip--sm chip--muted">{p.data.price}</span>}
              </div>
              <span class="link-more" style="margin-top:auto">View details →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="card card--pad" style="max-width:640px;margin-inline:auto;text-align:center;align-items:center;gap:var(--space-150)">
          <h2 style="font-size:var(--text-h3)">In development.</h2>
          <p style="margin:0;font-size:var(--text-ui);color:var(--text-subtle)">
            {meta.label} are on the way. Join the waitlist and you'll be first to know when they ship.
          </p>
          <a href="/trading/#waitlist" class="btn btn--primary" style="margin-top:8px">Join the waitlist</a>
        </div>
      )}
    </Section>

    <CtaBanner subtle secondary={{ href: '/trading/', label: 'Browse the trading tools' }} />
  </main>
  <Footer />
</BaseLayout>
