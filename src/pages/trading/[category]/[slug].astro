---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import EmailForm from '../../../components/EmailForm.astro';
import PricingCard from '../../../components/ui/PricingCard.astro';
import Section from '../../../components/ui/Section.astro';
import Faq from '../../../components/ui/Faq.astro';
import { categoryMeta, categoryPath, projectPath } from '../../../config/tracks';
import { breadcrumbLd, faqLd, softwareApplicationLd } from '../../../config/seo';
import { accentFor, ACCENTS } from '../../../config/accents';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const products = await getCollection(
    'projects',
    ({ data }) => !data.draft && data.track === 'trading'
  );
  return products.map((product) => ({
    params: { category: product.data.category, slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

// Same ordered sibling list the category grid uses, so this page's hue matches
// the card that opened it.
const siblingIds = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'trading' && data.category === product.data.category
))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.id);
const { data } = product;
const { Content } = await render(product);
const cat = categoryMeta('trading', data.category);
const accent = accentFor(siblingIds, product.id);

const statusLabel: Record<string, string> = {
  live: 'Live now',
  waitlist: 'Waitlist open',
  'coming-soon': 'Coming soon',
};

const pageTitle = `${data.seoTitle ?? data.name} | Foxe Labs`;
const metaDescription = data.seoDescription ?? data.summary;

const catLabel = cat?.label ?? 'Trading';
const priceMatch = data.price?.match(/([\d.]+)/);
const structuredData = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Trading', path: '/trading' },
    { name: catLabel, path: categoryPath('trading', data.category) },
    { name: data.name, path: projectPath('trading', data.category, product.id) },
  ]),
  softwareApplicationLd({
    name: data.name,
    description: data.summary,
    url: projectPath('trading', data.category, product.id),
    applicationCategory: 'FinanceApplication',
    operatingSystem: data.platform,
    offerPrice: data.status === 'live' ? priceMatch?.[1] : undefined,
    sameAs: data.signalUrl ? [data.signalUrl] : undefined,
  }),
  ...(data.faq.length > 0 ? [faqLd(data.faq)] : []),
];

const quad = ACCENTS.map((a) => a.color);

const resourceLinks = [
  data.demoUrl && { href: data.demoUrl, label: data.demoLabel ?? 'Download free demo' },
  data.docsUrl && { href: data.docsUrl, label: 'Documentation' },
  data.signalUrl && { href: data.signalUrl, label: 'View live signal' },
  { href: data.supportUrl ?? '/contact/', label: 'Get support' },
].filter(Boolean) as { href: string; label: string }[];
---
<BaseLayout
  title={pageTitle}
  description={metaDescription}
  imageAlt={`${data.name} — ${data.tagline}`}
  jsonLd={structuredData}
>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="band band--sm band--bottom">
      <div class="container-x product-hero">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start">
          <a href={categoryPath('trading', data.category)} class="link-more">
            ← All {cat?.label ?? 'trading tools'}
          </a>

          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip chip--sm">
              <span class="dot" style={`background:${accent.color}`} aria-hidden="true"></span>
              {statusLabel[data.status] ?? data.status}
            </span>
            <span class="chip chip--sm chip--muted">{data.market}</span>
            <span class="chip chip--sm chip--muted">{data.platform}</span>
            {data.version && <span class="chip chip--sm chip--muted">{data.version}</span>}
          </div>

          <h1 style="font-size:var(--text-title);line-height:1.05;letter-spacing:-1.4px">{data.name}</h1>
          <p style="margin:0;font-size:var(--text-lead);line-height:1.5;color:var(--text-subtle)">
            {data.tagline}
          </p>

          {data.features.length > 0 && (
            <ul class="dot-list" style={`--dot-hue:${accent.color};margin-top:var(--space-150);font-size:var(--text-md);line-height:1.5`}>
              {data.features.map((f) => (
                <li>
                  <Icon name="mingcute:check-line" size={16} style="color:var(--dot-hue);flex:none" aria-hidden="true" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <PricingCard
          price={data.price}
          badge={statusLabel[data.status] ?? data.status}
          benefits={data.benefits}
        >
          {data.benefits.length === 0 && (
            <p style="margin:0;font-size:var(--text-ui);color:var(--text-subtle)">
              {data.status === 'live'
                ? 'Available now — lifetime updates included.'
                : 'Join the waitlist for launch access and early pricing.'}
            </p>
          )}

          {data.status === 'live' && data.ctaUrl ? (
            <>
              <a href={data.ctaUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
                {data.ctaLabel ?? 'Get it now'}
              </a>
              <div style="display:flex;flex-direction:column;gap:var(--space-125);padding-top:var(--space-150);border-top:1px solid var(--border)">
                {resourceLinks.map((l) => (
                  <a href={l.href} class="link-more">{l.label} →</a>
                ))}
              </div>
            </>
          ) : (
            <EmailForm id={`product-form-${product.id}`} buttonLabel="Notify me" />
          )}
        </PricingCard>
      </div>
    </section>

    <!-- Highlights -->
    {data.highlights.length > 0 && (
      <Section variant="alt">
        <h2 class="sr-only">Highlights</h2>
        <div class="grid-3" style="gap:var(--space-500)">
          {data.highlights.map((h, i) => (
            <div style="display:flex;flex-direction:column;gap:var(--space-125)">
              <span class="dot dot--lg" style={`background:${quad[i % 4]}`} aria-hidden="true"></span>
              <h3 style="font-size:var(--text-body-lg);font-weight:var(--fw-heading)">{h.title}</h3>
              <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--text-subtle)">{h.body}</p>
            </div>
          ))}
        </div>
      </Section>
    )}

    <!-- What it does -->
    <Section size="sm">
      <div class="what">
        <h2 style="margin-bottom:var(--space-150);font-size:1.5rem;letter-spacing:-0.4px">What it does</h2>
        <p style="margin:0 0 var(--space-300);font-size:var(--text-body-lg);line-height:1.55;color:var(--text-subtle)">
          {data.summary}
        </p>
        <div class="prose-foxe prose-foxe--compact">
          <Content />
        </div>

        {data.specs.length > 0 && (
          <>
            <h2 style="margin:var(--space-500) 0 var(--space-200);font-size:1.5rem;letter-spacing:-0.4px">
              Specifications
            </h2>
            <dl class="spec-grid">
              {data.specs.map((s) => (
                <div class="spec-grid__row">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
      </div>
    </Section>

    {data.faq.length > 0 && (
      <Section variant="alt" rule="top">
        <Faq items={data.faq} />
      </Section>
    )}

    <CtaBanner
      secondary={{ href: '/trading/', label: 'Browse trading tools' }}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Two columns of label/value pairs. Each row keeps its own hairline so the
     pairs stay legible when the grid reflows to one column. */
  .spec-grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-500);
  }
  .spec-grid__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-200);
    padding: 11px 0;
    font-size: var(--text-ui);
    border-bottom: 1px solid var(--border);
  }
  .spec-grid dt { color: var(--text-subtle); }
  .spec-grid dd { margin: 0; text-align: right; font-weight: var(--fw-medium); }
  @media (max-width: 620px) {
    .spec-grid { grid-template-columns: 1fr; }
  }

  .product-hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-700);
  }
  /* One measured column at the compact reading scale — the bodies here are
     short sections, not articles, so they get less air than blog prose. */
  .what {
    max-width: 720px;
    margin-inline: auto;
  }
  @media (max-width: 960px) {
    .product-hero { grid-template-columns: 1fr; gap: var(--space-500); }
  }
</style>
