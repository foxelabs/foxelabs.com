---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import EmailForm from '../../../components/EmailForm.astro';
import PricingCard from '../../../components/ui/PricingCard.astro';
import Section from '../../../components/ui/Section.astro';
import Faq from '../../../components/ui/Faq.astro';
import ResourceLinks from '../../../components/ui/ResourceLinks.astro';
import { categoryMeta, categoryPath, projectPath } from '../../../config/tracks';
import { breadcrumbLd, faqLd, softwareApplicationLd } from '../../../config/seo';
import { accentFor, HUES } from '../../../config/accents';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const products = await getCollection(
    'projects',
    ({ data }) => !data.draft && data.track === 'trading'
  );
  return products.map((product) => ({
    params: { category: product.data.category, slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

// Same ordered sibling list the category grid uses, so this page's hue matches
// the card that opened it.
const siblingIds = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'trading' && data.category === product.data.category
))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.id);
const { data } = product;
const { Content } = await render(product);
const cat = categoryMeta('trading', data.category);
const accent = accentFor(siblingIds, product.id);

const statusLabel: Record<string, string> = {
  live: 'Live now',
  waitlist: 'Waitlist open',
  'coming-soon': 'Coming soon',
};

const pageTitle = `${data.seoTitle ?? data.name} | Foxe Labs`;
const metaDescription = data.seoDescription ?? data.summary;

const catLabel = cat?.label ?? 'Trading';
const priceMatch = data.price?.match(/([\d.]+)/);
const structuredData = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Trading', path: '/trading' },
    { name: catLabel, path: categoryPath('trading', data.category) },
    { name: data.name, path: projectPath('trading', data.category, product.id) },
  ]),
  softwareApplicationLd({
    name: data.name,
    description: data.summary,
    url: projectPath('trading', data.category, product.id),
    applicationCategory: 'FinanceApplication',
    operatingSystem: data.platform,
    offerPrice: data.status === 'live' ? priceMatch?.[1] : undefined,
    sameAs: data.signalUrl ? [data.signalUrl] : undefined,
  }),
  ...(data.faq.length > 0 ? [faqLd(data.faq)] : []),
];

// Hero fact tiles — each its own hue so the essentials read at a glance.
const heroFacts = [
  { icon: 'mingcute:copper-coin-line', label: 'Market', value: data.market, hue: 'var(--hue-amber)' },
  { icon: 'mingcute:chart-bar-line', label: 'Platform', value: data.platform, hue: 'var(--hue-blue)' },
  data.version && { icon: 'mingcute:git-merge-line', label: 'Version', value: data.version, hue: 'var(--hue-purple)' },
  data.price && { icon: 'mingcute:wallet-4-line', label: 'Price', value: data.price.split('·')[0].trim(), hue: 'var(--hue-emerald)' },
].filter(Boolean) as { icon: string; label: string; value: string; hue: string }[];

// Spec rows get an icon by label; unknown labels fall back to a plain dot.
const specIcon: Record<string, string> = {
  symbol: 'mingcute:copper-coin-line',
  platform: 'mingcute:chart-bar-line',
  timeframe: 'mingcute:time-line',
  'account type': 'mingcute:wallet-4-line',
  recommended: 'mingcute:safety-certificate-line',
  'min. balance': 'mingcute:currency-dollar-line',
  activations: 'mingcute:device-line',
  license: 'mingcute:certificate-line',
};

const resourceLinks = [
  data.demoUrl && { href: data.demoUrl, label: data.demoLabel ?? 'Download free demo', hint: 'MT5 Strategy Tester' },
  data.docsUrl && { href: data.docsUrl, label: 'Documentation', hint: 'docs.foxelabs.com' },
  data.signalUrl && { href: data.signalUrl, label: 'View live signal' },
  { href: data.supportUrl ?? '/contact/', label: 'Get support', hint: 'Straight to the team' },
].filter(Boolean) as { href: string; label: string; hint?: string }[];
---
<BaseLayout
  title={pageTitle}
  description={metaDescription}
  imageAlt={`${data.name} — ${data.tagline}`}
  jsonLd={structuredData}
>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="page-hero">
      <div class="cellgrid" aria-hidden="true"></div>
      <div class="container-x product-hero">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start">
          <a href={categoryPath('trading', data.category)} class="link-more">
            ← All {cat?.label ?? 'trading tools'}
          </a>

          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip chip--sm chip--muted chip--solid">
              <span class="sync-dot" aria-hidden="true"></span>
              {statusLabel[data.status] ?? data.status}
            </span>
            <span class="chip chip--sm chip--muted">{cat?.label ?? 'Trading'}</span>
          </div>

          <h1 style="font-size:var(--text-title);line-height:1.05">{data.name}</h1>
          <p style="margin:0;font-size:var(--text-lead);line-height:1.5;color:var(--text-subtle)">
            {data.tagline}
          </p>

          {heroFacts.length > 0 && (
            <dl class="fact-tiles">
              {heroFacts.map((f) => (
                <div class="fact-tile" style={`--hue:${f.hue}`}>
                  <span class="fact-tile__icon tint" aria-hidden="true"><Icon name={f.icon} size={18} /></span>
                  <div>
                    <dt class="kicker">{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                </div>
              ))}
            </dl>
          )}

          {data.features.length > 0 && (
            <ul class="feature-list">
              {data.features.map((f, i) => (
                <li style={`--hue:${HUES[i % HUES.length]}`}>
                  <span class="feature-list__tick tint" aria-hidden="true">
                    <Icon name="mingcute:check-line" size={14} />
                  </span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <PricingCard
          price={data.price}
          benefits={data.benefits}
          hue={accent.color}
        >
          {data.benefits.length === 0 && (
            <p style="margin:0;font-size:var(--text-ui);color:var(--text-subtle)">
              {data.status === 'live'
                ? 'Available now — lifetime updates included.'
                : 'Join the waitlist for launch access and early pricing.'}
            </p>
          )}

          {data.status === 'live' && data.ctaUrl ? (
            <>
              <a href={data.ctaUrl} class="btn btn--primary" style="justify-content:center" target="_blank" rel="noopener noreferrer">
                {data.ctaLabel ?? 'Get it now'}
              </a>
              <ResourceLinks links={resourceLinks} />
            </>
          ) : (
            <EmailForm id={`product-form-${product.id}`} buttonLabel="Notify me" />
          )}
        </PricingCard>
      </div>
    </section>

    <!-- Highlights -->
    {data.highlights.length > 0 && (
      <Section variant="alt">
        <span class="eyebrow">Highlights</span>
        <h2 style="margin:14px 0 var(--space-500);font-size:var(--text-h2-lg)">Why traders run it</h2>
        <div class="grid-3">
          {data.highlights.map((h, i) => (
            <div class="card card--pad" style={`gap:var(--space-150);--hue:${HUES[i % HUES.length]}`}>
              <div style="display:flex;align-items:center;justify-content:space-between">
                <span class="icon-tile tint"><Icon name={h.icon} size={22} aria-hidden="true" /></span>
                <span class="mono" style="font-size:var(--text-xs);color:var(--hue)">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 style="font-size:1.25rem">{h.title}</h3>
              <p style="margin:0;font-size:var(--text-md);line-height:1.55">{h.body}</p>
            </div>
          ))}
        </div>
      </Section>
    )}

    <!-- What it does -->
    <Section rule="top">
      <div class="what">
        <span class="eyebrow">Overview</span>
        <h2 style="margin:14px 0 var(--space-150);font-size:var(--text-h2-lg)">What it does</h2>
        <p style="margin:0 0 var(--space-300);font-size:var(--text-body-lg);line-height:1.55;color:var(--text-subtle)">
          {data.summary}
        </p>
        <div class="prose-foxe prose-foxe--compact">
          <Content />
        </div>

        {data.specs.length > 0 && (
          <>
            <h2 style="margin:var(--space-500) 0 var(--space-200);font-size:var(--text-h3)">
              Specifications
            </h2>
            <dl class="spec-grid">
              {data.specs.map((s, i) => (
                <div class="spec-grid__row">
                  <dt>
                    <Icon name={specIcon[s.label.toLowerCase()] ?? 'mingcute:information-line'} size={16} style={`color:${HUES[i % HUES.length]}`} aria-hidden="true" />
                    {s.label}
                  </dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
      </div>
    </Section>

    {data.faq.length > 0 && (
      <Section variant="alt" rule="top">
        <Faq items={data.faq} />
      </Section>
    )}

    <CtaBanner
      secondary={{ href: '/trading/', label: 'Browse trading tools' }}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Two columns of label/value pairs. Each row keeps its own hairline so the
     pairs stay legible when the grid reflows to one column. */
  .spec-grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-500);
  }
  .spec-grid__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-200);
    padding: 11px 0;
    font-size: var(--text-ui);
    border-bottom: 1px solid var(--border);
  }
  .spec-grid dt { color: var(--text-subtle); display: flex; align-items: center; gap: 8px; }
  .spec-grid dd { margin: 0; text-align: right; font-weight: var(--fw-medium); }
  @media (max-width: 620px) {
    .spec-grid { grid-template-columns: 1fr; }
  }

  .fact-tiles {
    margin: var(--space-100) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-125);
    width: 100%;
  }
  .fact-tile {
    display: flex;
    align-items: center;
    gap: var(--space-125);
    padding: var(--space-125) var(--space-150);
    border: 1px solid color-mix(in srgb, var(--hue) 28%, var(--border));
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--hue) 5%, var(--bg-card));
  }
  .fact-tile__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    flex: none;
  }
  .fact-tile dd { margin: 2px 0 0; font-size: var(--text-md); font-weight: var(--fw-heading); color: var(--text); }
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-125);
    margin-top: var(--space-100);
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .feature-list li { display: flex; align-items: flex-start; gap: var(--space-125); }
  .feature-list__tick {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 999px;
    flex: none;
  }

  .product-hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-700);
  }
  /* One measured column at the compact reading scale — the bodies here are
     short sections, not articles, so they get less air than blog prose. */
  .what {
    max-width: 720px;
    margin-inline: auto;
  }
  @media (max-width: 960px) {
    .fact-tiles {
    margin: var(--space-100) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-125);
    width: 100%;
  }
  .fact-tile {
    display: flex;
    align-items: center;
    gap: var(--space-125);
    padding: var(--space-125) var(--space-150);
    border: 1px solid color-mix(in srgb, var(--hue) 28%, var(--border));
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--hue) 5%, var(--bg-card));
  }
  .fact-tile__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    flex: none;
  }
  .fact-tile dd { margin: 2px 0 0; font-size: var(--text-md); font-weight: var(--fw-heading); color: var(--text); }
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-125);
    margin-top: var(--space-100);
    font-size: var(--text-md);
    line-height: 1.5;
  }
  .feature-list li { display: flex; align-items: flex-start; gap: var(--space-125); }
  .feature-list__tick {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 999px;
    flex: none;
  }

  .product-hero { grid-template-columns: 1fr; gap: var(--space-500); }
  }
</style>
