---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import TrustBar from '../../components/TrustBar.astro';
import Products from '../../components/Products.astro';
import WhyFoxeLabs from '../../components/WhyFoxeLabs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Faq from '../../components/ui/Faq.astro';
import { breadcrumbLd, faqLd } from '../../config/seo';

const faq = [
  {
    q: 'What trading software does Foxe Labs sell?',
    a:
      'Gold Scalpel, an automated XAUUSD breakout scalper for MetaTrader 5, is published and available to buy on the MQL5 Market for a one-time price, with lifetime updates and a free Strategy Tester demo. TickerLog, our universal trading journal, is close to release and launches at tickerlog.io. Further expert advisors and tools are in development.',
  },
  {
    q: 'Do the expert advisors work with prop firm accounts?',
    a:
      'They are built risk-first, which is what prop firm rules demand: percentage-based position sizing, a maximum-lot ceiling, early breakeven stops, position caps, and cooldowns after trades and losing streaks. Always confirm the specific rules of your firm — drawdown limits and news restrictions vary.',
  },
  {
    q: 'Can I test an EA before buying?',
    a:
      'Yes. Gold Scalpel has a free demo for the MT5 Strategy Tester, so you can backtest it on your own broker\'s data and spreads before you buy.',
  },
  {
    q: 'What is TickerLog?',
    a:
      'TickerLog is a universal trading journal. It pulls closed trades straight from your account, reassembles partial fills into one readable position, and tags each trade by setup, session, and mistake so patterns surface from the data rather than from memory. It is launching soon at tickerlog.io — join the list for launch pricing.',
  },
  {
    q: 'Is any of this financial advice?',
    a:
      'No. These are software tools, not investment recommendations. Trading gold and other leveraged products carries substantial risk of loss, past and live performance never guarantees future results, and every trading decision remains yours.',
  },
];

---
<BaseLayout
  title="MetaTrader 5 Expert Advisors & Trading Tools | Foxe Labs"
  description="Expert advisors, a universal trading journal, and precision tools — engineered for prop firm and serious retail traders."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Trading', path: '/trading' },
    ]),
    faqLd(faq),
  ]}
>
  <Nav />
  <main id="main">
    <Hero />
    <TrustBar />
    <Products />
    <WhyFoxeLabs />
    <Section variant="alt">
      <div class="max-w-3xl mx-auto">
        <Faq items={faq} bare />
      </div>
    </Section>
    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>
