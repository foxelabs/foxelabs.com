---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import EmailForm from '../../components/EmailForm.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Faq from '../../components/ui/Faq.astro';
import { categoryPath, projectPath } from '../../config/tracks';
import { accentFor, categoryAccent } from '../../config/accents';
import { breadcrumbLd, faqLd } from '../../config/seo';

const products = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'trading'
)).sort((a, b) => a.data.order - b.data.order);
const productIds = products.map((p) => p.id);

const count = (cat: string) => products.filter((p) => p.data.category === cat).length;

const categoryBoxes = [
  {
    title: 'Expert Advisors',
    description:
      'Automated strategies for MetaTrader 5 — risk controls first, pre-tuned settings, and a free Strategy Tester demo before you buy.',
    badge: `${count('expert-advisors')} EAs`,
    href: categoryPath('trading', 'expert-advisors'),
    accent: categoryAccent('expert-advisors'),
  },
  {
    title: 'Trading Tools',
    description:
      'A universal journal and precision utilities — the small pieces that make a trading process repeatable.',
    badge: `${count('tools')} tools`,
    href: categoryPath('trading', 'tools'),
    accent: categoryAccent('tools'),
  },
];

const statusLabel: Record<string, string> = {
  live: 'Live now',
  waitlist: 'Waitlist open',
  'coming-soon': 'Coming soon',
};

const principles = [
  {
    title: 'Risk before returns',
    color: 'var(--acc-1)',
    body: 'Percentage-based sizing, a lot ceiling, early breakeven, position caps and cooldowns — designed in before any entry logic.',
  },
  {
    title: 'Pre-tuned, not fiddly',
    color: 'var(--acc-2)',
    body: 'A short list of settings that matter, shipped at values we actually trade. No 60-input panel to guess your way through.',
  },
  {
    title: 'Test it first',
    color: 'var(--acc-3)',
    body: 'A free Strategy Tester demo means you backtest on your own broker feed and spreads before spending anything.',
  },
  {
    title: 'Traded in-house',
    color: 'var(--acc-4)',
    body: 'Every tool runs on our own accounts. If it is not good enough for our capital, it does not ship.',
  },
];

const faq = [
  {
    q: 'What trading software does Foxe Labs sell?',
    a:
      'Gold Scalpel, an automated XAUUSD breakout scalper for MetaTrader 5, is published and available to buy on the MQL5 Market for a one-time price, with lifetime updates and a free Strategy Tester demo. TickerLog, our universal trading journal, is close to release and launches at tickerlog.io. Further expert advisors and tools are in development.',
  },
  {
    q: 'Do the expert advisors work with prop firm accounts?',
    a:
      'They are built risk-first, which is what prop firm rules demand: percentage-based position sizing, a maximum-lot ceiling, early breakeven stops, position caps, and cooldowns after trades and losing streaks. Always confirm the specific rules of your firm — drawdown limits and news restrictions vary.',
  },
  {
    q: 'Can I test an EA before buying?',
    a:
      "Yes. Gold Scalpel has a free demo for the MT5 Strategy Tester, so you can backtest it on your own broker's data and spreads before you buy.",
  },
  {
    q: 'What is TickerLog?',
    a:
      'TickerLog is a universal trading journal. It pulls closed trades straight from your account, reassembles partial fills into one readable position, and tags each trade by setup, session, and mistake so patterns surface from the data rather than from memory. It is launching soon at tickerlog.io — join the list for launch pricing.',
  },
  {
    q: 'Is any of this financial advice?',
    a:
      'No. These are software tools, not investment recommendations. Trading gold and other leveraged products carries substantial risk of loss, past and live performance never guarantees future results, and every trading decision remains yours.',
  },
];
---
<BaseLayout
  title="MetaTrader 5 Expert Advisors & Trading Tools | Foxe Labs"
  description="Expert advisors, a universal trading journal, and precision tools — engineered for prop firm and serious retail traders."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Trading', path: '/trading' },
    ]),
    faqLd(faq),
  ]}
>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="band band--sm band--bottom">
      <div class="container-x">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start;max-width:760px">
          <Eyebrow chip color="var(--acc-3)">Trading</Eyebrow>
          <h1 style="font-size:var(--text-title);letter-spacing:-1.2px">
            Engineered for the account, not the backtest.
          </h1>
          <p style="margin:0;max-width:560px;font-size:1.125rem;line-height:1.5;color:var(--text-subtle)">
            Expert advisors, a universal trading journal, and precision utilities for MetaTrader 5 —
            built risk-first, pre-tuned, and traded on our own capital first.
          </p>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <a href={categoryPath('trading', 'expert-advisors')} class="btn btn--primary">Expert Advisors</a>
            <a href="#waitlist" class="btn btn--ghost">Join the waitlist</a>
          </div>
          <p style="margin:4px 0 0;font-size:var(--text-small);color:var(--text-subtle)">
            Trading carries substantial risk. Nothing here is financial advice.
          </p>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <Section>
      <h2 style="margin-bottom:12px;font-size:var(--text-h2-lg);letter-spacing:-0.8px">
        Two kinds of tool.
      </h2>
      <p style="margin:0 0 var(--space-500);font-size:var(--text-body);line-height:1.55;color:var(--text-subtle);max-width:620px">
        One trades for you inside MetaTrader. The other makes sense of what happened afterwards.
      </p>
      <div class="cat-grid">
        {categoryBoxes.map((box) => (
          <a
            href={box.href}
            class="card card--pad"
            style={`gap:14px;padding:30px;border-top:4px solid ${box.accent.color}`}
          >
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
              <h3 style="font-size:var(--text-h3)">{box.title}</h3>
              <span style="font-size:var(--text-xs);font-weight:var(--fw-heading);background:var(--bg-hover);border-radius:var(--r-pill);padding:4px 10px;white-space:nowrap">
                {box.badge}
              </span>
            </div>
            <p style="margin:0;font-size:0.9375rem;line-height:1.55;color:var(--text-subtle)">
              {box.description}
            </p>
            <span class="link-more" style="margin-top:auto">Explore →</span>
          </a>
        ))}
      </div>
    </Section>

    <!-- Every product -->
    {products.length > 0 && (
      <Section variant="alt" rule="top">
        <h2 style="margin-bottom:var(--space-500);font-size:var(--text-h2);letter-spacing:-0.6px">
          What we ship
        </h2>
        <div class="product-grid">
          {products.map((p) => (
            <a
              href={projectPath('trading', p.data.category, p.id)}
              class="card card--pad"
              style={`gap:12px;padding:24px;border-top:4px solid ${accentFor(productIds, p.id).color}`}
            >
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                <span class="kicker">{p.data.platform}</span>
                <span style="font-size:var(--text-xs);font-weight:var(--fw-heading);background:var(--bg-hover);border-radius:var(--r-pill);padding:4px 10px;white-space:nowrap">
                  {statusLabel[p.data.status] ?? p.data.status}
                </span>
              </div>
              <h3 style="font-size:var(--text-h3);font-weight:var(--fw-heading)">{p.data.name}</h3>
              <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--text-subtle)">
                {p.data.summary}
              </p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px">
                <span class="chip chip--sm chip--muted">{p.data.market}</span>
                {p.data.price && <span class="chip chip--sm chip--muted">{p.data.price}</span>}
              </div>
              <span class="link-more" style="margin-top:auto">View details →</span>
            </a>
          ))}
        </div>
      </Section>
    )}

    <!-- Principles -->
    <Section variant="ink" size="sm">
      <h2 style="margin-bottom:var(--space-500);font-size:var(--text-h2);letter-spacing:-0.6px">
        How these are built
      </h2>
      <div class="four-col">
        {principles.map((p) => (
          <div style="display:flex;flex-direction:column;gap:10px">
            <span class="dot dot--lg" style={`background:${p.color}`} aria-hidden="true"></span>
            <h3 style="font-size:1.0625rem;font-weight:var(--fw-heading)">{p.title}</h3>
            <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--ink-band-subtle)">
              {p.body}
            </p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Waitlist -->
    <Section id="waitlist">
      <div class="card" style="max-width:var(--measure);margin-inline:auto">
        <span class="accent-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <div style="padding:var(--space-500);display:flex;flex-direction:column;gap:var(--space-250)">
          <h2 style="font-size:var(--text-h2);letter-spacing:-0.6px">Get the next release first.</h2>
          <p style="margin:0;font-size:var(--text-body);line-height:1.55;color:var(--text-subtle)">
            One email when a tool ships or a waitlist opens. Nothing else.
          </p>
          <EmailForm />
        </div>
      </div>
    </Section>

    <Section variant="alt" rule="top">
      <Faq items={faq} />
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-300);
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-300);
  }
  .four-col {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-400);
  }
  @media (max-width: 960px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
    .four-col { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .cat-grid, .product-grid { grid-template-columns: 1fr; }
  }
</style>
