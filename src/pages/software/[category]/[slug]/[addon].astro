---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import CtaBanner from '../../../../components/CtaBanner.astro';
import Section from '../../../../components/ui/Section.astro';
import PricingCard from '../../../../components/ui/PricingCard.astro';
import Faq from '../../../../components/ui/Faq.astro';
import Screenshots from '../../../../components/ui/Screenshots.astro';
import { projectPath, categoryPath, categoryMeta, addonPath } from '../../../../config/tracks';
import { breadcrumbLd, softwareApplicationLd, faqLd } from '../../../../config/seo';
import { accentFor, ACCENTS } from '../../../../config/accents';

export async function getStaticPaths() {
  const [addons, projects] = await Promise.all([
    getCollection('addons', (a) => !a.data.draft),
    getCollection('projects', (p) => !p.data.draft && p.data.track === 'oss'),
  ]);

  return addons.flatMap((addon) => {
    const parent = projects.find((p) => p.id === addon.data.parent);
    if (!parent) return [];
    return [
      {
        params: {
          category: parent.data.category,
          slug: parent.id,
          addon: addon.id,
        },
        props: { addon, parent },
      },
    ];
  });
}

const { addon, parent } = Astro.props;

// Same ordered list the plugin page's add-on grid uses, so this page keeps the
// colour of the card that opened it.
const siblingIds = (await getCollection('addons', (a) => !a.data.draft && a.data.parent === parent.id))
  .sort((a, b) => a.data.order - b.data.order)
  .map((a) => a.id);
const { data } = addon;
const accent = accentFor(siblingIds, addon.id);

const parentUrl = projectPath('oss', parent.data.category, parent.id);

const DOCS_FALLBACK = 'https://docs.foxelabs.com';
const docsUrl = data.docsUrl ?? DOCS_FALLBACK;

// Commercial "what you get" — verified from the Loggedin add-on docs.
const benefits = [
  `Works with the free ${parent.data.name} core plugin`,
  'Automatic updates & support while licensed',
  '1, 5 or 10-site licenses',
  '7-day money-back guarantee',
];

const pageTitle = `${data.seoTitle ?? `${data.name} — ${parent.data.name} Add-on`} | Foxe Labs`;
const metaDescription = data.seoDescription ?? data.summary;

const catLabel = categoryMeta('oss', parent.data.category)?.label ?? 'Software';
const shotUrls = data.screenshots.map((s) => s.src.src);
const priceMatch = data.price?.match(/([\d.]+)/);
// "From $X" is tiered pricing — a flat Offer price would misstate it.
const isFromPrice = /^from/i.test(data.price ?? '');
const structuredData = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Software', path: '/software' },
    { name: catLabel, path: categoryPath('oss', parent.data.category) },
    { name: parent.data.name, path: parentUrl },
    { name: data.name, path: addonPath('oss', parent.data.category, parent.id, addon.id) },
  ]),
  softwareApplicationLd({
    name: `${data.name} — ${parent.data.name} add-on`,
    description: data.summary,
    url: addonPath('oss', parent.data.category, parent.id, addon.id),
    applicationCategory: 'WordPress Plugin',
    operatingSystem: 'WordPress',
    offerPrice: isFromPrice ? undefined : priceMatch?.[1],
    offerLowPrice: isFromPrice ? priceMatch?.[1] : undefined,
    sameAs: data.url ? [data.url] : undefined,
    screenshot: shotUrls,
  }),
];
if (data.faq.length > 0) structuredData.push(faqLd(data.faq));

const quad = ACCENTS.map((a) => a.color);
---
<BaseLayout
  title={pageTitle}
  description={metaDescription}
  imageAlt={`${data.name} — ${data.tagline}`}
  jsonLd={structuredData}
>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="band band--sm band--bottom">
      <div class="container-x addon-hero">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start">
          <a href={parentUrl} style="font-size:var(--text-small);font-weight:var(--fw-medium);color:var(--text-subtle)">
            ← All {parent.data.name} add-ons
          </a>

          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip chip--sm">
              <span class="dot" style={`background:${accent.color}`} aria-hidden="true"></span>
              {parent.data.name} add-on
            </span>
            {data.location && (
              <span class="chip chip--sm">
                <span class="dot" style="background:var(--acc-3)" aria-hidden="true"></span>
                {data.location}
              </span>
            )}
          </div>

          <h1 style="font-size:var(--text-title);line-height:1.05;letter-spacing:-1.4px">{data.name}</h1>
          <p style="margin:0;font-size:var(--text-lead);line-height:1.5;color:var(--text-subtle)">
            {data.tagline}
          </p>

          {data.features.length > 0 && (
            <ul style="margin:12px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px">
              {data.features.map((f, i) => (
                <li style="display:flex;align-items:flex-start;gap:10px;font-size:0.9375rem;line-height:1.5">
                  <span
                    class="dot"
                    style={`background:${quad[i % 4]};width:10px;height:10px;margin-top:5px`}
                    aria-hidden="true"
                  ></span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <PricingCard
          price={data.price}
          badge={data.tier === 'premium' ? 'Premium add-on' : data.tier === 'free' ? 'Free add-on' : undefined}
          benefits={benefits}
        >
          {data.url && (
            <a href={data.url} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
              Get {data.name}
            </a>
          )}
          <div style="display:flex;flex-direction:column;gap:10px;padding-top:var(--space-150);border-top:1px solid var(--border)">
            <a href={docsUrl} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
              Documentation →
            </a>
            <a href="/contact/" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">Get support →</a>
          </div>
          <p style="margin:0;font-size:var(--text-small);color:var(--text-subtle)">
            Requires the free <a href={parentUrl}>{parent.data.name}</a> plugin to be installed and active.
          </p>
        </PricingCard>
      </div>
    </section>

    {data.screenshots.length > 0 && (
      <Section variant="ink">
        <Screenshots
          id={`shots-${addon.id}`}
          shots={data.screenshots}
          heading={`${data.name} in the WordPress admin`}
          lead={`Every screen ${data.name} adds, and where to find it.`}
        />
      </Section>
    )}

    {data.faq.length > 0 && (
      <Section variant="alt" rule="top">
        <Faq items={data.faq} />
      </Section>
    )}

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .addon-hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-700);
  }
  @media (max-width: 960px) {
    .addon-hero { grid-template-columns: 1fr; gap: var(--space-500); }
  }
</style>
