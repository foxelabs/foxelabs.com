---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import Section from '../../../components/ui/Section.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { categoryList, categoryPath, projectPath } from '../../../config/tracks';
import { breadcrumbLd, collectionPageLd } from '../../../config/seo';
import { accentFor, categoryAccent } from '../../../config/accents';

export async function getStaticPaths() {
  return categoryList('oss').map(([category, meta]) => ({
    params: { category },
    props: { category, meta },
  }));
}

const { category, meta } = Astro.props;

const catAccent = categoryAccent(category);

const projects = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'oss' && data.category === category
)).sort((a, b) => a.data.order - b.data.order);

// Colour is positional, so the grid and each product page agree on the hue.
const projectIds = projects.map((p) => p.id);
---
<BaseLayout
  title={`Open-Source ${meta.label} | Foxe Labs`}
  description={`Open-source ${meta.label.toLowerCase()} by Foxe Labs — documented, GPL-licensed, and maintained in public.`}
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Software', path: '/software' },
      { name: meta.label, path: categoryPath('oss', category) },
    ]),
    collectionPageLd({
      name: `Open-Source ${meta.label}`,
      description: `Open-source ${meta.label.toLowerCase()} by Foxe Labs — documented, GPL-licensed, and maintained in public.`,
      url: categoryPath('oss', category),
      items: projects.map((p) => ({ name: p.data.name, path: projectPath('oss', p.data.category, p.id) })),
    }),
  ]}
>
  <Nav />
  <main id="main">
    <PageHeader
      back={{ href: '/software/', label: 'All software' }}
      eyebrow="Software"
      color={catAccent.color}
      title={meta.label}
      lead={meta.description}
    />

    <Section>
      {projects.length > 0 ? (
        <div class="product-grid">
          {projects.map((p) => (
            <a href={projectPath('oss', p.data.category, p.id)} class="card card--pad" style={`gap:12px;padding:24px;border-top:4px solid ${accentFor(projectIds, p.id).color}`}>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                <span class="kicker">{p.data.kind}</span>
                {p.data.acquired && (
                  <span style="font-size:var(--text-xs);font-weight:var(--fw-heading);background:var(--bg-hover);border-radius:var(--r-pill);padding:4px 10px">
                    Acquired
                  </span>
                )}
              </div>
              <h2 style="font-size:var(--text-h3);font-weight:var(--fw-heading)">{p.data.name}</h2>
              <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--text-subtle)">
                {p.data.summary}
              </p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px">
                <span class="chip chip--sm">
                  <span class="dot" style="background:var(--acc-4)" aria-hidden="true"></span>
                  Open source · {p.data.license}
                </span>
                {p.data.installs && <span class="chip chip--sm chip--muted">{p.data.installs}</span>}
                {p.data.rating && <span class="chip chip--sm chip--muted">{p.data.rating}</span>}
              </div>
              <span class="link-more" style="margin-top:auto">View details →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="card card--pad" style="max-width:640px;margin-inline:auto;text-align:center;align-items:center;gap:12px">
          <h2 style="font-size:var(--text-h3)">More on the way.</h2>
          <p style="margin:0;font-size:var(--text-ui);color:var(--text-subtle)">
            We're adding {meta.label.toLowerCase()} here. In the meantime, explore the rest of our
            open-source work.
          </p>
          <a href="/software/" class="btn btn--primary" style="margin-top:8px">All software</a>
        </div>
      )}
    </Section>

    <CtaBanner subtle />
  </main>
  <Footer />
</BaseLayout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-300);
  }
  @media (max-width: 960px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .product-grid { grid-template-columns: 1fr; }
  }
</style>
