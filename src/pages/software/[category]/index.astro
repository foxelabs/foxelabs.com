---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import { categoryList, categoryMeta, categoryPath, projectPath } from '../../../config/tracks';
import { breadcrumbLd, collectionPageLd } from '../../../config/seo';
import { accentFor, accentVars, categoryAccent } from '../../../config/accents';

export async function getStaticPaths() {
  return categoryList('oss').map(([category, meta]) => ({
    params: { category },
    props: { category, meta },
  }));
}

const { category, meta } = Astro.props;

const catAccent = categoryAccent(category);

const projects = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'oss' && data.category === category
)).sort((a, b) => a.data.order - b.data.order);

// Colour is positional, so the grid and each product page agree on the hue.
const projectsIds = projects.map((p) => p.id);
---
<BaseLayout
  title={`Open-Source ${meta.label} | Foxe Labs`}
  description={`Open-source ${meta.label.toLowerCase()} by Foxe Labs — documented, GPL-licensed, and maintained in public.`}
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Software', path: '/software' },
      { name: meta.label, path: categoryPath('oss', category) },
    ]),
    collectionPageLd({
      name: `Open-Source ${meta.label}`,
      description: `Open-source ${meta.label.toLowerCase()} by Foxe Labs — documented, GPL-licensed, and maintained in public.`,
      url: categoryPath('oss', category),
      items: projects.map((p) => ({ name: p.data.name, path: projectPath('oss', p.data.category, p.id) })),
    }),
  ]}
>
  <Nav />
  <main id="main" class="track-oss">
    <section class="band band--alt" data-reveal>
      <div class="container-x">
        <a href="/software/" class="inline-flex items-center gap-1.5 text-[11px] mb-6 transition-colors hover:text-[var(--ink)]" style="color: var(--ink-dim);">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
          </svg>
          All software
        </a>
        <Eyebrow class="mb-4" color={catAccent.ink}>Software</Eyebrow>
        <h1 style="font-size: var(--text-hero); font-weight: var(--fw-display);" class="mb-4">{meta.label}</h1>
        <p class="max-w-[560px] leading-relaxed" style="font-size: var(--text-lead-sm); color: var(--ink-body);">
          {meta.description}
        </p>
      </div>
    </section>

    <Section variant="light">
      {projects.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((p) => (
            <a
              href={projectPath('oss', p.data.category, p.id)}
              class="product-card card card--hover p-7 flex flex-col"
              style={accentVars(accentFor(projectsIds, p.id))}
            >
              <div class="flex items-center justify-between gap-2 mb-5">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="lozenge" style="background: var(--accent-soft); color: var(--accent-deep);">{p.data.language}</span>
                  {p.data.acquired && (
                    <span class="lozenge" style="background: var(--accent-ink); color: #fff;">Acquired</span>
                  )}
                </div>
                <span class="whitespace-nowrap" style="font-size: var(--text-small); color: var(--ink-dim);">{p.data.kind}</span>
              </div>
              <h2 style="font-size: var(--text-h3); font-weight: var(--fw-heading);" class="mb-2">{p.data.name}</h2>
              <p class="mb-6 flex-1" style="font-size: var(--text-ui); color: var(--ink-body);">{p.data.summary}</p>
              <div class="flex flex-col gap-1 mb-5" style="font-size: var(--text-small); color: var(--ink-dim);">
                <span style="color: var(--accent-ink); font-weight: var(--fw-medium);">● Open source · GPL</span>
                {p.data.installs && <span>{p.data.installs}</span>}
                {p.data.rating && <span>{p.data.rating}</span>}
              </div>
              <span class="btn btn--ghost self-start">View details
                <span class="btn__arrow" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg>
                </span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="card p-10 md:p-14 text-center max-w-2xl mx-auto">
          <h2 style="font-size: var(--text-h3); font-weight: var(--fw-heading);" class="mb-3">More on the way.</h2>
          <p class="mb-8 max-w-md mx-auto" style="font-size: var(--text-ui); color: var(--ink-body);">
            We're adding {meta.label.toLowerCase()} here. In the meantime, explore the rest of our open-source work.
          </p>
          <Button href="/software/" variant="primary" arrow>All software</Button>
        </div>
      )}
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Each card carries its own --accent-*; the top rule makes the hue readable
     at a glance without tinting the whole card. */
  .product-card {
    border-top: 3px solid var(--accent-ink);
  }
  .product-card h2 {
    transition: color 0.1s ease;
  }
  .product-card:hover h2 {
    color: var(--accent-ink);
  }
</style>
