---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import { categoryList, categoryMeta, categoryPath, projectPath } from '../../../config/tracks';
import { breadcrumbLd } from '../../../config/seo';

export async function getStaticPaths() {
  return categoryList('oss').map(([category, meta]) => ({
    params: { category },
    props: { category, meta },
  }));
}

const { category, meta } = Astro.props;

const projects = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'oss' && data.category === category
)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title={`Open-Source ${meta.label} | Foxe Labs`}
  description={`Open-source ${meta.label.toLowerCase()} by Foxe Labs — documented, GPL-licensed, and maintained in public.`}
  jsonLd={breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Software', path: '/software' },
    { name: meta.label, path: categoryPath('oss', category) },
  ])}
>
  <Nav />
  <main class="track-oss">
    <section class="band band--alt" data-reveal>
      <div class="container-x">
        <a href="/software" class="inline-flex items-center gap-1.5 font-mono text-[11px] mb-6 transition-colors hover:text-[var(--ink)]" style="color: var(--ink-dim);">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
          </svg>
          All software
        </a>
        <Eyebrow class="mb-4">Software</Eyebrow>
        <h1 style="font-size: var(--text-hero); font-weight: 800;">{meta.label}</h1>
      </div>
    </section>

    <Section variant="light">
      {projects.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((p) => (
            <a href={projectPath('oss', p.data.category, p.id)} class="card card--hover p-7 flex flex-col">
              <div class="flex items-center justify-between gap-2 mb-5">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-mono text-[10px] px-2.5 py-1.5 rounded-full" style="background: var(--accent-soft); color: var(--accent-deep); letter-spacing: 0.08em;">{p.data.language}</span>
                  {p.data.acquired && (
                    <span class="font-mono text-[10px] px-2.5 py-1.5 rounded-full" style="background: var(--accent-ink); color: #fff; letter-spacing: 0.08em;">Acquired</span>
                  )}
                </div>
                <span class="font-mono text-[11px] whitespace-nowrap" style="color: var(--ink-dim);">{p.data.kind}</span>
              </div>
              <h2 style="font-size: var(--text-h3); font-weight: 800;" class="mb-2">{p.data.name}</h2>
              <p class="text-[15px] mb-6 flex-1" style="color: var(--ink-body);">{p.data.summary}</p>
              <div class="font-mono text-[12px] flex flex-col gap-1 mb-5" style="color: var(--ink-dim);">
                <span style="color: var(--accent-ink);">● Open source · GPL</span>
                {p.data.installs && <span>{p.data.installs}</span>}
                {p.data.rating && <span>{p.data.rating}</span>}
              </div>
              <span class="btn btn--ghost self-start !py-2 !px-4 !text-[13px]">View details
                <span class="btn__arrow" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg>
                </span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="card p-10 md:p-14 text-center max-w-2xl mx-auto">
          <h2 style="font-size: var(--text-h3); font-weight: 800;" class="mb-3">More on the way.</h2>
          <p class="text-[15px] mb-8 max-w-md mx-auto" style="color: var(--ink-body);">
            We're adding {meta.label.toLowerCase()} here. In the meantime, explore the rest of our open-source work.
          </p>
          <Button href="/software" variant="primary" arrow>All software</Button>
        </div>
      )}
    </Section>
  </main>
  <Footer />
</BaseLayout>
