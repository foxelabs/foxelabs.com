---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import Section from '../../../components/ui/Section.astro';
import Faq from '../../../components/ui/Faq.astro';
import Screenshots from '../../../components/ui/Screenshots.astro';
import { categoryMeta, categoryPath, projectPath, addonPath } from '../../../config/tracks';
import { breadcrumbLd, faqLd, softwareApplicationLd } from '../../../config/seo';
import { accentFor, ACCENTS } from '../../../config/accents';

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    ({ data }) => !data.draft && data.track === 'oss'
  );
  return projects.map((project) => ({
    params: { category: project.data.category, slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

// Same ordered sibling list the category grid uses, so this page's hue matches
// the card that opened it.
const siblingIds = (await getCollection(
  'projects',
  ({ data }) => !data.draft && data.track === 'oss' && data.category === project.data.category
))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.id);
const { data } = project;
const { Content } = await render(project);
const cat = categoryMeta('oss', data.category);
const accent = accentFor(siblingIds, project.id);

// Add-ons that extend this project, ordered.
const addons = (await getCollection('addons', (a) => !a.data.draft && a.data.parent === project.id))
  .sort((a, b) => a.data.order - b.data.order);
const addonIds = addons.map((a) => a.id);

// Build an install one-liner from whatever registry info is present.
// Libraries carry install docs in their body/docs, so skip the box for them.
const install =
  data.category === 'libraries'
    ? null
    : data.registry === 'Packagist' && data.packageName
      ? `composer require ${data.packageName}`
      : data.registry === 'npm' && data.packageName
        ? `npm install ${data.packageName}`
        : null;

// Resource links. Fall back to the shared docs hub until per-product links exist.
const DOCS_FALLBACK = 'https://docs.foxelabs.com';
const docsUrl = data.docsUrl ?? DOCS_FALLBACK;
const changelogUrl = data.changelogUrl ?? DOCS_FALLBACK;
// Acquired projects point support at the new owner's channel; ours goes to /contact.
const supportUrl = data.supportUrl ?? '/contact/';

// Label for the canonical registry listing button.
const registryLabel =
  data.registry === 'WordPress.org'
    ? 'View on WordPress.org'
    : data.registry === 'Packagist'
      ? 'View on Packagist'
      : 'View project';

// Products with their own site lead with that; the registry link drops to secondary.
const primaryCta = data.websiteUrl
  ? { href: data.websiteUrl, label: data.websiteLabel ?? 'Visit website' }
  : data.url
    ? { href: data.url, label: registryLabel }
    : null;
const registryLink = data.url && data.websiteUrl ? { href: data.url, label: registryLabel } : null;

// Keyword-first <title>; falls back to the product name.
const pageTitle = `${data.seoTitle ?? data.name} | Foxe Labs`;
const metaDescription = data.seoDescription ?? data.summary;

// Structured data: breadcrumb trail + the product itself.
const catLabel = cat?.label ?? 'Software';
const ratingMatch = data.rating?.match(/([\d.]+)\D+\(([\d,]+)/);
const structuredData = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Software', path: '/software' },
    { name: catLabel, path: categoryPath('oss', data.category) },
    { name: data.name, path: projectPath('oss', data.category, project.id) },
  ]),
  softwareApplicationLd({
    name: data.name,
    description: data.summary,
    url: projectPath('oss', data.category, project.id),
    // Schema.org prefers its enumerated categories over freeform strings like
    // "WordPress Plugin" — data.kind stays visible copy only.
    applicationCategory: 'DeveloperApplication',
    operatingSystem: data.category === 'plugins' ? 'WordPress' : 'PHP',
    offerPrice: '0',
    ratingValue: ratingMatch?.[1],
    ratingCount: ratingMatch?.[2]?.replace(/,/g, ''),
    sameAs: [data.url, data.repo, data.websiteUrl].filter(Boolean) as string[],
    screenshot: data.screenshots.map((s) => s.src.src),
  }),
  ...(data.faq.length > 0 ? [faqLd(data.faq)] : []),
];

const facts = [
  data.license && { label: 'License', value: data.license },
  data.language && { label: 'Language', value: data.language },
  data.minPhp && { label: 'Requires', value: `PHP ${data.minPhp}+` },
  data.since && { label: 'Since', value: data.since },
  data.installs && { label: 'Installs', value: data.installs },
  data.stars && { label: 'Stars', value: data.stars },
  data.rating && { label: 'Rating', value: data.rating },
].filter(Boolean) as { label: string; value: string }[];

const quad = ACCENTS.map((a) => a.color);
---
<BaseLayout
  title={pageTitle}
  description={metaDescription}
  imageAlt={`${data.name} — ${data.tagline}`}
  jsonLd={structuredData}
>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="band band--sm band--bottom">
      <div class="container-x product-hero">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start">
          <a href={categoryPath('oss', data.category)} style="font-size:var(--text-small);font-weight:var(--fw-medium);color:var(--text-subtle)">
            ← All {cat?.label ?? 'software'}
          </a>

          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip chip--sm">
              <span class="dot" style={`background:${accent.color}`} aria-hidden="true"></span>
              {data.kind}
            </span>
            <span class="chip chip--sm">
              <span class="dot" style="background:var(--acc-4)" aria-hidden="true"></span>
              Open source · {data.license}
            </span>
            <span class="chip chip--sm">
              <span class="dot" style="background:var(--acc-2)" aria-hidden="true"></span>
              {data.language}
            </span>
          </div>

          <h1 style="font-size:var(--text-title);line-height:1.05;letter-spacing:-1.4px">{data.name}</h1>
          <p style="margin:0;font-size:var(--text-lead);line-height:1.5;color:var(--text-subtle)">
            {data.tagline}
          </p>

          <div style="display:flex;gap:12px;margin-top:4px;flex-wrap:wrap">
            {primaryCta && (
              <a href={primaryCta.href} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
                {primaryCta.label}
              </a>
            )}
            {addons.length > 0 && (
              <a href="#addons" class="btn btn--ghost">
                {addons.length} add-on{addons.length > 1 ? 's' : ''}
              </a>
            )}
          </div>

          {data.acquired && (
            <p
              role="note"
              style="margin:8px 0 0;padding:16px 18px;border:1px solid var(--border);border-radius:var(--r-md);font-size:var(--text-ui);line-height:1.55;color:var(--text-subtle)"
            >
              <strong style="color:var(--text)">
                {data.acquiredBy ? (
                  <>
                    Now part of the{' '}
                    {data.acquiredUrl ? (
                      <a href={data.acquiredUrl} target="_blank" rel="noopener noreferrer">{data.acquiredBy}</a>
                    ) : (
                      data.acquiredBy
                    )}{' '}
                    family.
                  </>
                ) : (
                  'Now acquired.'
                )}
              </strong>{' '}
              Future maintenance, updates, support, and everything else related to {data.name} will be
              handled by {data.acquiredBy ? `the ${data.acquiredBy} team` : 'the new owners'}.
            </p>
          )}

          {data.features.length > 0 && (
            <ul style="margin:12px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px">
              {data.features.map((f, i) => (
                <li style="display:flex;align-items:flex-start;gap:10px;font-size:0.9375rem;line-height:1.5">
                  <span
                    class="dot"
                    style={`background:${quad[i % 4]};width:10px;height:10px;margin-top:5px`}
                    aria-hidden="true"
                  ></span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div style="display:flex;flex-direction:column;gap:16px">
          <div class="card">
            <span class="accent-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
            {facts.length > 0 && (
              <dl class="fact-grid">
                {facts.map((f) => (
                  <div>
                    <dt class="kicker">{f.label}</dt>
                    <dd style="margin:3px 0 0;font-size:0.96875rem;font-weight:var(--fw-heading)">{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div style="border-top:1px solid var(--border);padding:16px 24px;display:flex;flex-direction:column;gap:10px">
              {registryLink && (
                <a href={registryLink.href} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
                  {registryLink.label} →
                </a>
              )}
              {data.repo && (
                <a href={data.repo} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
                  View source on GitHub →
                </a>
              )}
              {!data.acquired && (
                <>
                  <a href={docsUrl} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
                    Documentation →
                  </a>
                  <a href={changelogUrl} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
                    Changelog →
                  </a>
                </>
              )}
              <a href={supportUrl} style="font-size:var(--text-ui);font-weight:var(--fw-medium)">Get support →</a>
            </div>
          </div>

          {install && (
            <div class="code">
              <div class="code__head">
                <span>INSTALL</span>
                <span class="code__dots" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
              </div>
              <pre>{install}</pre>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- What it does -->
    <Section size="sm">
      <div class="what">
        <h2 style="margin-bottom:12px;font-size:1.5rem;letter-spacing:-0.4px">What it does</h2>
        <p style="margin:0 0 var(--space-300);font-size:1.0625rem;line-height:1.55;color:var(--text-subtle)">
          {data.summary}
        </p>
        <div class="prose-foxe prose-foxe--compact">
          <Content />
        </div>
      </div>
    </Section>

    {data.screenshots.length > 0 && (
      <Section id="screenshots" variant="ink">
        <Screenshots
          id={`shots-${project.id}`}
          shots={data.screenshots}
          heading={`${data.name} in the WordPress admin`}
          lead={`Everything ${data.name} adds to wp-admin, and where to find it.`}
        />
      </Section>
    )}

    {addons.length > 0 && (
      <Section id="addons">
        <span class="eyebrow">Add-ons</span>
        <h2 style="margin:8px 0 12px;font-size:var(--text-h2-lg);letter-spacing:-0.7px">
          Extend {data.name} when you need more.
        </h2>
        <p style="margin:0 0 var(--space-500);font-size:var(--text-body);line-height:1.55;color:var(--text-subtle);max-width:620px">
          The core plugin stays lean. Each add-on is a small, opt-in plugin that snaps into the same
          settings screen — install only the ones you need.
        </p>

        <div class="addon-grid">
          {addons.map((addon) => (
            <a
              href={addonPath('oss', data.category, project.id, addon.id)}
              class="card card--pad"
              style="gap:12px;padding:24px"
            >
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                <span class="kicker" style="display:inline-flex;align-items:center;gap:7px">
                  <span
                    class="dot"
                    style={`background:${accentFor(addonIds, addon.id).color}`}
                    aria-hidden="true"
                  ></span>
                  {addon.data.location ?? 'Add-on'}
                </span>
                {addon.data.price && (
                  <span style="font-size:var(--text-xs);font-weight:var(--fw-heading);background:var(--bg-hover);border-radius:var(--r-pill);padding:4px 10px">
                    {addon.data.price}
                  </span>
                )}
              </div>
              <h3 style="font-size:var(--text-h4);font-weight:var(--fw-heading)">{addon.data.name}</h3>
              <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--text-subtle)">
                {addon.data.summary}
              </p>
              <span class="link-more" style="margin-top:auto">Learn more →</span>
            </a>
          ))}
        </div>
      </Section>
    )}

    {data.faq.length > 0 && (
      <Section variant="alt" rule="top">
        <Faq items={data.faq} />
      </Section>
    )}

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .product-hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-700);
  }
  .fact-grid {
    margin: 0;
    padding: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
  }
  /* One measured column at the compact reading scale — the bodies here are
     short sections, not articles, so they get less air than blog prose. */
  .what {
    max-width: 720px;
    margin-inline: auto;
  }
  .addon-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-250);
  }
  @media (max-width: 960px) {
    .product-hero { grid-template-columns: 1fr; gap: var(--space-500); }
    .addon-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .addon-grid { grid-template-columns: 1fr; }
  }
</style>
