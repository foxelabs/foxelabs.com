---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { categoryPath } from '../../config/tracks';
import Faq from '../../components/ui/Faq.astro';
import { breadcrumbLd, faqLd } from '../../config/seo';

// GitHub org where the source lives (libraries here today; plugins moving over).
const GITHUB_URL: string | null = 'https://github.com/foxelabs';

const projects = await getCollection('projects', ({ data }) => !data.draft && data.track === 'oss');
const count = (cat: string) => projects.filter((p) => p.data.category === cat).length;

// Landing shows category boxes (like Trading); full lists live on the category pages.
const categoryBoxes = [
  {
    title: 'WordPress Plugins',
    description:
      'Redirect managers, session limits, comment and performance tools — battle-tested on over 100,000 active sites.',
    badge: `${count('plugins')} plugins`,
    href: categoryPath('oss', 'plugins'),
    icon: 'ic:round-wordpress',
    featured: true,
    tone: '',
  },
  {
    title: 'PHP Libraries',
    description:
      'Composer packages for background queues, caching, admin notices and more — small, tested, and dependency-light.',
    badge: `${count('libraries')} libraries`,
    href: categoryPath('oss', 'libraries'),
    icon: 'file-icons:php',
    tone: 'tone-2',
  },
  {
    title: 'Apps',
    description:
      'Hosted tools and SaaS built on the same engineering. In the works — say hello if you want an early look.',
    badge: 'Coming soon',
    href: '/contact',
    icon: 'tdesign:app-filled',
    tone: 'tone-3',
  },
];

const whyItems = [
  { n: '01', title: 'Battle-tested.', body: 'Running on 100,000+ active sites. Not a demo — code that holds up in the real world.' },
  { n: '02', title: 'Open source, always.', body: 'GPL-licensed and public on WordPress.org and Packagist. Read it, fork it, trust it.' },
  { n: '03', title: 'Documented & supported.', body: 'Clear docs and changelogs. Your question reaches the person who wrote the code.' },
  { n: '04', title: 'Free core, paid power.', body: 'Every plugin is free and complete. Optional Pro addons add more — still GPL-licensed.' },
];

// Real aggregates, summed from the plugins' WordPress.org figures (conservative rounding).
// 100k+8k+3k+2k active installs; 2.20M+0.14M+0.21M+0.23M downloads; oldest plugin 2014.
const faq = [
  {
    q: 'Are Foxe Labs WordPress plugins free?',
    a:
      'Yes. Every plugin and library here is free and GPL-2.0-or-later licensed — published on WordPress.org and Packagist, with the source on GitHub. Some plugins sell optional add-ons that extend them; the core plugin stays free either way.',
  },
  {
    q: 'Which Foxe Labs plugin should I use to limit WordPress logins?',
    a:
      'Loggedin. It caps how many simultaneous sessions each account can have, and you choose whether a login over the limit is blocked or logs out the oldest session. Add-ons extend it to per-role and per-user limits.',
  },
  {
    q: 'Are these plugins still maintained?',
    a:
      'Yes. The oldest have shipped continuously since 2014 and are updated for current WordPress and PHP versions. Development happens in public on GitHub, so the commit history shows exactly how active each project is.',
  },
  {
    q: 'Can I use these plugins on client sites?',
    a:
      'Yes. The GPL places no restriction on commercial or client use — install them on as many sites as you like, modify them, and redistribute them under the same license.',
  },
];

const stats = [
  { value: '110,000+', label: 'active installs' },
  { value: '2.7M+', label: 'downloads' },
  { value: '2014', label: 'shipping since' },
];
---
<BaseLayout
  title="Open-Source WordPress Plugins & PHP Libraries | Foxe Labs"
  description="WordPress plugins, PHP libraries, and apps by Foxe Labs — open source and GPL-licensed, documented, and actively maintained."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Software', path: '/software' },
    ]),
    faqLd(faq),
  ]}
>
  <Nav />
  <main class="track-oss">
    <!-- Hero -->
    <section class="band band--wash overflow-hidden" data-reveal>
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7">
            <Eyebrow class="mb-5">Software</Eyebrow>
            <h1 style="font-size: var(--text-hero); font-weight: 800;" class="mb-5">
              Tools we've shipped <span style="color: var(--accent-ink);">and kept shipping.</span>
            </h1>
            <p class="max-w-[520px]" style="font-size: var(--text-lead); color: var(--ink-body);">
              Open-source WordPress plugins and PHP libraries — GPL-licensed, documented,
              and maintained in public. The same engineering that goes into everything we build.
            </p>
            {GITHUB_URL && (
              <div class="mt-9">
                <Button href={GITHUB_URL} variant="primary" arrow>View on GitHub</Button>
              </div>
            )}
          </div>

          <div class="lg:col-span-5">
            <div class="card card--invert p-6 md:p-7">
              <div class="flex items-center justify-between mb-5">
                <span class="font-mono text-[11px]" style="color: var(--oss); letter-spacing: 0.06em;">~/foxe-labs</span>
                <span class="font-mono text-[11px]" style="color: var(--ink-invert-dim);">bash</span>
              </div>

              <div class="font-mono text-[12.5px] leading-[1.9] overflow-x-auto" style="color: var(--ink-invert);">
                <div><span style="color: var(--oss);">$</span> composer <span style="color: var(--teal);">require</span> <span style="color: var(--moss);">foxelabs/wp-queue-process</span></div>
                <div style="color: var(--ink-invert-dim);"><span style="color: var(--oss);">✓</span> 1 package installed</div>
                <div class="h-3" aria-hidden="true"></div>
                <div><span style="color: var(--oss);">$</span> wp plugin <span style="color: var(--teal);">install</span> <span style="color: var(--moss);">404-to-301</span> --activate</div>
                <div style="color: var(--ink-invert-dim);"><span style="color: var(--oss);">Success:</span> installed and activated.</div>
                <div><span style="color: var(--oss);">$</span> <span style="color: var(--oss);">▋</span></div>
              </div>

              <div class="grid grid-cols-3 gap-4 mt-6 pt-5" style="border-top: 1px solid var(--border-invert);">
                {stats.map((s) => (
                  <div>
                    <p class="font-display font-bold text-lg" style="color: var(--ink-invert);">{s.value}</p>
                    <p class="font-mono text-[11px] mt-1" style="color: var(--ink-invert-dim);">{s.label}</p>
                  </div>
                ))}
              </div>
            </div>

            <p class="mt-3 text-center font-mono text-[10px]" style="color: var(--ink-dim);">
              Combined across our published plugins &amp; libraries.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust bar (black) -->
    <div class="band--invert" style="padding-block: 28px;">
      <div class="container-x">
        <ul class="flex flex-wrap items-center justify-center gap-x-14 gap-y-4 list-none m-0 p-0">
          {[
            { label: 'Open source · GPL', icon: 'code', tint: 'var(--oss)' },
            { label: 'On WordPress.org & Packagist', icon: 'box', tint: 'var(--teal)' },
            { label: 'Documented & tested', icon: 'doc', tint: 'var(--moss)' },
            { label: 'Maintained for years', icon: 'refresh', tint: 'var(--oss)' },
          ].map((it) => (
            <li class="flex items-center gap-2.5 text-[13px] font-medium" style="color: var(--ink-invert-dim);">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={it.tint} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {it.icon === 'code' && <><polyline points="8 6 3 12 8 18" /><polyline points="16 6 21 12 16 18" /></>}
                {it.icon === 'box' && <><path d="M21 8v11H3V8" /><rect x="2" y="4" width="20" height="4" /><line x1="10" y1="12" x2="14" y2="12" /></>}
                {it.icon === 'doc' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><polyline points="9 15 11 17 15 13" /></>}
                {it.icon === 'refresh' && <><polyline points="23 4 23 10 17 10" /><path d="M20.5 15a9 9 0 1 1-2.1-9.4L23 10" /></>}
              </svg>
              {it.label}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Category boxes -->
    <Section variant="light">
      <div class="max-w-2xl mb-14">
        <Eyebrow class="mb-5">What we build</Eyebrow>
        <h2 style="font-size: var(--text-h2); font-weight: 800;" class="mb-4">
          Small, sharp tools — each built deep.
        </h2>
        <p style="font-size: var(--text-lead); color: var(--ink-body);">
          Focused plugins and libraries that do one thing well, open-sourced and
          maintained for the long run — not sprawling do-everything suites.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {categoryBoxes.map((c) => (
          <article class={`card card--hover p-7 flex flex-col ${c.tone}`} style={c.featured ? 'border-color: var(--accent);' : ''}>
            <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-6" style="background: var(--accent-soft);">
              <Icon name={c.icon} width={21} height={21} style="color: var(--accent-ink);" aria-hidden="true" />
            </div>

            <h3 style="font-size: var(--text-h3); font-weight: 800;" class="mb-3">{c.title}</h3>
            <p class="text-[15px] mb-7 flex-1" style="color: var(--ink-body);">{c.description}</p>

            <div class="flex items-center justify-between gap-4">
              <Button href={c.href} variant="ghost" arrow class="!py-2 !px-4 !text-[13px]">
                {c.badge === 'Coming soon' ? 'Get in touch' : 'Browse'}
              </Button>
              <span
                class="font-mono text-[10px] px-2.5 py-1.5 rounded-full whitespace-nowrap"
                style="background: var(--accent-soft); color: var(--accent-deep); letter-spacing: 0.08em;"
              >
                {c.badge}
              </span>
            </div>
          </article>
        ))}
      </div>
    </Section>

    <!-- Why -->
    <Section variant="alt">
      <div class="max-w-2xl mb-14">
        <Eyebrow class="mb-5">Why our software</Eyebrow>
        <h2 style="font-size: var(--text-h2); font-weight: 800;" class="mb-4">
          Code you can read, and rely on.
        </h2>
        <p style="font-size: var(--text-lead); color: var(--ink-body);">
          Open source is the proof of how we build — public, documented, and used in
          production by tens of thousands of sites.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
        {whyItems.map((item) => (
          <div>
            <p class="font-mono text-[12px] mb-4 pb-4" style="color: var(--accent-ink); letter-spacing: 0.1em; border-bottom: 1px solid var(--border);">
              {item.n}
            </p>
            <h3 style="font-size: 1.0625rem; font-weight: 800;" class="mb-2.5">{item.title}</h3>
            <p class="text-[15px]" style="color: var(--ink-body);">{item.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CTA (black) -->
    <section class="band band--invert band--glow" data-reveal>
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <div class="lg:col-span-7">
            <Eyebrow class="mb-5">Open source</Eyebrow>
            <h2 style="font-size: var(--text-h2); font-weight: 800;" class="mb-4">
              Read the source. Build with confidence.
            </h2>
            <p style="font-size: var(--text-lead); color: var(--ink-invert-dim);">
              Every line is public and GPL-licensed. Browse the code, file an issue, or
              just reach out — the person who built it will answer.
            </p>
          </div>
          <div class="lg:col-span-5 lg:justify-self-end flex flex-wrap gap-3">
            {GITHUB_URL && <Button href={GITHUB_URL} variant="primary" arrow>View on GitHub</Button>}
            <Button href="/contact" variant="invert" arrow>Get in touch</Button>
          </div>
        </div>
      </div>
    </section>
    <Section variant="alt">
      <div class="max-w-3xl mx-auto">
        <Faq items={faq} bare />
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>
