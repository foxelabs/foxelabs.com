---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import TrustBar from '../../components/TrustBar.astro';
import { Icon } from 'astro-icon/components';
import { categoryPath } from '../../config/tracks';
import { ACCENTS, accentVars, categoryAccent } from '../../config/accents';
import Faq from '../../components/ui/Faq.astro';
import { breadcrumbLd, faqLd } from '../../config/seo';

// GitHub org where the source lives (libraries here today; plugins moving over).
const GITHUB_URL: string | null = 'https://github.com/foxelabs';

const projects = await getCollection('projects', ({ data }) => !data.draft && data.track === 'oss');
const count = (cat: string) => projects.filter((p) => p.data.category === cat).length;

// Landing shows category boxes (like Trading); full lists live on the category pages.
const categoryBoxes = [
  {
    title: 'WordPress Plugins',
    description:
      'Redirect managers, session limits, comment and performance tools — battle-tested on over 100,000 active sites.',
    badge: `${count('plugins')} plugins`,
    href: categoryPath('oss', 'plugins'),
    icon: 'ic:round-wordpress',
    featured: true,
    accent: categoryAccent('plugins'),
  },
  {
    title: 'PHP Libraries',
    description:
      'Composer packages for background queues, caching, admin notices and more — small, tested, and dependency-light.',
    badge: `${count('libraries')} libraries`,
    href: categoryPath('oss', 'libraries'),
    icon: 'file-icons:php',
    accent: categoryAccent('libraries'),
  },
  {
    title: 'Apps',
    description:
      'Hosted tools and SaaS built on the same engineering. In the works — say hello if you want an early look.',
    badge: 'Coming soon',
    href: '/contact/',
    icon: 'tdesign:app-filled',
    // Not a real category yet, so it takes the next free hue in the ramp.
    accent: ACCENTS[4],
  },
];

const whyItems = [
  { n: '01', title: 'Battle-tested.', body: 'Running on 100,000+ active sites. Not a demo — code that holds up in the real world.' },
  { n: '02', title: 'Open source, always.', body: 'GPL-licensed and public on WordPress.org and Packagist. Read it, fork it, trust it.' },
  { n: '03', title: 'Documented & supported.', body: 'Clear docs and changelogs. Your question reaches the person who wrote the code.' },
  { n: '04', title: 'Free core, paid power.', body: 'Every plugin is free and complete. Optional Pro addons add more — still GPL-licensed.' },
];

// Real aggregates, summed from the plugins' WordPress.org figures (conservative rounding).
// 100k+8k+3k+2k active installs; 2.20M+0.14M+0.21M+0.23M downloads; oldest plugin 2014.
const faq = [
  {
    q: 'Are Foxe Labs WordPress plugins free?',
    a:
      'Yes. Every plugin and library here is free and GPL-2.0-or-later licensed — published on WordPress.org and Packagist, with the source on GitHub. Some plugins sell optional add-ons that extend them; the core plugin stays free either way.',
  },
  {
    q: 'Which Foxe Labs plugin should I use to limit WordPress logins?',
    a:
      'Loggedin. It caps how many simultaneous sessions each account can have, and you choose whether a login over the limit is blocked or logs out the oldest session. Add-ons extend it to per-role and per-user limits.',
  },
  {
    q: 'Are these plugins still maintained?',
    a:
      'Yes. The oldest have shipped continuously since 2014 and are updated for current WordPress and PHP versions. Development happens in public on GitHub, so the commit history shows exactly how active each project is.',
  },
  {
    q: 'Can I use these plugins on client sites?',
    a:
      'Yes. The GPL places no restriction on commercial or client use — install them on as many sites as you like, modify them, and redistribute them under the same license.',
  },
];

const stats = [
  { value: '110,000+', label: 'active installs' },
  { value: '2.7M+', label: 'downloads' },
  { value: '2014', label: 'shipping since' },
];
---
<BaseLayout
  title="Open-Source WordPress Plugins & PHP Libraries | Foxe Labs"
  description="WordPress plugins, PHP libraries, and apps by Foxe Labs — open source and GPL-licensed, documented, and actively maintained."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Software', path: '/software' },
    ]),
    faqLd(faq),
  ]}
>
  <Nav />
  <main id="main" class="track-oss">
    <!-- Hero -->
    <section class="band band--alt overflow-hidden" data-reveal>
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7">
            <Eyebrow class="mb-5">Software</Eyebrow>
            <h1 style="font-size: var(--text-hero); font-weight: var(--fw-display);" class="mb-5">
              Tools we've shipped <span style="color: var(--accent-ink);">and kept shipping.</span>
            </h1>
            <p class="max-w-[520px]" style="font-size: var(--text-lead); color: var(--ink-body);">
              Open-source WordPress plugins and PHP libraries — GPL-licensed, documented,
              and maintained in public. The same engineering that goes into everything we build.
            </p>
            {GITHUB_URL && (
              <div class="mt-9">
                <Button href={GITHUB_URL} variant="primary" arrow>View on GitHub</Button>
              </div>
            )}
          </div>

          <div class="lg:col-span-5">
            <div class="card p-6 md:p-7" style="background: var(--n100);">
              <div class="flex items-center justify-between mb-5">
                <span class="font-code" style="font-size: var(--text-small); color: var(--ink);">~/foxe-labs</span>
                <span class="lozenge">bash</span>
              </div>

              <div class="font-code leading-[1.9] overflow-x-auto" style="font-size: var(--text-small); color: var(--ink);">
                <div><span style="color: var(--b400);">$</span> composer <span style="color: var(--acc-green-bold);">require</span> <span style="color: var(--acc-purple-bold);">foxelabs/wp-queue-process</span></div>
                <div style="color: var(--ink-dim);"><span style="color: var(--b400);">✓</span> 1 package installed</div>
                <div class="h-3" aria-hidden="true"></div>
                <div><span style="color: var(--b400);">$</span> wp plugin <span style="color: var(--acc-green-bold);">install</span> <span style="color: var(--acc-purple-bold);">404-to-301</span> --activate</div>
                <div style="color: var(--ink-dim);"><span style="color: var(--b400);">Success:</span> installed and activated.</div>
                <div><span style="color: var(--b400);">$</span> <span style="color: var(--b400);">▋</span></div>
              </div>

              <div class="grid grid-cols-3 gap-4 mt-6 pt-5" style="border-top: 1px solid var(--border);">
                {stats.map((s) => (
                  <div>
                    <p class="font-display" style="font-size: var(--text-h4); font-weight: var(--fw-heading); color: var(--ink);">{s.value}</p>
                    <p class="mt-1" style="font-size: var(--text-small); color: var(--ink-dim);">{s.label}</p>
                  </div>
                ))}
              </div>
            </div>

            <p class="mt-3 text-center" style="font-size: var(--text-small); color: var(--ink-dim);">
              Combined across our published plugins &amp; libraries.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust bar (black) -->
    <TrustBar items={[
      { label: 'Open source · GPL', icon: 'code', tint: 'var(--b400)' },
      { label: 'On WordPress.org & Packagist', icon: 'box', tint: 'var(--acc-green)' },
      { label: 'Documented & tested', icon: 'doc', tint: 'var(--acc-purple)' },
      { label: 'Maintained for years', icon: 'refresh', tint: 'var(--acc-orange)' },
    ]} />

    <!-- Category boxes -->
    <Section variant="light">
      <div class="max-w-2xl mb-14">
        <Eyebrow class="mb-5">What we build</Eyebrow>
        <h2 style="font-size: var(--text-h2); font-weight: var(--fw-display);" class="mb-4">
          Small, sharp tools — each built deep.
        </h2>
        <p style="font-size: var(--text-lead); color: var(--ink-body);">
          Focused plugins and libraries that do one thing well, open-sourced and
          maintained for the long run — not sprawling do-everything suites.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {categoryBoxes.map((c) => (
          <article class="category-card card card--hover p-7 flex flex-col" style={accentVars(c.accent)}>
            <div class="w-11 h-11 rounded-[8px] flex items-center justify-center mb-6" style="background: var(--accent-soft);">
              <Icon name={c.icon} width={21} height={21} style="color: var(--accent-ink);" aria-hidden="true" />
            </div>

            <h3 style="font-size: var(--text-h3); font-weight: var(--fw-heading);" class="mb-3">{c.title}</h3>
            <p class="mb-7 flex-1" style="font-size: var(--text-ui); color: var(--ink-body);">{c.description}</p>

            <div class="flex items-center justify-between gap-4">
              <Button href={c.href} variant="ghost" arrow size="sm">
                {c.badge === 'Coming soon' ? 'Get in touch' : 'Browse'}
              </Button>
              <span
                class="lozenge whitespace-nowrap"
                style="background: var(--accent-soft); color: var(--accent-deep);"
              >
                {c.badge}
              </span>
            </div>
          </article>
        ))}
      </div>
    </Section>

    <!-- Why -->
    <Section variant="alt">
      <div class="max-w-2xl mb-14">
        <Eyebrow class="mb-5">Why our software</Eyebrow>
        <h2 style="font-size: var(--text-h2); font-weight: var(--fw-display);" class="mb-4">
          Code you can read, and rely on.
        </h2>
        <p style="font-size: var(--text-lead); color: var(--ink-body);">
          Open source is the proof of how we build — public, documented, and used in
          production by tens of thousands of sites.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
        {whyItems.map((item, i) => (
          <div style={accentVars(ACCENTS[i % ACCENTS.length])}>
            <p class="mb-4 pb-4" style="font-size: var(--text-ui); font-weight: var(--fw-bold); color: var(--accent-ink); border-bottom: 2px solid var(--accent-ink);">
              {item.n}
            </p>
            <h3 style="font-size: var(--text-h5); font-weight: var(--fw-heading);" class="mb-2.5">{item.title}</h3>
            <p style="font-size: var(--text-ui); color: var(--ink-body);">{item.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CTA (black) -->
    <section class="band band--invert" data-reveal>
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <div class="lg:col-span-7">
            <Eyebrow class="mb-5">Open source</Eyebrow>
            <h2 style="font-size: var(--text-h2); font-weight: var(--fw-display);" class="mb-4">
              Read the source. Build with confidence.
            </h2>
            <p style="font-size: var(--text-lead); color: var(--ink-invert-dim);">
              Every line is public and GPL-licensed. Browse the code, file an issue, or
              just reach out — the team that built it will answer.
            </p>
          </div>
          <div class="lg:col-span-5 lg:justify-self-end flex flex-wrap gap-3">
            {GITHUB_URL && <Button href={GITHUB_URL} variant="primary" arrow>View on GitHub</Button>}
            <Button href="/contact/" variant="invert" arrow>Get in touch</Button>
          </div>
        </div>
      </div>
    </section>
    <Section variant="alt">
      <div class="max-w-3xl mx-auto">
        <Faq items={faq} bare />
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Same top-rule treatment the product and add-on grids use. */
  .category-card {
    position: relative;
    border-top: 3px solid var(--accent-ink);
  }
  /* Stretched link: the Browse button's hit area covers the whole card, so
     the card is clickable anywhere while the button stays the visible cue. */
  .category-card :global(a.btn)::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .category-card h3 {
    transition: color 0.1s ease;
  }
  .category-card:hover h3 {
    color: var(--accent-ink);
  }
</style>
