---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Faq from '../../components/ui/Faq.astro';
import PrincipleGrid from '../../components/ui/PrincipleGrid.astro';
import { Icon } from 'astro-icon/components';
import { categoryPath, projectPath } from '../../config/tracks';
import { ACCENTS, categoryAccent } from '../../config/accents';
import { breadcrumbLd, collectionPageLd, faqLd } from '../../config/seo';

// GitHub org where the source lives (libraries here today; plugins moving over).
const GITHUB_URL: string | null = 'https://github.com/foxelabs';

const projects = await getCollection('projects', ({ data }) => !data.draft && data.track === 'oss');
const count = (cat: string) => projects.filter((p) => p.data.category === cat).length;

// The hub shows category boxes; the full lists live on the category pages.
const categoryBoxes = [
  {
    title: 'WordPress Plugins',
    description:
      'Redirect managers, session limits, comment and performance tools — battle-tested on over 100,000 active sites.',
    badge: `${count('plugins')} plugins`,
    href: categoryPath('oss', 'plugins'),
    accent: categoryAccent('plugins'),
    icon: 'mingcute:plugin-2-line',
  },
  {
    title: 'PHP Libraries',
    description:
      'Composer packages for background queues, caching, admin notices and more — small, tested, and dependency-light.',
    badge: `${count('libraries')} libraries`,
    href: categoryPath('oss', 'libraries'),
    accent: categoryAccent('libraries'),
    icon: 'mingcute:box-2-line',
  },
  {
    title: 'Apps',
    description:
      'Hosted tools and SaaS built on the same engineering. In the works — say hello if you want an early look.',
    badge: 'Coming soon',
    href: '/contact/',
    // Not a real category yet, so it takes the next free hue in the quad.
    accent: ACCENTS[3],
    icon: 'mingcute:rocket-line',
  },
];

const principles = [
  {
    title: 'Battle-tested',
    icon: 'mingcute:safety-certificate-line',
    color: 'var(--acc-1)',
    body: 'Running on 100,000+ active sites. Not a demo — code that holds up in the real world.',
  },
  {
    title: 'Open source, always',
    icon: 'mingcute:code-line',
    color: 'var(--acc-2)',
    body: 'GPL-licensed and public on WordPress.org and Packagist. Read it, fork it, trust it.',
  },
  {
    title: 'Documented & supported',
    icon: 'mingcute:book-2-line',
    color: 'var(--acc-3)',
    body: 'Clear docs and changelogs. Your question reaches the person who wrote the code.',
  },
  {
    title: 'Free core, paid power',
    icon: 'mingcute:plugin-2-line',
    color: 'var(--acc-4)',
    body: 'Every plugin is free and complete. Optional add-ons extend it — still GPL-licensed.',
  },
];

// Real aggregates, summed from the plugins' WordPress.org figures (conservative rounding).
const stats = [
  { value: '110,000+', label: 'active installs' },
  { value: '2.7M+', label: 'downloads' },
  { value: '2014', label: 'shipping since' },
  { value: 'GPL', label: 'licensed, every one' },
];

const faq = [
  {
    q: 'Are Foxe Labs WordPress plugins free?',
    a:
      'Yes. Every plugin and library here is free and GPL-2.0-or-later licensed — published on WordPress.org and Packagist, with the source on GitHub. Some plugins sell optional add-ons that extend them; the core plugin stays free either way.',
  },
  {
    q: 'Which Foxe Labs plugin should I use to limit WordPress logins?',
    a:
      'Loggedin. It caps how many simultaneous sessions each account can have, and you choose whether a login over the limit is blocked or logs out the oldest session. Add-ons extend it to per-role and per-user limits.',
  },
  {
    q: 'Are these plugins still maintained?',
    a:
      'Yes. The oldest have shipped continuously since 2014 and are updated for current WordPress and PHP versions. Development happens in public on GitHub, so the commit history shows exactly how active each project is.',
  },
  {
    q: 'Can I use these plugins on client sites?',
    a:
      'Yes. The GPL places no restriction on commercial or client use — install them on as many sites as you like, modify them, and redistribute them under the same license.',
  },
];
---
<BaseLayout
  title="Open-Source WordPress Plugins & PHP Libraries | Foxe Labs"
  description="WordPress plugins, PHP libraries, and apps by Foxe Labs — open source and GPL-licensed, documented, and actively maintained."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Software', path: '/software' },
    ]),
    collectionPageLd({
      name: 'Open-Source WordPress Plugins & PHP Libraries',
      description:
        'WordPress plugins, PHP libraries, and apps by Foxe Labs — open source and GPL-licensed, documented, and actively maintained.',
      url: '/software/',
      items: projects
        .sort((a, b) => a.data.order - b.data.order)
        .map((p) => ({ name: p.data.name, path: projectPath('oss', p.data.category, p.id) })),
    }),
    faqLd(faq),
  ]}
>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="band band--sm band--bottom">
      <div class="container-x">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start;max-width:760px">
          <Eyebrow chip color="var(--acc-1)">Software</Eyebrow>
          <h1 style="font-size:var(--text-title);letter-spacing:-1.2px">
            Tools we've shipped and kept shipping.
          </h1>
          <p style="margin:0;max-width:560px;font-size:1.125rem;line-height:1.5;color:var(--text-subtle)">
            Open-source WordPress plugins and PHP libraries — GPL-licensed, documented, and
            maintained in public. The same engineering that goes into everything we build.
          </p>
          {GITHUB_URL && (
            <a href={GITHUB_URL} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">
              <Icon name="mingcute:github-line" size={18} aria-hidden="true" />
              View on GitHub
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section class="band--subtle band--bottom">
      <div class="container-x">
        <div class="stat-row">
          {stats.map((s) => (
            <div style="padding:var(--space-350) var(--space-300);text-align:center">
              <div class="stat__value">{s.value}</div>
              <div class="stat__label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Categories -->
    <Section>
      <h2 style="margin-bottom:var(--space-150);font-size:var(--text-h2-lg);letter-spacing:-0.8px">
        Three shelves, one standard.
      </h2>
      <p style="margin:0 0 var(--space-500);font-size:var(--text-body);line-height:1.55;color:var(--text-subtle);max-width:620px">
        Everything here is built, documented and supported in-house — whether it runs inside
        WordPress, inside your Composer autoloader, or on our servers.
      </p>
      <div class="grid-3">
        {categoryBoxes.map((box) => (
          <a
            href={box.href}
            class="card card--pad"
            style={`gap:var(--space-150);padding:var(--space-400);border-top:4px solid ${box.accent.color}`}
          >
            <div class="icon-tile" style={`background:color-mix(in srgb, ${box.accent.color} 10%, transparent);color:${box.accent.color}`}>
              <Icon name={box.icon} size={24} aria-hidden="true" />
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
              <h3 style="font-size:var(--text-h3)">{box.title}</h3>
              <span class="badge">
                {box.badge}
              </span>
            </div>
            <p style="margin:0;font-size:var(--text-md);line-height:1.55;color:var(--text-subtle)">
              {box.description}
            </p>
            <span class="link-more" style="margin-top:auto">Explore →</span>
          </a>
        ))}
      </div>
    </Section>

    <!-- Principles -->
    <Section variant="ink" size="sm">
      <h2 style="margin-bottom:var(--space-500);font-size:var(--text-h2);letter-spacing:-0.6px">
        Why these are worth installing
      </h2>
      <PrincipleGrid items={principles} onInk />
    </Section>

    <Section variant="alt" rule="top">
      <Faq items={faq} />
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 720px) {
    .stat-row { grid-template-columns: 1fr 1fr; }
  }
</style>
