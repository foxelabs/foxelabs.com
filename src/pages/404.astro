---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { categoryAccent, topicAccent, accentVars } from '../config/accents';

// A dead end is the one page where signposting matters more than apology, so
// the three ways out get a hue each rather than a row of identical buttons.
const exits = [
  {
    href: '/software',
    label: 'Software',
    body: 'WordPress plugins and PHP libraries, open source and maintained.',
    icon: 'mingcute:code-fill',
    accent: categoryAccent('plugins'),
  },
  {
    href: '/trading',
    label: 'Trading',
    body: 'Expert advisors and the tools we build for our own desks.',
    icon: 'mynaui:chart-candlestick-solid',
    accent: categoryAccent('expert-advisors'),
  },
  {
    href: '/blog',
    label: 'Blog',
    body: 'Notes on how we build — software, risk, and the occasional release.',
    icon: 'mingcute:book-2-line',
    // The hue the blog's own filter row gives untracked writing, so the card
    // and the page it opens agree.
    accent: topicAccent('Writing'),
  },
];
---
<BaseLayout
  title="Page Not Found — Foxe Labs"
  description="That page doesn't exist. Head back to the Foxe Labs homepage, software, or trading tools."
  noindex
>
  <Nav />
  <main id="main">
    <Section variant="light">
      <div class="text-center py-6">
        <!-- The fox, on the hunt -->
        <div class="relative inline-flex items-center justify-center mb-8">
          <div
            class="w-28 h-28 md:w-32 md:h-32 rounded-full flex items-center justify-center"
            style="background: var(--surface-alt); border: 1px solid var(--border-soft);"
          >
            <span class="w-16 h-16 md:w-[72px] md:h-[72px] fox-404" aria-hidden="true"></span>
          </div>
          <span
            class="absolute -top-1 -right-1 font-display font-bold text-lg w-9 h-9 rounded-full flex items-center justify-center rotate-6"
            style="background: var(--accent); color: var(--accent-on);"
          >?</span>
        </div>

        <div class="max-w-[720px] mx-auto">
          <Eyebrow class="mb-5">Error 404 · page not found</Eyebrow>
          <h1 style="font-size: var(--text-hero); font-weight: var(--fw-display);" class="mb-5">
            Even the fox couldn't <span class="hl-accent">sniff this one out</span>.
          </h1>
          <p class="mb-8 leading-relaxed" style="font-size: var(--text-lead-sm); color: var(--ink-body);">
            This page doesn't exist. It either moved, never shipped, or got
            liquidated on a bad trade. Either way — nothing to see here.
          </p>
        </div>

        <div>
          <Button href="/" variant="primary" size="lg" arrow="back">Back to safety</Button>
        </div>

        <p class="mt-14 mb-5" style="font-size: var(--text-ui); font-weight: var(--fw-bold); color: var(--ink-dim); text-transform: uppercase; letter-spacing: 0.06em;">
          Or pick up a different scent
        </p>
        <div class="grid sm:grid-cols-3 gap-5 text-left">
          {exits.map((e) => (
            <a href={e.href} class="exit-card card card--hover p-5 flex flex-col" style={accentVars(e.accent)}>
              <span class="w-10 h-10 mb-4 flex items-center justify-center" style="background: var(--accent-soft); border-radius: var(--r-sm);">
                <Icon name={e.icon} width={20} height={20} style="color: var(--accent-ink);" aria-hidden="true" />
              </span>
              <span class="exit-card__label block mb-1.5" style="font-size: var(--text-h5); font-weight: var(--fw-heading); color: var(--ink);">
                {e.label}
              </span>
              <span class="block" style="font-size: var(--text-ui); color: var(--ink-body);">{e.body}</span>
            </a>
          ))}
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .exit-card__label {
    transition: color 0.1s ease;
  }
  .exit-card:hover .exit-card__label {
    color: var(--accent-ink);
  }
</style>
