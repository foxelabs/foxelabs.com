---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout
  title="Page Not Found — Foxe Labs"
  description="That page doesn't exist. Head back to the Foxe Labs homepage, software, or trading tools."
  noindex
>
  <Nav />
  <main class="track-hub">
    <Section variant="light">
      <div class="max-w-2xl mx-auto text-center py-6">
        <!-- The fox, on the hunt -->
        <div class="relative inline-flex items-center justify-center mb-8">
          <div
            class="w-28 h-28 md:w-32 md:h-32 rounded-full flex items-center justify-center"
            style="background: var(--surface-alt); border: 1px solid var(--border-soft);"
          >
            <img src="/fox.svg" alt="" width="72" height="72" class="w-16 h-16 md:w-[72px] md:h-[72px] animate-fox-sniff" aria-hidden="true" />
          </div>
          <span
            class="absolute -top-1 -right-1 font-display font-bold text-lg w-9 h-9 rounded-full flex items-center justify-center rotate-6"
            style="background: var(--accent-btn); color: var(--accent-on); box-shadow: var(--shadow-card);"
          >?</span>
        </div>

        <Eyebrow class="mb-5">Error 404 · page not found</Eyebrow>
        <h1 style="font-size: var(--text-hero); font-weight: 800;" class="mb-5">
          Even the fox couldn't <span style="color: var(--accent-ink);">sniff this one out</span>.
        </h1>
        <p class="mb-8" style="font-size: var(--text-lead); color: var(--ink-body);">
          This page doesn't exist. It either moved, never shipped, or got
          liquidated on a bad trade. Either way — nothing to see here.
        </p>

        <!-- Mono easter-egg: one joke per craft -->
        <div
          class="inline-block text-left font-mono text-[12.5px] leading-[1.9] px-5 py-4 rounded-xl mb-9 max-w-full overflow-x-auto"
          style="background: var(--surface-invert); color: var(--ink-invert);"
        >
          <div><span style="color: var(--oss);">$</span> find / -name "this-page"</div>
          <div style="color: var(--ink-invert-dim);">→ 0 results. Not even in the git history.</div>
          <div><span style="color: var(--gold);">$</span> backtest --url ./404</div>
          <div style="color: var(--ink-invert-dim);">→ max drawdown: 100%. Position closed.</div>
        </div>

        <div class="flex flex-wrap justify-center gap-3">
          <Button href="/" variant="primary" arrow>Back to safety</Button>
          <Button href="/software" variant="ghost" arrow>Software</Button>
          <Button href="/trading" variant="ghost" arrow>Trading</Button>
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>
