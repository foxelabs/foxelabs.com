---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const shortcuts = [
  { href: '/software/plugins/', label: 'WordPress Plugins', color: 'var(--acc-1)' },
  { href: '/trading/tools/', label: 'Trading Tools', color: 'var(--acc-2)' },
  { href: '/contact/', label: 'Report a broken link', color: 'var(--acc-3)' },
];
---
<BaseLayout
  title="Page not found — Foxe Labs"
  description="The page you were looking for does not exist."
  noindex
>
  <Nav />
  <main id="main" class="notfound">
    <div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--space-300);max-width:620px">
      <div class="fourohfour" aria-hidden="true">
        <span class="fourohfour__digit">4</span>
        <span class="quad-block">
          <span style="background:var(--acc-1)"></span>
          <span style="background:var(--acc-2)"></span>
          <span style="background:var(--acc-4)"></span>
          <span style="background:var(--acc-3)"></span>
        </span>
        <span class="fourohfour__digit">4</span>
      </div>

      <h1 style="font-size:2.125rem;letter-spacing:-0.7px">This page doesn't exist.</h1>
      <p style="margin:0;font-size:var(--text-body-lg);line-height:1.6;color:var(--text-subtle)">
        The link is broken, moved, or never was. We literally wrote the plugin for this — 404 to 301
        redirects a hundred thousand sites past dead ends like this one. Consider yourself redirected.
      </p>

      <div style="display:flex;gap:var(--space-150);margin-top:4px;flex-wrap:wrap;justify-content:center">
        <a href="/" class="btn btn--primary">Go to the homepage</a>
        <a href="/blog/" class="btn btn--ghost">Read the blog</a>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:var(--space-150)">
        {shortcuts.map((s) => (
          <a href={s.href} class="chip">
            <span class="dot" style={`background:${s.color}`} aria-hidden="true"></span>
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer slim />
</BaseLayout>

<style>
  .notfound {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-800) var(--container-pad);
  }
  .fourohfour {
    display: flex;
    gap: clamp(0.5rem, 3vw, 1rem);
    align-items: stretch;
  }
  .fourohfour__digit {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 18vw, 7.5rem);
    line-height: 1;
    font-weight: var(--fw-display);
    letter-spacing: -0.04em;
  }
  .quad-block {
    width: clamp(3.5rem, 14vw, 6rem);
    border-radius: var(--r-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    overflow: hidden;
    align-self: stretch;
  }
</style>
