---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import Faq from '../components/ui/Faq.astro';
import PostCard from '../components/PostCard.astro';
import { faqLd } from '../config/seo';
import { trackConfig } from '../config/tracks';

// Latest writing — real published posts, newest first. No fabricated releases.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// The three names under each track card come from the project collection, so
// the home page cannot drift from what actually ships.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const pick = (track: 'oss' | 'trading') =>
  projects
    .filter((p) => p.data.track === track)
    .slice(0, 3)
    .map((p) => ({
      href: `${trackConfig[track].basePath}/${p.data.category}/${p.id}/`,
      label: `${p.data.name} — ${p.data.tagline}`,
    }));

const tracks = [
  {
    id: 'software',
    title: 'Software',
    color: 'var(--acc-1)',
    body:
      'WordPress plugins and PHP libraries — open source and GPL-licensed, documented, and shipped for years. Paid Pro add-ons and new apps join the same shelf.',
    links: pick('oss'),
    cta: { href: '/software/', label: 'Explore software →' },
  },
  {
    id: 'trading',
    title: 'Trading',
    color: 'var(--acc-2)',
    body:
      'Expert advisors, a universal trading journal, and precision utilities for prop firm and serious retail traders. Engineered risk-first.',
    links: pick('trading'),
    cta: { href: '/trading/', label: 'Explore trading →' },
  },
];

const tags = [
  { label: '110K+ installs', color: 'var(--acc-1)' },
  { label: 'XAUUSD · risk-first', color: 'var(--acc-2)' },
  { label: 'Open source · GPL', color: 'var(--acc-3)' },
  { label: 'Shipping since 2014', color: 'var(--acc-4)' },
];

const stats = [
  { value: '110K+', label: 'active installs' },
  { value: '2.7M+', label: 'downloads' },
  { value: '2014', label: 'shipping since' },
  { value: 'In-house', label: 'designed & built' },
];

const principles = [
  {
    title: 'Risk-first',
    color: 'var(--acc-1)',
    body: 'Downside is designed in before upside — in code and in the markets.',
  },
  {
    title: 'Open by default',
    color: 'var(--acc-2)',
    body: 'Our source is public. Read it, fork it, trust it.',
  },
  {
    title: 'Documented',
    color: 'var(--acc-3)',
    body: 'Clear docs and changelogs. Questions reach the team that wrote it.',
  },
  {
    title: 'Built in-house',
    color: 'var(--acc-4)',
    body: 'Every project designed, built and supported under one roof.',
  },
];

const faq = [
  {
    q: 'What is Foxe Labs?',
    a:
      'Foxe Labs is a small software studio based in Kerala, India. We ship two things: open-source WordPress plugins and PHP libraries, and precision trading software for MetaTrader 5. The plugins have been maintained since 2014 and run on over 110,000 active sites.',
  },
  {
    q: 'Are the WordPress plugins free?',
    a:
      'Yes. Every plugin and library on the software track is free and GPL-2.0-or-later licensed, published on WordPress.org and Packagist with the source on GitHub. Some plugins offer paid add-ons that extend them, but the core plugin is always free.',
  },
  {
    q: 'What trading software does Foxe Labs make?',
    a:
      'Gold Scalpel, a fully automated XAUUSD breakout scalper for MetaTrader 5, is live on the MQL5 Market with a free Strategy Tester demo. Further expert advisors and trading tools are in development and open by waitlist. Trading carries substantial risk and nothing published here is financial advice.',
  },
  {
    q: 'How do I get support?',
    a:
      'Free plugins are supported on their WordPress.org support forums, and anything else goes through the contact form or support@foxelabs.com. Messages reach the team that wrote the code — there are no support tiers to escalate through.',
  },
];

// The decorative grid behind the hero. Colours are assigned by a fixed
// arithmetic walk rather than at random, so the pattern is stable across builds.
const quad = ['var(--acc-1)', 'var(--acc-2)', 'var(--acc-3)', 'var(--acc-4)'];
const heroCells = Array.from({ length: 180 }, (_, i) => quad[(i * 7 + Math.floor(i / 13) * 3) % 4]);
---

<BaseLayout jsonLd={faqLd(faq)}>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section style="position:relative;overflow:hidden">
      <div class="cellgrid" aria-hidden="true" data-cellgrid>
        {heroCells.map((color) => <i data-color={color}></i>)}
      </div>
      <div
        class="container-x"
        style="position:relative;padding-block:var(--space-800) var(--band-pad-sm);display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--space-300);pointer-events:none"
      >
        <span class="chip chip--muted">
          <span class="dot" style="background:var(--acc-4);border-radius:2px;width:8px;height:8px" aria-hidden="true"></span>
          Lines of code · Lines on the chart
        </span>
        <h1 style="font-size:var(--text-hero);line-height:1.08;letter-spacing:-1.5px;max-width:820px">
          Engineering in the open — and in the markets.
        </h1>
        <p style="margin:0;font-size:var(--text-lead);line-height:1.5;color:var(--text-subtle);max-width:620px">
          Foxe Labs is a small software studio. Open-source tools with a decade-long track record,
          and the same engineering discipline brought to trading software.
        </p>
        <div style="display:flex;gap:12px;margin-top:8px;pointer-events:auto;flex-wrap:wrap;justify-content:center">
          <a href="/software/" class="btn btn--primary">Explore Software</a>
          <a href="/trading/" class="btn btn--ghost">Explore Trading</a>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:12px">
          {tags.map((tag) => (
            <span class="chip">
              <span class="dot" style={`background:${tag.color};width:10px;height:10px`} aria-hidden="true"></span>
              {tag.label}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section class="band--subtle band--top band--bottom">
      <div class="container-x">
        <div class="stat-row">
          {stats.map((s) => (
            <div style="padding:28px 24px;text-align:center">
              <div class="stat__value">{s.value}</div>
              <div class="stat__label">{s.label}</div>
            </div>
          ))}
        </div>
        <p style="margin:0;text-align:center;font-size:var(--text-small);color:var(--text-subtle);padding:0 24px 20px">
          Public on WordPress.org · Packagist · GitHub — open source since 2014
        </p>
      </div>
    </section>

    <!-- Two tracks -->
    <Section id="tracks">
      <h2 style="margin-bottom:12px;font-size:var(--text-h2-lg);letter-spacing:-0.8px">
        One studio, two disciplines.
      </h2>
      <p style="margin:0 0 var(--space-500);font-size:var(--text-body);line-height:1.55;color:var(--text-subtle);max-width:640px">
        The same team, the same standards — pointed at two different problems. Open-source software
        is the proof of how we build; trading is where that discipline goes next.
      </p>
      <div class="two-col">
        {tracks.map((track) => (
          <div
            class="card card--pad"
            id={track.id}
            style={`gap:var(--space-200);border-top:4px solid ${track.color}`}
          >
            <h3 style="font-size:var(--text-h3)">{track.title}</h3>
            <p style="margin:0;font-size:0.9375rem;line-height:1.55;color:var(--text-subtle)">
              {track.body}
            </p>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;font-size:0.90625rem">
              {track.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
            <a href={track.cta.href} class="link-more" style="margin-top:auto">{track.cta.label}</a>
          </div>
        ))}
      </div>
    </Section>

    <!-- Principles -->
    <Section variant="ink" size="sm">
      <h2 style="margin-bottom:var(--space-500);font-size:var(--text-h2);letter-spacing:-0.6px">
        How we build
      </h2>
      <div class="four-col">
        {principles.map((p) => (
          <div style="display:flex;flex-direction:column;gap:10px">
            <span class="dot dot--lg" style={`background:${p.color}`} aria-hidden="true"></span>
            <h3 style="font-size:1.0625rem;font-weight:var(--fw-heading)">{p.title}</h3>
            <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--ink-band-subtle)">
              {p.body}
            </p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <Section id="blog">
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:var(--space-500);flex-wrap:wrap">
          <h2 style="font-size:var(--text-h2);letter-spacing:-0.6px">Latest from the studio</h2>
          <a href="/blog/" class="link-more">Read the blog →</a>
        </div>
        <div class="three-col">
          {posts.map((post) => <PostCard post={post} height={140} />)}
        </div>
      </Section>
    )}

    <!-- FAQ -->
    <Section variant="alt" rule="top">
      <Faq items={faq} />
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-300);
  }
  .three-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-300);
  }
  .four-col {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-400);
  }
  @media (max-width: 960px) {
    .three-col { grid-template-columns: repeat(2, 1fr); }
    .four-col  { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .stat-row { grid-template-columns: 1fr 1fr; }
    .two-col, .three-col { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // Hovering a cell flashes its colour, then lets it fade back out. Purely
  // decorative: the grid is aria-hidden and sits behind the copy.
  (function () {
    var grid = document.querySelector('[data-cellgrid]');
    if (!grid) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.addEventListener('mouseover', function (event) {
      var cell = event.target;
      if (!cell || cell.tagName !== 'I') return;
      cell.style.transition = 'background-color 0s';
      cell.style.backgroundColor = cell.dataset.color;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          cell.style.transition = 'background-color 1.4s ease-out';
          cell.style.backgroundColor = 'transparent';
        });
      });
    });
  })();
</script>
