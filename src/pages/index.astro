---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import Faq from '../components/ui/Faq.astro';
import TrackCard from '../components/ui/TrackCard.astro';
import PrincipleGrid from '../components/ui/PrincipleGrid.astro';
import { Image } from 'astro:assets';
import { faqLd } from '../config/seo';
import { topicOf } from '../config/tracks';
import { topicAccent } from '../config/accents';

// Latest writing — real published posts, newest first. No fabricated releases.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

// The blog section leads with the newest post; the next three stack beside it
// as thumbnail rows.
const [lead, ...stack] = posts;
const postMeta = (post: (typeof posts)[number]) => {
  const topic = topicOf(post.data.track);
  const mins = Math.max(1, Math.round((post.body ?? '').trim().split(/\s+/).length / 200));
  return {
    topic,
    // Topic-keyed, same as PostCard — the same post must not change kicker
    // colour between the home page and /blog.
    hue: topicAccent(topic).color,
    date: post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
    mins,
  };
};

// Two doors — a summary line per track, not an index.
const tracks = [
  {
    id: 'software',
    title: 'Software',
    hue: 'var(--hue-emerald)',
    icon: 'mingcute:code-line',
    label: 'Open source · GPL',
    body:
      'WordPress plugins and PHP libraries, GPL-licensed and maintained in the open since 2014 — years of public changelogs and support threads behind each one.',
    trail: 'WordPress plugins · PHP libraries · Apps',
    href: '/software/',
  },
  {
    id: 'trading',
    title: 'Trading',
    hue: 'var(--hue-amber)',
    icon: 'mingcute:chart-line-line',
    label: 'Built by traders',
    body:
      'Expert advisors and trading tools for MetaTrader 5, engineered like the software beside them — versioned, tested, and traded on our own accounts first.',
    trail: 'Expert advisors · Trading tools',
    href: '/trading/',
  },
];

// Aggregate track record — the whole open-source history, product-agnostic.
const stats = [
  { value: '110,000+', label: 'active installs' },
  { value: '2.7M+', label: 'downloads' },
  { value: '2014', label: 'first release' },
];

// The constellation's orbiting product chips.
const orbit = [
  { name: 'loggedin', hue: 'var(--hue-emerald)', pos: 'tl' },
  { name: 'tickerlog', hue: 'var(--hue-amber)', pos: 'tr' },
  { name: 'wp-queue-process', hue: 'var(--hue-blue)', pos: 'bl' },
  { name: 'gold-scalpel', hue: 'var(--hue-purple)', pos: 'br' },
];

const principles = [
  {
    n: '01',
    hue: 'var(--hue-blue)',
    icon: 'mingcute:eye-line',
    title: 'In the open',
    body: 'A decade of public code, public changelogs and public support threads. You can read every line before you trust it.',
  },
  {
    n: '02',
    hue: 'var(--hue-amber)',
    icon: 'mingcute:heartbeat-line',
    title: 'Dogfooded',
    body: 'Every trading tool runs on our own accounts before it ships. If a number is on this site, it is real or it is not here.',
  },
  {
    n: '03',
    hue: 'var(--hue-emerald)',
    icon: 'mingcute:group-line',
    title: 'Small on purpose',
    body: 'The team that answers the contact form is the team that writes the code. Feedback goes straight into the next release.',
  },
];

const faq = [
  {
    q: 'What is Foxe Labs?',
    a:
      'Foxe Labs is a small software lab based in Kerala, India. We ship two things: open-source WordPress plugins and PHP libraries, and precision trading software for MetaTrader 5. The open-source work has been maintained since 2014 and has passed 2.7 million downloads.',
  },
  {
    q: 'Is Foxe Labs software open source?',
    a:
      'The WordPress plugins and PHP libraries are open source under GPL-2.0-or-later, published on WordPress.org and Packagist with the source on GitHub. Core plugins are free; some offer paid add-ons that extend them.',
  },
  {
    q: 'What trading software does Foxe Labs make?',
    a:
      'Gold Scalpel, a fully automated XAUUSD breakout scalper for MetaTrader 5, is live on the MQL5 Market with a free Strategy Tester demo. Further expert advisors and trading tools are in development and open by waitlist. Trading carries substantial risk and nothing published here is financial advice.',
  },
  {
    q: 'How do I get support?',
    a:
      'Free plugins are supported on their WordPress.org support forums, and anything else goes through the contact form or support@foxelabs.com. Messages reach the team that wrote the code — there are no support tiers to escalate through.',
  },
];
---

<BaseLayout jsonLd={faqLd(faq)}>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="cellgrid" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--amber" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--emerald" aria-hidden="true"></div>
      <div class="container-x hero__inner">
        <div class="hero__copy">
          <span class="chip chip--muted chip--solid" style="align-self:flex-start">
            <span class="sync-dot" aria-hidden="true"></span>
            Shipping since 2014
          </span>
          <h1 style="font-size:var(--text-hero);line-height:1.05">
            Built in the <span class="mark-underline">open.</span><br />Run on the charts.
          </h1>
          <p style="margin:0;font-size:var(--text-lead);color:var(--text-subtle);max-width:540px">
            Foxe Labs is a small software lab. For a decade we have shipped open-source
            WordPress plugins and PHP libraries; now the same discipline goes into trading
            tools — expert advisors, indicators, and a journal.
          </p>
          <div style="display:flex;gap:14px;flex-wrap:wrap">
            <a href="/software/" class="btn btn--primary">
              <Icon name="mingcute:code-line" size={16} aria-hidden="true" />
              See the software
            </a>
            <a href="/trading/" class="btn btn--ghost">
              <Icon name="mingcute:chart-line-line" size={16} aria-hidden="true" />
              See the trading tools
            </a>
          </div>
          <span class="mono" style="font-size:var(--text-xs);color:var(--text-faint)">// lines of code · lines on the chart</span>
        </div>

        <!-- Quad Mark constellation. Only the drawing is decorative — the
             stats beneath it are real content and stay visible (and audible)
             on every viewport. -->
        <div class="hero__side">
        <div class="constellation" aria-hidden="true">
          <svg class="constellation__lines" viewBox="0 0 560 400" preserveAspectRatio="none">
            <line x1="225" y1="150" x2="110" y2="75" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />
            <line x1="335" y1="150" x2="450" y2="75" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />
            <line x1="225" y1="245" x2="110" y2="320" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />
            <line x1="335" y1="245" x2="450" y2="320" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />
          </svg>
          <div class="constellation__quad">
            <span class="tint" style="--hue:var(--hue-blue)"><Icon name="mingcute:code-line" size={24} /></span>
            <span class="tint" style="--hue:var(--hue-emerald)"><Icon name="mingcute:package-2-line" size={24} /></span>
            <span class="tint" style="--hue:var(--hue-amber)"><Icon name="mingcute:chart-line-line" size={24} /></span>
            <span class="tint" style="--hue:var(--hue-purple)"><Icon name="mingcute:book-2-line" size={24} /></span>
          </div>
          {orbit.map((o) => (
            <span class={`constellation__chip constellation__chip--${o.pos} mono`}>
              <span class="dot dot--sm dot--round" style={`background:${o.hue}`}></span>
              {o.name}
            </span>
          ))}
        </div>
        <div class="constellation__stats">
          {stats.map((s) => (
            <div>
              <div class="stat__value">{s.value}</div>
              <div class="stat__label">{s.label}</div>
            </div>
          ))}
        </div>
        </div>
      </div>
    </section>

    <!-- Two tracks -->
    <Section variant="alt" rule="top" id="tracks">
      <span class="eyebrow">Two tracks</span>
      <h2 style="margin:14px 0 var(--space-500);font-size:var(--text-h2-lg)">
        Everything we make, in two doors
      </h2>
      <div class="grid-2">
        {tracks.map((track) => (
          <TrackCard
            id={track.id}
            title={track.title}
            body={track.body}
            hue={track.hue}
            icon={track.icon}
            kicker={track.label}
            trail={track.trail}
            href={track.href}
          />
        ))}
      </div>
    </Section>

    <!-- Principles -->
    <Section rule="top">
      <span class="eyebrow">How we work</span>
      <h2 style="margin:14px 0 var(--space-500);font-size:var(--text-h2-lg)">
        The discipline is the product
      </h2>
      <PrincipleGrid columns={3} items={principles.map((p) => ({ title: p.title, color: p.hue, icon: p.icon, body: p.body }))} />
    </Section>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <Section variant="alt" rule="top" id="blog">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-200);flex-wrap:wrap;margin-bottom:var(--space-500)">
          <div>
            <span class="eyebrow">Activity</span>
            <h2 style="margin-top:14px;font-size:var(--text-h2-lg)">Recently shipped</h2>
          </div>
          <a href="/blog/" class="link-more">All posts →</a>
        </div>
        <div class="studio-grid">
          {lead && (() => {
            const m = postMeta(lead);
            return (
              <a href={`/blog/${lead.id}/`} class="card card--hover studio-lead">
                <div class="card__field studio-lead__cover">
                  {lead.data.heroImage && (
                    <Image
                      src={lead.data.heroImage}
                      alt={lead.data.heroImageAlt ?? lead.data.title}
                      widths={[600, 1200]}
                      sizes="(max-width: 860px) 100vw, 640px"
                      loading="eager"
                    />
                  )}
                </div>
                <div class="studio-lead__body">
                  <div style="display:flex;align-items:center;gap:var(--space-150)">
                    <span class="kicker" style={`color:${m.hue}`}>{m.topic}</span>
                    <span class="mono studio-meta">{m.date} · {m.mins} min read</span>
                  </div>
                  <h3 style="font-size:var(--text-h3);line-height:1.25">{lead.data.title}</h3>
                  <span class="link-more">Read the post →</span>
                </div>
              </a>
            );
          })()}
          <div class="card studio-stack">
            {stack.map((post, i) => {
              const m = postMeta(post);
              return (
                <a href={`/blog/${post.id}/`} class:list={['studio-row', i > 0 && 'rule-dashed']}>
                  {post.data.heroImage && (
                    <Image
                      src={post.data.heroImage}
                      alt=""
                      widths={[192]}
                      sizes="96px"
                      loading="lazy"
                      class="studio-row__thumb"
                    />
                  )}
                  <span class="studio-row__text">
                    <span class="kicker" style={`color:${m.hue}`}>{m.topic}</span>
                    <span style="color:var(--text);font-weight:var(--fw-medium);line-height:1.35">{post.data.title}</span>
                    <span class="mono studio-meta">{m.date}</span>
                  </span>
                  <span aria-hidden="true" style="color:var(--text-faint)">→</span>
                </a>
              );
            })}
          </div>
        </div>
      </Section>
    )}

    <!-- FAQ -->
    <Section rule="top">
      <Faq items={faq} />
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-600);
    align-items: center;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }
  /* ---- Constellation ---- */
  .hero__side {
    display: flex;
    flex-direction: column;
  }
  .constellation {
    position: relative;
    height: 400px;
  }
  .constellation__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .constellation__quad {
    position: absolute;
    left: 50%;
    top: 165px;
    transform: translate(-50%, -50%) translateY(0);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .constellation__quad .tint {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: var(--r-md);
  }
  .constellation__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    background: var(--bg-card);
    border: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .constellation__chip--tl { left: 4%; top: 30px; }
  .constellation__chip--tr { right: 2%; top: 30px; }
  .constellation__chip--bl { left: 0; top: 300px; }
  .constellation__chip--br { right: 0; top: 300px; }
  .constellation__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-150);
    border-top: 1px solid var(--border);
    padding-top: var(--space-250);
    margin-top: var(--space-250);
  }

  @media (max-width: 960px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__side { max-width: 560px; }
    .constellation { height: 360px; }
  }
  @media (max-width: 560px) {
    /* Only the drawing goes — the stats stay. */
    .constellation { display: none; }
  }

  /* ---- Latest from the studio ---- */
  .studio-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-250);
    align-items: stretch;
  }
  .studio-lead { min-height: 100%; }
  .studio-lead__cover {
    position: relative;
    flex: 1;
    min-height: 220px;
    border-bottom: 1px solid var(--border);
  }
  .studio-lead__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .studio-lead__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-125);
    padding: var(--space-300);
    flex: none;
  }
  .studio-meta { font-size: var(--text-xs); color: var(--text-faint); }
  .studio-stack {
    display: flex;
    flex-direction: column;
  }
  .studio-row {
    display: flex;
    align-items: center;
    gap: var(--space-250);
    padding: var(--space-250) var(--space-300);
    flex: 1;
    color: var(--text-subtle);
  }
  .studio-row:hover { text-decoration: none; }
  .studio-row:hover .studio-row__text > span:nth-child(2) { color: var(--text-strong); }
  .studio-row__thumb {
    width: 96px;
    height: 60px;
    flex: none;
    border-radius: var(--r-sm);
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .studio-row__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  @media (max-width: 860px) {
    .studio-grid { grid-template-columns: 1fr; }
    .studio-lead__cover { aspect-ratio: 16/9; flex: none; min-height: 0; }
    .studio-lead__cover img { position: static; height: 100%; }
  }
</style>
