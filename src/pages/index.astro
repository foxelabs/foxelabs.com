---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import Faq from '../components/ui/Faq.astro';
import PrincipleGrid from '../components/ui/PrincipleGrid.astro';
import PostCard from '../components/PostCard.astro';
import { faqLd } from '../config/seo';

// Latest writing — real published posts, newest first. No fabricated releases.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// The three names on each card are the design's own copy, set here rather than
// pulled from the project collection: this is a summary line, not an index.
const tracks = [
  {
    id: 'software',
    title: 'Software',
    color: 'var(--acc-1)',
    icon: 'mingcute:code-line',
    body:
      'Open-source WordPress plugins and PHP libraries, GPL-licensed and maintained since 2014. Running on 110,000+ active sites, with the source public on GitHub and support answered by the people who wrote the code.',
    links: [
      '404 to 301 — smart redirects, 100,000+ installs',
      'Loggedin — login and session control',
      'PHP libraries on Packagist',
    ],
    cta: { href: '/software/', label: 'Explore Software' },
  },
  {
    id: 'trading',
    title: 'Trading',
    color: 'var(--acc-2)',
    icon: 'mingcute:chart-line-line',
    body:
      'Precision software for MetaTrader 5 — expert advisors, a universal trading journal, and session utilities built for prop firm and serious retail traders. Every system is engineered risk-first and tested before it ships.',
    links: [
      'Gold Scalpel — automated XAUUSD scalper',
      'TickerLog — universal trading journal',
      'Session tools — MT5 indicators',
    ],
    cta: { href: '/trading/', label: 'Explore Trading' },
  },
];

const tags = [
  { label: '110K+ installs', color: 'var(--acc-1)' },
  { label: 'XAUUSD · risk-first', color: 'var(--acc-2)' },
  { label: 'Open source · GPL', color: 'var(--acc-3)' },
  { label: 'Shipping since 2014', color: 'var(--acc-4)' },
];

const stats = [
  { value: '110K+', label: 'active installs' },
  { value: '2.7M+', label: 'downloads' },
  { value: '2014', label: 'shipping since' },
  { value: 'In-house', label: 'designed & built' },
];

const principles = [
  {
    title: 'Risk-first',
    color: 'var(--acc-1)',
    body: 'Downside is designed in before upside — in code and in the markets.',
  },
  {
    title: 'Open by default',
    color: 'var(--acc-2)',
    body: 'Our source is public. Read it, fork it, trust it.',
  },
  {
    title: 'Documented',
    color: 'var(--acc-3)',
    body: 'Clear docs and changelogs. Questions reach the team that wrote it.',
  },
  {
    title: 'Built in-house',
    color: 'var(--acc-4)',
    body: 'Every project designed, built and supported under one roof.',
  },
];

const faq = [
  {
    q: 'What is Foxe Labs?',
    a:
      'Foxe Labs is a small software studio based in Kerala, India. We ship two things: open-source WordPress plugins and PHP libraries, and precision trading software for MetaTrader 5. The plugins have been maintained since 2014 and run on over 110,000 active sites.',
  },
  {
    q: 'Is Foxe Labs software open source?',
    a:
      'The WordPress plugins and PHP libraries are open source under GPL-2.0-or-later, published on WordPress.org and Packagist with the source on GitHub. Core plugins are free; some offer paid add-ons that extend them.',
  },
  {
    q: 'What trading software does Foxe Labs make?',
    a:
      'Gold Scalpel, a fully automated XAUUSD breakout scalper for MetaTrader 5, is live on the MQL5 Market with a free Strategy Tester demo. Further expert advisors and trading tools are in development and open by waitlist. Trading carries substantial risk and nothing published here is financial advice.',
  },
  {
    q: 'How do I get support?',
    a:
      'Free plugins are supported on their WordPress.org support forums, and anything else goes through the contact form or support@foxelabs.com. Messages reach the team that wrote the code — there are no support tiers to escalate through.',
  },
];

// The decorative grid behind the hero. Colours are assigned by a fixed
// arithmetic walk rather than at random, so the pattern is stable across builds.
const quad = ['var(--acc-1)', 'var(--acc-2)', 'var(--acc-3)', 'var(--acc-4)'];
const heroCells = Array.from({ length: 320 }, (_, i) => quad[(i * 7 + Math.floor(i / 13) * 3) % 4]);
---

<BaseLayout jsonLd={faqLd(faq)}>
  <Nav />
  <main id="main">
    <!-- Hero -->
    <section style="position:relative;overflow:hidden">
      <div class="cellgrid" aria-hidden="true" data-cellgrid>
        {heroCells.map((color) => <i data-color={color}></i>)}
      </div>
      <div
        class="container-x"
        style="position:relative;padding-block:var(--space-800) var(--band-pad-sm);display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--space-300);pointer-events:none"
      >
        <span class="chip chip--muted chip--solid">
          <span class="dot dot--sm" style="background:var(--acc-4)" aria-hidden="true"></span>
          Lines of code · Lines on the chart
        </span>
        <h1 data-hero-heading style="font-size:var(--text-hero);line-height:1.08;letter-spacing:-1.5px;max-width:820px">
          Engineering in the open — and in the markets.
        </h1>
        <p style="margin:0;font-size:var(--text-lead);line-height:1.5;color:var(--text-subtle);max-width:620px">
          Foxe Labs is a small software studio. Open-source tools with a decade-long track record,
          and the same engineering discipline brought to trading software.
        </p>
        <div style="display:flex;gap:12px;margin-top:8px;pointer-events:auto;flex-wrap:wrap;justify-content:center">
          <a href="/software/" class="btn btn--primary">Explore Software</a>
          <a href="/trading/" class="btn btn--ghost">Explore Trading</a>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:12px">
          {tags.map((tag) => (
            <span class="chip chip--solid">
              <span class="dot" style={`background:${tag.color}`} aria-hidden="true"></span>
              {tag.label}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section class="band--subtle band--top band--bottom">
      <div class="container-x">
        <div class="stat-row">
          {stats.map((s) => (
            <div style="padding:var(--space-350) var(--space-300);text-align:center">
              <div class="stat__value">{s.value}</div>
              <div class="stat__label">{s.label}</div>
            </div>
          ))}
        </div>
        <p style="margin:0;text-align:center;font-size:var(--text-small);color:var(--text-subtle);padding:0 var(--space-300) var(--space-250)">
          Public on WordPress.org · Packagist · GitHub — open source since 2014
        </p>
      </div>
    </section>

    <!-- Two tracks -->
    <Section id="tracks">
      <h2 style="margin-bottom:var(--space-150);font-size:var(--text-h2-lg);letter-spacing:-0.8px">
        One studio, two disciplines.
      </h2>
      <p style="margin:0 0 var(--space-500);font-size:var(--text-body);line-height:1.55;color:var(--text-subtle);max-width:640px">
        The same team, the same standards — pointed at two different problems. Open-source software
        is the proof of how we build; trading is where that discipline goes next.
      </p>
      <div class="two-col">
        {tracks.map((track) => (
          <div
            class="card card--pad"
            id={track.id}
            style={`gap:var(--space-200);border-top:4px solid ${track.color}`}
          >
            <div class="icon-tile" style={`background:color-mix(in srgb, ${track.color} 10%, transparent);color:${track.color}`}>
              <Icon name={track.icon} size={24} aria-hidden="true" />
            </div>
            <h3 style="font-size:var(--text-h3)">{track.title}</h3>
            <p style="margin:0;font-size:var(--text-md);line-height:1.55;color:var(--text-subtle)">
              {track.body}
            </p>
            <ul class="dot-list track-list" style={`--dot-hue:${track.color}`}>
              {track.links.map((link) => (
                <li>
                  <span class="dot" aria-hidden="true"></span>
                  {link}
                </li>
              ))}
            </ul>
            <div style="margin-top:auto;padding-top:var(--space-100)">
              <a
                href={track.cta.href}
                class="btn btn--sm btn--accent"
                style={`--btn-accent:${track.color}`}
              >
                {track.cta.label}
              </a>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <!-- Principles -->
    <Section variant="ink" size="sm">
      <h2 style="margin-bottom:var(--space-500);font-size:var(--text-h2);letter-spacing:-0.6px">
        How we build
      </h2>
      <PrincipleGrid items={principles} onInk />
    </Section>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <Section id="blog">
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-200);margin-bottom:var(--space-500);flex-wrap:wrap">
          <h2 style="font-size:var(--text-h2);letter-spacing:-0.6px">Latest from the studio</h2>
          <a href="/blog/" class="link-more">Read the blog →</a>
        </div>
        <div class="grid-3">
          {posts.map((post) => <PostCard post={post} height={140} />)}
        </div>
      </Section>
    )}

    <!-- FAQ -->
    <Section variant="alt" rule="top">
      <Faq items={faq} />
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-300);
  }
  .track-list { font-size: var(--text-md); }
  @media (max-width: 720px) {
    .stat-row { grid-template-columns: 1fr 1fr; }
    .two-col { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // Fixed clusters painted into the hero grid — a dense one in the top right, a
  // light counterweight in the bottom left — and hovering any cell flashes its
  // own colour before settling back to whatever it was painted. Purely
  // decorative: the grid is aria-hidden and sits behind the copy.
  (function () {
    var grid = document.querySelector('[data-cellgrid]');
    if (!grid) return;

    var B = 'var(--acc-1)';
    var P = 'var(--acc-2)';
    var Y = 'var(--acc-3)';
    var G = 'var(--acc-4)';

    // Every fill is [colour, strength]. Strength is resolved at paint time so a
    // narrow screen can run the whole arrangement lighter, where the copy sits
    // over the full width of the grid rather than clear of it.
    function fill(color, strength) {
      return [color, strength];
    }

    // Wide: five rows of five in the columns nearest the right edge, plus three
    // cells low on the left.
    var wideBlock = [
      [null, fill(Y, 35), null, fill(B, 100), null],
      [fill(P, 100), null, fill(G, 100), fill(B, 20), fill(Y, 100)],
      [null, fill(G, 35), fill(Y, 100), null, fill(P, 25)],
      [fill(B, 25), null, fill(P, 35), fill(G, 100), null],
      [null, fill(G, 100), null, fill(Y, 20), fill(B, 100)],
    ];
    var wideAccents = [
      [0, 1, fill(G, 100)],
      [0, 2, fill(B, 25)],
      [1, 1, fill(P, 20)],
    ];

    // Narrow: two rows against the right edge, sat behind the headline, plus an
    // echo on the last rows at the left. All four hues appear, and the whole
    // arrangement runs light enough for the type to stay the loudest thing.
    var narrowBlock = [
      [fill(P, 55), null, fill(Y, 70), fill(B, 100)],
      [fill(G, 100), fill(B, 45), null, fill(Y, 45)],
    ];
    var narrowAccents = [
      [0, 1, fill(G, 100)],
      [0, 2, fill(B, 45)],
      [1, 0, fill(P, 70)],
    ];

    function css(spec, scale) {
      var strength = Math.round(spec[1] * scale);
      if (strength >= 100) return spec[0];
      return 'color-mix(in srgb, ' + spec[0] + ' ' + strength + '%, transparent)';
    }

    function paint() {
      var cells = grid.children;
      if (!cells.length) return;

      // The grid auto-fills, so the column count is only knowable after layout.
      // Two rects (grid + first cell) are enough to derive it — no per-cell
      // measurement, so the paint never forces a layout per cell.
      var gridBox = grid.getBoundingClientRect();
      var first = cells[0].getBoundingClientRect();
      if (!first.height || !first.width) return;
      var cols = Math.max(1, Math.round(gridBox.width / first.width));
      var rows = Math.max(1, Math.round(gridBox.height / first.height));

      // Below the phone breakpoint — the same one that gives the grid its finer
      // cells — the wide block has nowhere to sit without crossing the copy, so
      // the compact arrangement takes over, and runs lighter with it.
      var narrow = window.matchMedia('(max-width: 640px)').matches;
      var block = narrow ? narrowBlock : wideBlock;
      var accents = narrow ? narrowAccents : wideAccents;
      var scale = narrow ? 0.7 : 1;
      var right = narrow ? 0 : 2;

      // On a phone the block is placed against the headline itself rather than
      // at a fixed row, so it stays put however the title wraps.
      var top = narrow ? 0 : 1;
      if (narrow) {
        var heading = document.querySelector('[data-hero-heading]');
        if (heading) {
          var box = heading.getBoundingClientRect();
          top = Math.max(0, Math.round((box.top - gridBox.top) / first.height) + 1);
        }
      }

      var fills = {};
      block.forEach(function (row, r) {
        row.forEach(function (spec, k) {
          if (!spec) return;
          var col = cols - right - row.length + k;
          if (col < 0 || top + r >= rows) return;
          fills[(top + r) * cols + col] = css(spec, scale);
        });
      });
      accents.forEach(function (a) {
        var row = rows - 1 - a[0];
        var col = a[1];
        if (row < 0 || col >= cols) return;
        fills[row * cols + col] = css(a[2], scale);
      });

      for (var j = 0; j < cells.length; j++) {
        var value = fills[j] || 'transparent';
        cells[j].dataset.bg = value;
        cells[j].style.backgroundColor = value;
      }
    }

    // Painting is idempotent, so it is driven from every signal that the hero
    // may have changed size — but coalesced to one paint per frame, so a burst
    // of resize/observer events costs a single pass.
    var queued = false;
    function schedulePaint() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () {
        queued = false;
        paint();
      });
    }
    schedulePaint();
    window.addEventListener('load', schedulePaint);
    if (window.ResizeObserver) {
      new ResizeObserver(schedulePaint).observe(grid);
    } else {
      window.addEventListener('resize', schedulePaint);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.addEventListener('mouseover', function (event) {
      var cell = event.target;
      if (!cell || cell.tagName !== 'I') return;
      cell.style.transition = 'background-color 0s';
      cell.style.backgroundColor = cell.dataset.color;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          cell.style.transition = 'background-color 1.4s ease-out';
          cell.style.backgroundColor = cell.dataset.bg || 'transparent';
        });
      });
    });
  })();
</script>
