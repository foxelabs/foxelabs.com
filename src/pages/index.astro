---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import Faq from '../components/ui/Faq.astro';
import { faqLd } from '../config/seo';
import { topicOf } from '../config/tracks';
import { accentVars, topicAccent } from '../config/accents';

// Activity feed = real published blog posts, newest first. No fabricated releases.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// News-card fills, straight from the mockup (tokenised in global.css).

// Proof numerals on the bold accent cuts — the bright cuts fail contrast on
// the blue band (yellow was ~1.7:1).
const proof = [
  { value: '110K+',    label: 'active installs',  color: 'var(--acc-blue-bright)' },
  { value: '2.7M+',    label: 'downloads',        color: 'var(--acc-green-bold)' },
  { value: '2014',     label: 'shipping since',   color: 'var(--acc-yellow-bold)' },
  { value: 'In-house', label: 'designed & built', color: 'var(--acc-purple-bold)' },
];

const ethos = [
  { title: 'Risk-first',      body: 'Downside is designed in before upside — in code and in the markets.', tint: 'var(--acc-blue-bright)', icon: 'mingcute:time-line' },
  { title: 'Open by default', body: 'Our source is public. Read it, fork it, trust it.',                   tint: 'var(--acc-green)',       icon: 'mingcute:code-fill' },
  { title: 'Documented',      body: 'Clear docs and changelogs. Questions reach the team that wrote it.',  tint: 'var(--acc-yellow)',      icon: 'mingcute:document-line' },
  { title: 'Built in-house',  body: 'Every project designed, built and supported under one roof.',         tint: 'var(--acc-purple)',      icon: 'mingcute:user-2-line' },
];

const faq = [
  {
    q: 'What is Foxe Labs?',
    a:
      'Foxe Labs is a small software studio based in Kerala, India. We ship two things: open-source WordPress plugins and PHP libraries, and precision trading software for MetaTrader 5. The plugins have been maintained since 2014 and run on over 110,000 active sites.',
  },
  {
    q: 'Are the WordPress plugins free?',
    a:
      'Yes. Every plugin and library on the software track is free and GPL-2.0-or-later licensed, published on WordPress.org and Packagist with the source on GitHub. Some plugins offer paid add-ons that extend them, but the core plugin is always free.',
  },
  {
    q: 'What trading software does Foxe Labs make?',
    a:
      'Gold Scalpel, a fully automated XAUUSD breakout scalper for MetaTrader 5, is live on the MQL5 Market with a free Strategy Tester demo. Further expert advisors and trading tools are in development and open by waitlist. Trading carries substantial risk and nothing published here is financial advice.',
  },
  {
    q: 'How do I get support?',
    a:
      'Free plugins are supported on their WordPress.org support forums, and anything else goes through the contact form or support@foxelabs.com. Messages reach the team that wrote the code — there are no support tiers to escalate through.',
  },
];
---
<BaseLayout jsonLd={faqLd(faq)}>
  <Nav />
  <main id="main" class="track-hub">
    <!-- Hero: white ground, copy left, flat tinted illustration cards right -->
    <section class="band overflow-hidden relative bg-[var(--b50)] lg:bg-[var(--surface)]" data-reveal style="padding-block: var(--space-section-lg);">
      <!-- Mobile-only decoration: the tinted band carries the colour, so the
           shapes bleed in behind the copy instead of stacking cards below it. -->
      <div class="lg:hidden absolute top-9 -right-6 w-22 h-22 rounded-full" style="background: var(--acc-purple);" aria-hidden="true"></div>
      <svg class="lg:hidden absolute bottom-28 -left-3" width="54" height="46" viewBox="0 0 34 28" style="transform: rotate(18deg);" aria-hidden="true">
        <polygon points="17,0 34,28 0,28" fill="var(--acc-red-bright)" />
      </svg>
      <svg class="lg:hidden absolute -bottom-7 -right-5" width="150" height="120" viewBox="0 0 150 120" aria-hidden="true">
        <path d="M 6 110 L 40 88 L 74 96 L 108 62 L 142 24" fill="none" stroke="var(--acc-yellow)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />
      </svg>
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-14 items-center">
          <div class="lg:col-span-7 relative">
            <span
              class="inline-block mb-6 text-[13px] bg-[var(--surface)] lg:bg-[var(--b50)]"
              style="color: var(--b500); font-weight: var(--fw-bold); border-radius: var(--r-sm); padding: 6px 12px;"
            >Lines of code · Lines on the chart</span>
            <h1 style="font-size: var(--text-hero);" class="mb-6">
              Engineering in the open — and <span style="color: var(--acc-blue-bright);">in the markets</span>.
            </h1>
            <p class="mb-9 max-w-[540px] leading-relaxed" style="font-size: var(--text-lead-sm); color: var(--ink-body);">
              Foxe Labs is a small software studio. Open-source tools with a
              decade-long track record, and the same engineering discipline brought
              to trading software.
            </p>
            <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4 max-w-[340px] sm:max-w-none">
              <Button href="/software/" variant="primary" size="lg" class="justify-center">Explore Software</Button>
              <Button href="/trading/" variant="ghost" size="lg" arrow class="justify-center bg-[var(--surface)] lg:bg-transparent">Explore Trading</Button>
            </div>
          </div>

          <!-- Flat illustration composition: three tinted cards + two shapes.
               Desktop only — on mobile the tinted band + shapes above replace it. -->
          <div class="hidden lg:block lg:col-span-5">
            <div class="relative mx-auto max-w-[420px] lg:h-[400px] grid gap-4 lg:block">
              <!-- Software card -->
              <div
                class="lg:absolute lg:top-0 lg:left-6 lg:w-[240px] lg:h-[170px] p-5"
                style="background: var(--b50); border-radius: var(--r-md);"
              >
                <div class="w-9 h-9 flex items-center justify-center mb-3.5" style="background: var(--acc-blue-bright); border-radius: var(--r-md);">
                  <Icon name="mingcute:code-fill" width={18} height={18} style="color: #fff;" aria-hidden="true" />
                </div>
                <div class="h-[9px] w-[80%] mb-2" style="background: var(--b100); border-radius: var(--r-sm);"></div>
                <div class="h-[9px] w-[55%]" style="background: var(--b100); border-radius: var(--r-sm);"></div>
                <p class="mt-3.5 text-[12px]" style="color: var(--b500); font-weight: var(--fw-bold);">110K+ installs</p>
              </div>

              <!-- Trading card -->
              <div
                class="lg:absolute lg:top-[104px] lg:right-0 lg:w-[240px] p-5"
                style="background: var(--acc-yellow-soft); border-radius: var(--r-md);"
              >
                <div class="w-9 h-9 flex items-center justify-center mb-3.5" style="background: var(--acc-yellow); border-radius: var(--r-md);">
                  <Icon name="mynaui:chart-line-solid" width={18} height={18} style="color: #fff;" aria-hidden="true" />
                </div>
                <svg viewBox="0 0 100 44" class="w-full h-auto" style="max-height: 64px;" preserveAspectRatio="none" role="img" aria-label="Illustrative rising trend line">
                  <path d="M 2 38 L 18 30 L 34 33 L 50 22 L 66 25 L 82 12 L 98 5" fill="none" stroke="var(--acc-yellow-bold)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                  <circle cx="98" cy="5" r="3.4" fill="var(--acc-yellow)" vector-effect="non-scaling-stroke" />
                </svg>
                <p class="mt-3 text-[12px]" style="color: var(--acc-yellow-bold); font-weight: var(--fw-bold);">XAUUSD · risk-first</p>
              </div>

              <!-- Trust card -->
              <div
                class="lg:absolute lg:bottom-0 lg:left-0 lg:w-[216px] p-[18px] flex flex-col gap-2.5"
                style="background: var(--acc-green-soft); border-radius: var(--r-md);"
              >
                {['Open source · GPL', 'Shipping since 2014', 'Built in-house'].map((line) => (
                  <div class="flex items-center gap-2.5">
                    <span class="w-5 h-5 rounded-full flex items-center justify-center shrink-0" style="background: var(--acc-green);">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 4 4 6-8" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </span>
                    <span class="text-[13px]" style="color: var(--acc-green-bold); font-weight: var(--fw-bold);">{line}</span>
                  </div>
                ))}
              </div>

              <!-- Decorative shapes -->
              <div class="hidden lg:block absolute top-[44px] right-[64px] w-11 h-11 rounded-full" style="background: var(--acc-purple);" aria-hidden="true"></div>
              <svg class="hidden lg:block absolute bottom-[10px] right-[26px]" width="34" height="28" viewBox="0 0 34 28" style="transform: rotate(18deg);" aria-hidden="true">
                <polygon points="17,0 34,28 0,28" fill="var(--acc-red-bright)" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip: flat blue tint band -->
    <section class="band band--sky" data-reveal style="padding-block: var(--space-section-sm);">
      <div class="container-x">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          {proof.map((s) => (
            <div>
              <p class="font-display" style={`font-size: clamp(2rem, 1.4rem + 1.9vw, 2.75rem); font-weight: var(--fw-display); letter-spacing: -0.03em; color: ${s.color}; line-height: 1;`}>{s.value}</p>
              <p class="text-[14px] mt-2.5" style="color: var(--ink-body); font-weight: var(--fw-medium);">{s.label}</p>
            </div>
          ))}
        </div>
        <p class="mt-9 text-center text-[13px]" style="color: var(--ink-body);">
          Public on WordPress.org · Packagist · GitHub — open source since 2014
        </p>
      </div>
    </section>

    <!-- Two tracks: flat tinted cards, centred intro -->
    <Section variant="light">
      <div class="text-center max-w-[680px] mx-auto mb-13">
        <h2 class="mb-4">One studio, two disciplines.</h2>
        <p style="font-size: var(--text-lead-sm); color: var(--ink-body);">
          The same team, the same standards — pointed at two different problems.
          Open-source software is the proof of how we build; trading is where that
          discipline goes next.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-7">
        <!-- Software -->
        <div class="p-9 flex flex-col gap-4" style="background: var(--b50); border-radius: var(--r-md);">
          <div class="w-12 h-12 flex items-center justify-center" style="background: var(--acc-blue-bright); border-radius: 10px;">
            <Icon name="mingcute:code-fill" width={24} height={24} style="color: #fff;" aria-hidden="true" />
          </div>
          <h3>Software</h3>
          <p class="m-0" style="font-size: var(--text-body); color: var(--ink-body);">
            WordPress plugins and PHP libraries — open source and GPL-licensed, documented,
            and shipped for years. Paid Pro add-ons and new apps join the same shelf.
          </p>
          <ul class="list-none m-0 p-0 flex flex-col gap-2.5" style="font-size: var(--text-ui); color: var(--ink); font-weight: var(--fw-medium);">
            {[
              ['/software/plugins/404-to-301/', '404 to 301 — 100,000+ installs'],
              ['/software/plugins/loggedin/', 'Loggedin — session control'],
              ['/software/libraries/', 'PHP libraries on Packagist'],
            ].map(([href, label]) => (
              <li class="flex items-center gap-2">
                <span class="w-[7px] h-[7px] rounded-full shrink-0" style="background: var(--acc-blue-bright);"></span>
                <a href={href} class="transition-colors hover:text-[var(--b500)]">{label}</a>
              </li>
            ))}
          </ul>
          <Button href="/software/" variant="primary" class="mt-auto self-start">Explore software</Button>
        </div>

        <!-- Trading -->
        <div class="p-9 flex flex-col gap-4" style="background: var(--acc-yellow-soft); border-radius: var(--r-md);">
          <div class="w-12 h-12 flex items-center justify-center" style="background: var(--acc-yellow); border-radius: 10px;">
            <Icon name="mynaui:chart-line-solid" width={24} height={24} style="color: #fff;" aria-hidden="true" />
          </div>
          <h3>Trading</h3>
          <p class="m-0" style="font-size: var(--text-body); color: var(--ink-body);">
            Expert advisors, a universal trading journal, and precision utilities for
            prop firm and serious retail traders. Engineered risk-first.
          </p>
          <ul class="list-none m-0 p-0 flex flex-col gap-2.5" style="font-size: var(--text-ui); color: var(--ink); font-weight: var(--fw-medium);">
            {[
              ['/trading/expert-advisors/gold-scalpel/', 'Gold Scalpel — MT5 expert advisor'],
              ['/trading/tools/tickerlog/', 'TickerLog — universal journal'],
              ['/trading/tools/', 'Session tools — MT5 indicators'],
            ].map(([href, label]) => (
              <li class="flex items-center gap-2">
                <span class="w-[7px] h-[7px] rounded-full shrink-0" style="background: var(--acc-yellow);"></span>
                <a href={href} class="transition-colors hover:text-[var(--acc-yellow-bold)]">{label}</a>
              </li>
            ))}
          </ul>
          <!-- Mockup pairs the yellow field with an ink button, not a blue one. -->
          <a href="/trading/" class="btn btn--ink mt-auto self-start">Explore trading</a>
        </div>
      </div>
    </Section>

    <!-- Ethos: coloured icon squares on the sunken band -->
    <Section variant="alt">
      <h2 class="mb-11">How we build</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {ethos.map((e) => (
          <div>
            <div class="w-10 h-10 flex items-center justify-center mb-4" style={`background: ${e.tint}; border-radius: var(--r-md);`}>
              <Icon name={e.icon} width={20} height={20} style="color: #fff;" aria-hidden="true" />
            </div>
            <h3 class="mb-2" style="font-size: var(--text-h5); line-height: 1.3; font-weight: var(--fw-subhead); letter-spacing: -0.008em;">{e.title}</h3>
            <p style="font-size: var(--text-ui); color: var(--ink-body);">{e.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Blog feed: white cards, the coloured cover art carries the topic hue -->
    {posts.length > 0 && (
      <Section variant="light">
        <div class="flex items-end justify-between gap-6 mb-10">
          <h2>Latest from the studio</h2>
          <Button href="/blog/" variant="ghost" arrow class="hidden sm:inline-flex shrink-0">Read the blog</Button>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.id}/`}
              class="card card--hover home-post flex flex-col group overflow-hidden"
              style={accentVars(topicAccent(topicOf(post.data.track)))}
            >
              {post.data.heroImage && (
                <Image
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt ?? ''}
                  widths={[400, 640, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 384px"
                  loading="lazy"
                  class="w-full h-[220px] object-cover block"
                />
              )}
              <div class="flex flex-col flex-1 gap-3 p-6">
                <span
                  class="self-start text-[13px]"
                  style="color: var(--accent-ink); font-weight: var(--fw-bold);"
                >{topicOf(post.data.track)}</span>
                <h3 class="home-post__title flex-1" style="font-size: var(--text-h4); line-height: 1.24; font-weight: var(--fw-heading); letter-spacing: -0.014em;">{post.data.title}</h3>
                <span class="inline-flex items-center gap-[7px] text-[15px]">
                  Read more
                  <span class="transition-transform group-hover:translate-x-0.5">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 sm:hidden">
          <Button href="/blog/" variant="ghost" arrow>Read the blog</Button>
        </div>
      </Section>
    )}

    <!-- Maker band: navy, flat, white button on the right -->
    <section class="band band--invert" data-reveal style="padding-block: var(--space-section);">
      <div class="container-x flex flex-col md:flex-row md:items-center md:justify-between gap-8 md:gap-12">
        <div class="max-w-[660px]">
          <h2 class="mb-3.5" style="font-size: var(--text-h2);">A small studio, by design.</h2>
          <p style="font-size: var(--text-lead-sm); color: var(--ink-invert-dim);">
            Every project — plugin, library or EA — is designed, built and supported
            in-house. The open-source work is the proof of how we build; the trading
            track is where that discipline goes next.
          </p>
        </div>
        <a href="/about/" class="btn btn--white shrink-0 self-start">About Foxe Labs</a>
      </div>
    </section>

    <!-- FAQ -->
    <Section variant="light">
      <div class="max-w-[800px] mx-auto">
        <Faq items={faq} bare />
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Each card carries its topic's --accent-*, so the label and the hovered
     title share the hue with the blog index cards. */
  .home-post__title { transition: color 0.1s ease; }
  .home-post:hover .home-post__title { color: var(--accent-ink); }
</style>
