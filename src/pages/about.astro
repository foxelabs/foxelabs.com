---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { breadcrumbLd, personLd } from '../config/seo';

const tracks = [
  {
    label: 'Software',
    color: 'var(--acc-1)',
    body:
      'Open-source WordPress plugins and PHP libraries — documented, maintained, and shipped release after release for years.',
    href: '/software/',
    cta: 'Explore software →',
  },
  {
    label: 'Trading',
    color: 'var(--acc-2)',
    body:
      'Expert advisors, a universal journal, and precision utilities — engineered risk-first and traded on my own accounts.',
    href: '/trading/',
    cta: 'Explore trading →',
  },
];

const founderLinks = [
  { href: 'https://x.com/Joel_James', label: 'X' },
  { href: 'https://github.com/joel-james', label: 'GitHub' },
  { href: 'https://instagram.com/joeltalks', label: 'Instagram' },
];

const principles = [
  {
    title: 'Open by default',
    color: 'var(--acc-1)',
    body:
      'The software track is open source. Read it, fork it, trust it — the source is right there, not behind a promise.',
  },
  {
    title: 'Risk before returns',
    color: 'var(--acc-2)',
    body:
      'Every trading tool ships with hard risk controls first. A strategy that can blow an account is a countdown, not a strategy.',
  },
  {
    title: 'A real lab',
    color: 'var(--acc-3)',
    body:
      'Everything is developed, tested, and released here — small, sharp tools that do one thing well, not bloated platforms.',
  },
  {
    title: 'I use it myself',
    color: 'var(--acc-4)',
    body:
      'I trade with these tools on my own capital. Nothing ships that I would not put in front of my own account.',
  },
];
---
<BaseLayout
  title="About Foxe Labs — Software Studio by Joel James"
  description="Foxe Labs is a small software studio — open-source tools and trading software, built and used in-house."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
    personLd({
      name: 'Joel James',
      url: '/about',
      image: '/joel.jpg',
      sameAs: [
        'https://x.com/Joel_James',
        'https://github.com/joel-james',
        'https://instagram.com/joeltalks',
      ],
    }),
  ]}
>
  <Nav />
  <main id="main">
    <!-- Story + the person -->
    <section class="band band--sm band--bottom">
      <div class="container-x about-top">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start">
          <Eyebrow chip color="var(--acc-2)">About</Eyebrow>
          <h1 style="font-size:var(--text-title);line-height:1.06;letter-spacing:-1.3px">
            A small studio, two crafts.
          </h1>
          <p style="margin:0;font-size:1.0625rem;line-height:1.6">
            Foxe Labs is the studio of <strong>Joel James</strong>, a software engineer from Kerala,
            India. It is a workshop of one — every project here is designed, built, and supported by
            the same pair of hands.
          </p>
          <p style="margin:0;font-size:var(--text-body);line-height:1.6;color:var(--text-subtle)">
            The name says it plainly: Foxe Labs is a lab. It is where I develop, test, and release
            the things I care about — open-source software with a long track record, and,
            increasingly, the trading tools I reach for every day.
          </p>
          <p style="margin:0;font-size:var(--text-body);line-height:1.6;color:var(--text-subtle)">
            For years the work was open source: WordPress plugins and PHP libraries, documented and
            maintained release after release. Now I split my focus evenly between that craft and a
            second one — trading — engineered with the same discipline the software taught me.
          </p>
          <p style="margin:0;font-size:var(--text-body);line-height:1.6;color:var(--text-subtle)">
            The reason you can trust the trading side is simple: I am a trader. I build these tools
            because I need them, and I run them on my own accounts before anyone else sees them. If
            it is not good enough for my capital, it does not ship.
          </p>
        </div>

        <div class="card" style="align-self:start">
          <span class="accent-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <img
            src="/joel.jpg"
            alt="Joel James, founder of Foxe Labs"
            width="420"
            height="280"
            style="display:block;width:100%;height:280px;object-fit:cover"
          />
          <div style="padding:22px 24px;display:flex;flex-direction:column;gap:6px">
            <h2 style="font-size:1.25rem">Joel James</h2>
            <span style="font-size:var(--text-ui);color:var(--text-subtle)">Founder · Engineer · Trader</span>
            <span style="font-size:var(--text-small);color:var(--text-subtle)">Kerala, India</span>
            <div style="display:flex;gap:14px;margin-top:10px">
              {founderLinks.map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size:var(--text-small);font-weight:var(--fw-medium)"
                >
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Two tracks -->
    <Section>
      <h2 style="margin-bottom:10px;font-size:var(--text-h2);letter-spacing:-0.6px">
        One studio, two tracks
      </h2>
      <p style="margin:0 0 var(--space-500);font-size:var(--text-body);color:var(--text-subtle)">
        The same standards, pointed at two different problems.
      </p>
      <div class="about-tracks">
        {tracks.map((track) => (
          <a
            href={track.href}
            class="card card--pad"
            style={`gap:12px;padding:30px;border-top:4px solid ${track.color}`}
          >
            <span class="kicker">{track.label}</span>
            <p style="margin:0;font-size:0.96875rem;line-height:1.6;color:var(--text)">{track.body}</p>
            <span class="link-more" style="margin-top:auto">{track.cta}</span>
          </a>
        ))}
      </div>
    </Section>

    <!-- Principles -->
    <Section variant="ink" size="sm">
      <h2 style="margin-bottom:var(--space-500);font-size:var(--text-h2);letter-spacing:-0.6px">
        How I build
      </h2>
      <div class="about-principles">
        {principles.map((p) => (
          <div style="display:flex;flex-direction:column;gap:10px">
            <span class="dot dot--lg" style={`background:${p.color}`} aria-hidden="true"></span>
            <h3 style="font-size:1.0625rem;font-weight:var(--fw-heading)">{p.title}</h3>
            <p style="margin:0;font-size:var(--text-ui);line-height:1.55;color:var(--ink-band-subtle)">
              {p.body}
            </p>
          </div>
        ))}
      </div>
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .about-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-800);
  }
  .about-tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-300);
  }
  .about-principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-400);
  }
  @media (max-width: 960px) {
    .about-top { grid-template-columns: 1fr; gap: var(--space-500); }
    .about-principles { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .about-tracks { grid-template-columns: 1fr; }
  }
</style>
