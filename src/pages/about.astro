---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { breadcrumbLd, personLd } from '../config/seo';
import joelImg from '../assets/joel.jpg';

// Two doors — same card language as the home page.
const tracks = [
  {
    title: 'Software',
    hue: 'var(--hue-emerald)',
    icon: 'mingcute:code-line',
    label: 'Open source · GPL',
    body:
      'Open-source WordPress plugins and PHP libraries — documented, maintained, and shipped release after release for years.',
    trail: 'Explore the software',
    href: '/software/',
  },
  {
    title: 'Trading',
    hue: 'var(--hue-amber)',
    icon: 'mingcute:chart-line-line',
    label: 'Risk-first',
    body:
      'Expert advisors, a universal journal, and precision utilities — engineered risk-first and traded on my own accounts.',
    trail: 'Explore the trading tools',
    href: '/trading/',
  },
];

const founderLinks = [
  { href: 'https://x.com/Joel_James', label: 'X', icon: 'mingcute:social-x-line' },
  { href: 'https://github.com/joel-james', label: 'GitHub', icon: 'mingcute:github-line' },
  { href: 'https://instagram.com/joeltalks', label: 'Instagram', icon: 'mingcute:instagram-line' },
];

const principles = [
  {
    n: '01',
    hue: 'var(--hue-blue)',
    icon: 'mingcute:code-line',
    title: 'Open by default',
    body:
      'The software track is open source. Read it, fork it, trust it — the source is right there, not behind a promise.',
  },
  {
    n: '02',
    hue: 'var(--hue-amber)',
    icon: 'mingcute:shield-line',
    title: 'Risk before returns',
    body:
      'Every trading tool ships with hard risk controls first. A strategy that can blow an account is a countdown, not a strategy.',
  },
  {
    n: '03',
    hue: 'var(--hue-emerald)',
    icon: 'mingcute:flask-line',
    title: 'A real lab',
    body:
      'Everything is developed, tested, and released here — small, sharp tools that do one thing well, not bloated platforms.',
  },
  {
    n: '04',
    hue: 'var(--hue-purple)',
    icon: 'mingcute:user-heart-line',
    title: 'I use it myself',
    body:
      'I trade with these tools on my own capital. Nothing ships that I would not put in front of my own account.',
  },
];
---
<BaseLayout
  title="About Foxe Labs — Software Studio by Joel James"
  description="Foxe Labs is a small software studio — open-source tools and trading software, built and used in-house."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
    personLd({
      name: 'Joel James',
      url: '/about',
      image: joelImg.src,
      sameAs: [
        'https://x.com/Joel_James',
        'https://github.com/joel-james',
        'https://instagram.com/joeltalks',
      ],
    }),
  ]}
>
  <Nav />
  <main id="main">
    <!-- Story + the person -->
    <section class="about-hero">
      <div class="cellgrid" aria-hidden="true"></div>
      <div class="container-x about-top">
        <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start">
          <span class="chip chip--muted chip--solid" style="align-self:flex-start">
            <span class="sync-dot" aria-hidden="true"></span>
            About the studio
          </span>
          <h1 style="font-size:var(--text-hero);line-height:1.05">
            A small studio, two crafts.
          </h1>
          <p style="margin:0;font-size:var(--text-lead);line-height:1.55;color:var(--text-subtle)">
            Foxe Labs is the studio of <strong>Joel James</strong>, a software engineer from Kerala,
            India. It is a workshop of one — every project here is designed, built, and supported by
            the same pair of hands.
          </p>
          <p style="margin:0;font-size:var(--text-body);line-height:1.6;color:var(--text-subtle)">
            The name says it plainly: Foxe Labs is a lab. It is where I develop, test, and release
            the things I care about — open-source software with a long track record, and,
            increasingly, the trading tools I reach for every day.
          </p>
          <p style="margin:0;font-size:var(--text-body);line-height:1.6;color:var(--text-subtle)">
            For years the work was open source: WordPress plugins and PHP libraries, documented and
            maintained release after release. Now I split my focus evenly between that craft and a
            second one — trading — engineered with the same discipline the software taught me.
          </p>
          <p style="margin:0;font-size:var(--text-body);line-height:1.6;color:var(--text-subtle)">
            The reason you can trust the trading side is simple: I am a trader. I build these tools
            because I need them, and I run them on my own accounts before anyone else sees them. If
            it is not good enough for my capital, it does not ship.
          </p>
        </div>

        <div class="card" style="align-self:start">
          <Image
            src={joelImg}
            alt="Joel James, founder of Foxe Labs"
            widths={[480, 800]}
            sizes="(max-width: 960px) 100vw, 420px"
            loading="lazy"
            decoding="async"
            style="display:block;width:100%;height:auto;aspect-ratio:1/1;border-bottom:1px solid var(--border)"
          />
          <div style="padding:var(--space-300) var(--space-300);display:flex;flex-direction:column;gap:6px">
            <h2 style="font-size:1.25rem">Joel James</h2>
            <span class="mono" style="font-size:var(--text-xs);color:var(--text-faint)">founder · engineer · trader — Kerala, India</span>
            <div style="display:flex;gap:var(--space-100);margin-top:var(--space-125)">
              {founderLinks.map((l) => (
                <a
                  href={l.href}
                  class="social-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Joel James on ${l.label}`}
                >
                  <Icon name={l.icon} width={16} height={16} aria-hidden="true" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Two tracks -->
    <Section variant="alt" rule="top">
      <span class="eyebrow">Two tracks</span>
      <h2 style="margin:14px 0 var(--space-500);font-size:var(--text-h2-lg)">
        One studio, pointed at two problems
      </h2>
      <div class="grid-2">
        {tracks.map((track) => (
          <div class="card card--pad card--hover" style="gap:var(--space-200)">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-200)">
              <span class="icon-tile tint" style={`--hue:${track.hue}`}>
                <Icon name={track.icon} size={20} aria-hidden="true" />
              </span>
              <span class="kicker" style={`color:${track.hue}`}>{track.label}</span>
            </div>
            <h3 style="font-size:var(--text-h3)">{track.title}</h3>
            <p style="margin:0;font-size:var(--text-md);line-height:1.55;flex:1">{track.body}</p>
            <a href={track.href} class="link-more">{track.trail} →</a>
          </div>
        ))}
      </div>
    </Section>

    <!-- Principles -->
    <Section rule="top">
      <span class="eyebrow">How I build</span>
      <h2 style="margin:14px 0 var(--space-500);font-size:var(--text-h2-lg)">
        Four rules, no exceptions
      </h2>
      <div class="grid-2">
        {principles.map((p) => (
          <div class="card card--pad" style="gap:var(--space-150)">
            <div style="display:flex;align-items:center;justify-content:space-between">
              <span class="step-chip tint" style={`--hue:${p.hue}`}>{p.n}</span>
              <Icon name={p.icon} size={20} style={`color:${p.hue}`} aria-hidden="true" />
            </div>
            <h3 style="font-size:1.25rem">{p.title}</h3>
            <p style="margin:0;font-size:var(--text-md);line-height:1.55">{p.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
  }
  .about-top {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-800);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  @media (max-width: 960px) {
    .about-top { grid-template-columns: 1fr; gap: var(--space-500); }
  }
</style>
