---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbLd, personLd } from '../config/seo';

const tracks = [
  {
    icon: 'mingcute:code-fill',
    label: 'Software',
    tone: { ink: 'var(--b500)', soft: 'var(--b50)', deep: 'var(--b700)' },
    body: 'Open-source WordPress plugins and PHP libraries — documented, maintained, and shipped release after release for years.',
    href: '/software',
  },
  {
    icon: 'mynaui:chart-candlestick-solid',
    label: 'Trading',
    tone: { ink: 'var(--acc-green-bold)', soft: 'var(--acc-green-soft)', deep: 'var(--acc-green-bold)' },
    body: 'Expert advisors, a universal journal, and precision utilities — engineered risk-first and traded on my own accounts.',
    href: '/trading',
  },
];

const founderLinks = [
  { href: 'https://x.com/Joel_James', label: 'Joel James on X', icon: 'mingcute:social-x-line', brand: '#1DA1F2' },
  { href: 'https://instagram.com/joeltalks', label: 'Joel James on Instagram', icon: 'mingcute:instagram-line', brand: '#E1306C' },
  { href: 'https://github.com/joel-james', label: 'Joel James on GitHub', icon: 'mingcute:github-line', brand: '#8250DF' },
];

const values = [
  {
    icon: 'mingcute:git-branch-line',
    tone: { ink: 'var(--b500)', soft: 'var(--b50)' },
    title: 'Open by default',
    body: 'The software track is open source. Read it, fork it, trust it — the source is right there, not behind a promise.',
  },
  {
    icon: 'mingcute:shield-line',
    tone: { ink: 'var(--acc-green-bold)', soft: 'var(--acc-green-soft)' },
    title: 'Risk before returns',
    body: 'Every trading tool ships with hard risk controls first. A strategy that can blow an account is a countdown, not a strategy.',
  },
  {
    icon: 'mingcute:flask-line',
    tone: { ink: 'var(--acc-purple-bold)', soft: 'var(--acc-purple-soft)' },
    title: 'A real lab',
    body: 'Everything is developed, tested, and released here — small, sharp tools that do one thing well, not bloated platforms.',
  },
  {
    icon: 'mingcute:check-circle-fill',
    tone: { ink: 'var(--acc-orange-bold)', soft: 'var(--acc-orange-soft)' },
    title: 'I use it myself',
    body: 'I trade with these tools on my own capital. Nothing ships that I would not put in front of my own account.',
  },
];
---
<BaseLayout
  title="About Foxe Labs — Software Studio by Joel James"
  description="Foxe Labs is a small software studio — open-source tools and trading software, built and used in-house."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
    personLd({
      name: 'Joel James',
      url: '/about',
      image: '/joel.jpg',
      sameAs: [
        'https://x.com/Joel_James',
        'https://github.com/joel-james',
        'https://instagram.com/joeltalks',
      ],
    }),
  ]}
>
  <Nav />
  <main id="main" class="track-hub">
    <PageHeader
      eyebrow="About"
      title="A small studio, "
      titleAccent="two crafts."
    />

    <!-- Story + founder card -->
    <Section variant="light">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-5 leading-relaxed" style="font-size: var(--text-lead-sm); color: var(--ink-body);">
          <p>
            Foxe Labs is the studio of <strong style="color: var(--ink);">Joel James</strong>,
            a software engineer from Kerala, India. It is a workshop of one — every
            project here is designed, built, and supported by the same pair of hands.
          </p>
          <p>
            The name says it plainly: Foxe Labs is a lab. It is where I develop, test,
            and release the things I care about — open-source software with a long track
            record, and, increasingly, the trading tools I reach for every day.
          </p>
          <p>
            For years the work was open source: WordPress plugins and PHP libraries,
            documented and maintained release after release. Now I split my focus evenly
            between that craft and a second one — trading — engineered with the same
            discipline the software taught me.
          </p>
          <p>
            The reason you can trust the trading side is simple: I am a trader. I build
            these tools because I need them, and I run them on my own accounts before
            anyone else sees them. If it is not good enough for my capital, it does not
            ship.
          </p>
        </div>

        <!-- Founder card -->
        <div class="lg:col-span-5">
          <div class="card overflow-hidden lg:max-w-[248px] lg:ml-auto" style="padding: 0;">
            <div class="relative aspect-square">
              <div class="absolute inset-0 flex items-center justify-center" style="background: linear-gradient(135deg, var(--surface) 0%, var(--surface-alt) 100%);">
                <Icon name="mingcute:user-4-fill" width={48} height={48} style="color: var(--ink-dim);" aria-hidden="true" />
              </div>
              <img
                src="/joel.jpg"
                alt="Joel James, founder of Foxe Labs"
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover"
                onerror="this.style.display='none'"
              />
            </div>
            <div class="p-5">
              <h2 style="font-size: var(--text-h4); font-weight: var(--fw-heading);" class="mb-0.5">Joel James</h2>
              <p class="mb-4" style="font-size: var(--text-small); color: var(--ink-dim); font-weight: var(--fw-medium);">
                Founder · Engineer · Trader
              </p>
              <div class="flex items-center gap-2 mb-5" style="font-size: var(--text-ui); color: var(--ink-body);">
                <Icon name="mingcute:location-line" width={16} height={16} style="color: var(--accent-ink);" aria-hidden="true" />
                Kerala, India
              </div>
              <ul class="list-none m-0 p-0 flex items-center gap-2">
                {founderLinks.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={l.label}
                      class="founder-link flex items-center justify-center w-8 h-8"
                      style={`--brand: ${l.brand};`}
                    >
                      <Icon name={l.icon} width={15} height={15} aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Two tracks -->
    <Section variant="alt">
      <h2 style="font-size: var(--text-h3); font-weight: var(--fw-heading);" class="mb-2">One studio, two tracks</h2>
      <p class="mb-8 max-w-xl" style="font-size: var(--text-body); color: var(--ink-body);">
        The same standards, pointed at two different problems.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {tracks.map((t) => (
          <a href={t.href} class="card card--hover p-7 flex flex-col group" style={`border-color: ${t.tone.soft};`}>
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-[8px] flex items-center justify-center" style={`background: ${t.tone.soft};`}>
                <Icon name={t.icon} width={24} height={24} style={`color: ${t.tone.ink};`} aria-hidden="true" />
              </div>
              <span class="lozenge" style={`background: ${t.tone.soft}; color: ${t.tone.deep};`}>{t.label.toUpperCase()}</span>
            </div>
            <h3 style="font-size: var(--text-h4); font-weight: var(--fw-heading);" class="mb-2">{t.label}</h3>
            <p class="mb-5" style="font-size: var(--text-ui); color: var(--ink-body);">{t.body}</p>
            <span class="inline-flex items-center gap-1.5 mt-auto" style={`font-size: var(--text-ui); font-weight: var(--fw-medium); color: ${t.tone.ink};`}>
              Explore {t.label.toLowerCase()}
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        ))}
      </div>
    </Section>

    <!-- Values -->
    <Section variant="light">
      <h2 style="font-size: var(--text-h3); font-weight: var(--fw-heading);" class="mb-8">How I build</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {values.map((v) => (
          <div class="card p-6 flex gap-4">
            <div class="w-10 h-10 shrink-0 flex items-center justify-center" style={`background: ${v.tone.soft}; border-radius: var(--r-sm);`}>
              <Icon name={v.icon} width={20} height={20} style={`color: ${v.tone.ink};`} aria-hidden="true" />
            </div>
            <div>
              <h3 style="font-size: var(--text-h5); font-weight: var(--fw-heading);" class="mb-1.5">{v.title}</h3>
              <p style="font-size: var(--text-ui); color: var(--ink-body);">{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Compact social buttons — each lights up in its own network colour. */
  .founder-link {
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    color: var(--ink-dim);
    transition: color 180ms ease, border-color 180ms ease;
  }
  .founder-link:hover {
    color: var(--brand);
    border-color: var(--brand);
  }
</style>
