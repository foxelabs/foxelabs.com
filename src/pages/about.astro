---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbLd, personLd } from '../config/seo';

const tracks = [
  {
    icon: 'mingcute:code-fill',
    label: 'Software',
    tone: { ink: 'var(--oss-ink)', soft: 'var(--oss-soft)', deep: 'var(--oss-deep)' },
    body: 'Open-source WordPress plugins and PHP libraries — documented, maintained, and shipped release after release for years.',
    href: '/software',
  },
  {
    icon: 'mynaui:chart-candlestick-solid',
    label: 'Trading',
    tone: { ink: 'var(--gold-ink)', soft: 'var(--gold-soft)', deep: 'var(--gold-deep)' },
    body: 'Expert advisors, a universal journal, and precision utilities — engineered risk-first and traded on my own accounts.',
    href: '/trading',
  },
];

const values = [
  {
    icon: 'mingcute:git-branch-line',
    title: 'Open by default',
    body: 'The software track is open source. Read it, fork it, trust it — the source is right there, not behind a promise.',
  },
  {
    icon: 'mingcute:shield-line',
    title: 'Risk before returns',
    body: 'Every trading tool ships with hard risk controls first. A strategy that can blow an account is a countdown, not a strategy.',
  },
  {
    icon: 'mingcute:flask-line',
    title: 'A real lab',
    body: 'Everything is developed, tested, and released here — small, sharp tools that do one thing well, not bloated platforms.',
  },
  {
    icon: 'mingcute:check-circle-fill',
    title: 'I use it myself',
    body: 'I trade with these tools on my own capital. Nothing ships that I would not put in front of my own account.',
  },
];
---
<BaseLayout
  title="About Foxe Labs — Software Studio by Joel James"
  description="Foxe Labs is a one-person software studio by Joel James — open-source tools and trading software, built and used in-house."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
    personLd({
      name: 'Joel James',
      url: '/about',
      image: '/joel.jpg',
      sameAs: [
        'https://x.com/Joel_James',
        'https://github.com/joel-james',
        'https://instagram.com/joeltalks',
      ],
    }),
  ]}
>
  <Nav />
  <main class="track-hub">
    <PageHeader
      eyebrow="About"
      title="A one-person studio, "
      titleAccent="two crafts."
    />

    <!-- Story + founder card -->
    <Section variant="light">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-5" style="font-size: var(--text-lead); color: var(--ink-body);">
          <p>
            Foxe Labs is the studio of <strong style="color: var(--ink);">Joel James</strong>,
            a software engineer from Kerala, India. It is a workshop of one — every
            project here is designed, built, and supported by the same pair of hands.
          </p>
          <p>
            The name says it plainly: Foxe Labs is a lab. It is where I develop, test,
            and release the things I care about — open-source software with a long track
            record, and, increasingly, the trading tools I reach for every day.
          </p>
          <p>
            For years the work was open source: WordPress plugins and PHP libraries,
            documented and maintained release after release. Now I split my focus evenly
            between that craft and a second one — trading — engineered with the same
            discipline the software taught me.
          </p>
          <p>
            The reason you can trust the trading side is simple: I am a trader. I build
            these tools because I need them, and I run them on my own accounts before
            anyone else sees them. If it is not good enough for my capital, it does not
            ship.
          </p>
        </div>

        <!-- Founder card -->
        <div class="lg:col-span-5">
          <div class="card overflow-hidden" style="padding: 0;">
            <div class="relative" style="aspect-ratio: 1 / 1;">
              <div class="absolute inset-0 flex items-center justify-center" style="background: linear-gradient(135deg, var(--surface) 0%, var(--surface-alt) 100%);">
                <Icon name="mingcute:user-4-fill" width={48} height={48} style="color: var(--ink-dim);" aria-hidden="true" />
              </div>
              <img
                src="/joel.jpg"
                alt="Joel James, founder of Foxe Labs"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover"
                onerror="this.style.display='none'"
              />
            </div>
            <div class="p-6">
              <h2 style="font-size: 1.25rem; font-weight: 800;" class="mb-0.5">Joel James</h2>
              <p class="font-mono text-[12px] mb-4" style="color: var(--ink-dim); letter-spacing: 0.04em;">
                Founder · Engineer · Trader
              </p>
              <div class="flex items-center gap-2 mb-5 text-[14px]" style="color: var(--ink-body);">
                <Icon name="mingcute:location-line" width={16} height={16} style="color: var(--accent-ink);" aria-hidden="true" />
                Kerala, India
              </div>
              <div class="flex flex-wrap gap-2">
                <a href="https://x.com/Joel_James" class="inline-flex items-center gap-1.5 font-mono text-[12px] px-3 py-1.5 rounded-full transition-colors" style="background: var(--surface-alt); color: var(--ink-body);" target="_blank" rel="noopener noreferrer" aria-label="Joel James on X">
                  <Icon name="mingcute:social-x-line" width={14} height={14} aria-hidden="true" /> @Joel_James
                </a>
                <a href="https://instagram.com/joeltalks" class="inline-flex items-center gap-1.5 font-mono text-[12px] px-3 py-1.5 rounded-full transition-colors" style="background: var(--surface-alt); color: var(--ink-body);" target="_blank" rel="noopener noreferrer" aria-label="Joel James on Instagram">
                  <Icon name="mingcute:instagram-line" width={14} height={14} aria-hidden="true" /> @joeltalks
                </a>
                <a href="https://github.com/joel-james" class="inline-flex items-center gap-1.5 font-mono text-[12px] px-3 py-1.5 rounded-full transition-colors" style="background: var(--surface-alt); color: var(--ink-body);" target="_blank" rel="noopener noreferrer" aria-label="Joel James on GitHub">
                  <Icon name="mingcute:github-line" width={14} height={14} aria-hidden="true" /> joel-james
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Two tracks -->
    <Section variant="sunken">
      <h2 style="font-size: var(--text-h3); font-weight: 800;" class="mb-2">One studio, two tracks</h2>
      <p class="mb-8 max-w-xl text-[15px]" style="color: var(--ink-body);">
        The same standards, pointed at two different problems.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {tracks.map((t) => (
          <a href={t.href} class="card card--hover p-7 flex flex-col group" style={`border-color: ${t.tone.soft};`}>
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center" style={`background: ${t.tone.soft};`}>
                <Icon name={t.icon} width={24} height={24} style={`color: ${t.tone.ink};`} aria-hidden="true" />
              </div>
              <span class="font-mono text-[10px] px-2.5 py-1.5 rounded-full" style={`background: ${t.tone.soft}; color: ${t.tone.deep}; letter-spacing: 0.08em;`}>{t.label.toUpperCase()}</span>
            </div>
            <h3 style="font-size: 1.125rem; font-weight: 800;" class="mb-2">{t.label}</h3>
            <p class="text-[14px] mb-5" style="color: var(--ink-body);">{t.body}</p>
            <span class="inline-flex items-center gap-1.5 mt-auto font-mono text-[12px] font-medium" style={`color: ${t.tone.ink};`}>
              Explore {t.label.toLowerCase()}
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        ))}
      </div>
    </Section>

    <!-- Values -->
    <Section variant="light">
      <h2 style="font-size: var(--text-h3); font-weight: 800;" class="mb-8">How I build</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {values.map((v) => (
          <div class="card p-6 flex gap-4">
            <div class="w-10 h-10 rounded-lg shrink-0 flex items-center justify-center" style="background: var(--accent-soft);">
              <Icon name={v.icon} width={20} height={20} style="color: var(--accent-ink);" aria-hidden="true" />
            </div>
            <div>
              <h3 style="font-size: 1.0625rem; font-weight: 800;" class="mb-1.5">{v.title}</h3>
              <p class="text-[14px]" style="color: var(--ink-body);">{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>
