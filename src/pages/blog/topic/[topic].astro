---
// Topic archive — one page per blog topic, the equivalent of a WordPress
// category page. Topics come from a post's `track`, so the set is fixed and
// every page here has hand-written copy of its own.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostGrid from '../../../components/PostGrid.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { breadcrumbLd, collectionPageLd } from '../../../config/seo';
import CtaBanner from '../../../components/CtaBanner.astro';
import { topicAccent } from '../../../config/accents';
import { TOPICS, TOPIC_META, postTopic, topicPath, tagIndex, tagPath } from '../../../config/blog';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
  // Only topics that actually have posts — an empty archive is a thin page.
  return TOPICS.filter((topic) => posts.some((p) => postTopic(p) === topic)).map((topic) => ({
    params: { topic: TOPIC_META[topic].slug },
    props: { topic, posts: posts.filter((p) => postTopic(p) === topic) },
  }));
}

const { topic, posts } = Astro.props;
const meta = TOPIC_META[topic];
const path = topicPath(topic);

// Tags used by posts in this topic — the cross-link between the two taxonomies.
const tags = tagIndex(posts).slice(0, 12);

const others = TOPICS.filter((t) => t !== topic);
---
<BaseLayout
  title={`${meta.seoTitle} | Foxe Labs`}
  description={meta.description}
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: topic, path },
    ]),
    collectionPageLd({
      name: `${topic} — Foxe Labs Blog`,
      description: meta.description,
      url: path,
      items: posts.map((post) => ({ name: post.data.title, path: `/blog/${post.id}` })),
    }),
  ]}
>
  <Nav />
  <main id="main">
    <PageHeader eyebrow="Blog" title={topic} lead={meta.description} color={topicAccent(topic).color} />

    <section class="band">
      <div class="container-x">
        <p style="margin:0 0 var(--space-400);font-size:var(--text-small);color:var(--text-subtle)">
          {posts.length} {posts.length === 1 ? 'post' : 'posts'} in {topic}.
        </p>

        <h2 class="sr-only">Articles</h2>
        <PostGrid posts={posts} />

        {tags.length > 0 && (
          <div style="margin-top:var(--space-600);padding-top:var(--space-300);border-top:1px solid var(--border)">
            <h2 style="margin-bottom:var(--space-200);font-size:var(--text-h4)">Tags in {topic}</h2>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              {tags.map((tag) => (
                <a href={tagPath(tag.slug)} class="chip chip--sm chip--muted">#{tag.label}</a>
              ))}
            </div>
          </div>
        )}

        <div style="margin-top:var(--space-600);display:flex;gap:24px;flex-wrap:wrap;font-size:var(--text-ui)">
          <a href="/blog/">All posts</a>
          {others.map((t) => <a href={topicPath(t)}>{t}</a>)}
        </div>
      </div>
    </section>
    <CtaBanner subtle />
  </main>
  <Footer />
</BaseLayout>
