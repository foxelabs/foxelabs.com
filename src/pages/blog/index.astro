---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import PostGrid from '../../components/PostGrid.astro';
import { breadcrumbLd, collectionPageLd } from '../../config/seo';
import { topicAccent } from '../../config/accents';
import { topicOf } from '../../config/tracks';
import { tagIndex, tagPath, topicPath } from '../../config/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const [lead] = posts;
const leadTopic = lead ? topicOf(lead.data.track) : 'Software';
const leadAccent = topicAccent(leadTopic);

const topics = Array.from(new Set(posts.map((p) => topicOf(p.data.track))));
const filters = ['All', ...topics];

// Tag row under the grid: the only crawlable page linking every tag archive,
// so it lists all of them rather than a top slice.
const tags = tagIndex(posts);
---
<BaseLayout
  title="Blog — WordPress Development & Trading Notes | Foxe Labs"
  description="Notes on open-source software, expert advisor design, risk, and what we're building at Foxe Labs."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
    ]),
    collectionPageLd({
      name: 'Foxe Labs Blog',
      description: "Notes on open-source software, expert advisor design, risk, and what we're building at Foxe Labs.",
      url: '/blog',
      items: posts.map((post) => ({ name: post.data.title, path: `/blog/${post.id}` })),
    }),
  ]}
>
  <Nav />
  <main id="main">
    {posts.length === 0 ? (
      <section class="band"><div class="container-x"><p style="color:var(--text-subtle)">No posts yet — check back soon.</p></div></section>
    ) : (
      <>
        <!-- Title + the lead story -->
        <section class="band band--sm band--bottom">
          <div class="container-x">
            <h1 style="font-size:var(--text-title);letter-spacing:-1.2px;margin-bottom:var(--space-150)">From the studio</h1>
            <p style="margin:0 0 var(--space-500);font-size:1.125rem;line-height:1.5;color:var(--text-subtle);max-width:560px">
              Notes on how we build — open-source software, expert advisor design, risk, and the
              occasional release.
            </p>

            <a href={`/blog/${lead.id}/`} class="card lead-card">
              <div class="card__field" style={`background:${leadAccent.color};color:${leadAccent.ink};min-height:260px;padding:0`}>
                {lead.data.heroImage && (
                  <Image
                    src={lead.data.heroImage}
                    alt={lead.data.heroImageAlt ?? lead.data.title}
                    widths={[600, 1200]}
                    sizes="(max-width: 860px) 100vw, 560px"
                    loading="eager"
                    fetchpriority="high"
                  />
                )}
              </div>
              <div style="padding:var(--space-500);display:flex;flex-direction:column;gap:var(--space-150);justify-content:center">
                <span class="chip chip--sm" style="align-self:flex-start">
                  <span class="dot" style={`background:${leadAccent.color}`} aria-hidden="true"></span>
                  {leadTopic} · Featured
                </span>
                <h2 style="font-size:1.625rem;line-height:1.2;letter-spacing:-0.5px">{lead.data.title}</h2>
                <p style="margin:0;font-size:var(--text-md);line-height:1.55;color:var(--text-subtle)">
                  {lead.data.description}
                </p>
                <span class="link-more">Read the article →</span>
              </div>
            </a>
          </div>
        </section>

        <!-- Topic filter + grid -->
        <section class="band">
          <div class="container-x">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-250);margin-bottom:var(--space-400);flex-wrap:wrap">
              <h2 style="font-size:var(--text-h2);letter-spacing:-0.6px">Latest by topic</h2>
              <div role="group" aria-label="Filter posts by topic" style="display:flex;gap:8px;flex-wrap:wrap" data-topic-filter>
                {filters.map((label) => (
                  <button
                    type="button"
                    class="tab"
                    data-topic={label}
                    aria-pressed={label === 'All' ? 'true' : 'false'}
                  >
                    {label}
                  </button>
                ))}
              </div>
            </div>

            {/* Announces the result count to screen readers after filtering. */}
            <p class="sr-only" role="status" data-filter-status></p>

            <PostGrid posts={posts} />

            <!-- Every archive URL, linked from one crawlable place. -->
            <div style="margin-top:var(--space-600);display:flex;flex-direction:column;gap:var(--space-200)">
              <span class="kicker">Browse the archives</span>
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                {topics.map((topic) => (
                  <a href={topicPath(topic)} class="chip chip--sm">
                    <span class="dot" style={`background:${topicAccent(topic).color}`} aria-hidden="true"></span>
                    {topic}
                  </a>
                ))}
                {tags.map((tag) => (
                  <a href={tagPath(tag.label)} class="chip chip--sm chip--muted">#{tag.label}</a>
                ))}
              </div>
            </div>
          </div>
        </section>
      </>
    )}

    <CtaBanner subtle />
  </main>
  <Footer />
</BaseLayout>

<style>
  .lead-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }
  @media (max-width: 860px) {
    .lead-card { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // Client-side topic filter. Every post is in the HTML; the buttons only hide
  // cards, so the page is complete with JavaScript off (and for crawlers).
  (function () {
    var bar = document.querySelector('[data-topic-filter]');
    if (!bar) return;
    var cards = document.querySelectorAll('[data-post-topic]');
    var status = document.querySelector('[data-filter-status]');

    bar.addEventListener('click', function (event) {
      var button = event.target.closest('[data-topic]');
      if (!button) return;
      var topic = button.dataset.topic;

      bar.querySelectorAll('[data-topic]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b === button));
      });
      var shown = 0;
      cards.forEach(function (card) {
        var hide = topic !== 'All' && card.dataset.postTopic !== topic;
        card.hidden = hide;
        if (!hide) shown++;
      });
      if (status) {
        status.textContent =
          shown + (shown === 1 ? ' post' : ' posts') + (topic === 'All' ? '' : ' in ' + topic);
      }
    });
  })();
</script>
