---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import PostCard from '../../components/PostCard.astro';
import Faq from '../../components/ui/Faq.astro';
import { Icon } from 'astro-icon/components';
import { articleLd, breadcrumbLd, faqLd, SITE } from '../../config/seo';
import { topicAccent } from '../../config/accents';
import { topicOf } from '../../config/tracks';
import { tagLabel, tagPath, topicPath } from '../../config/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const readingTime = Math.max(1, Math.round((post.body ?? '').trim().split(/\s+/).length / 200));

const allPosts = (await getCollection('blog', ({ data: d }) => !d.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
// Related = same track first, then anything else, newest first.
const related = [
  ...allPosts.filter((p) => p.id !== post.id && p.data.track === data.track),
  ...allPosts.filter((p) => p.id !== post.id && p.data.track !== data.track),
].slice(0, 3);

const shareUrl = `${SITE.url}/blog/${post.id}/`;

// "Published in <Topic>" points at the topic's blog archive, not the product
// track — a reader following it wants more posts, not a product listing.
const topic = topicOf(data.track);
const topicHref = topicPath(topic);
const accent = topicAccent(topic);

// No " | Foxe Labs" suffix on posts: seoTitles are already long, and the
// WebSite JSON-LD gives engines the site name.
const pageTitle = data.seoTitle ?? data.title;
const metaDescription = data.seoDescription ?? data.description;
const postPath = `/blog/${post.id}`;
// A real cover beats a generated card; posts without one fall through to the
// card BaseLayout renders for this path.
const shareImage = data.heroImage?.src;
const publishedIso = data.pubDate.toISOString();
const modifiedIso = (data.updatedDate ?? data.pubDate).toISOString();

const structuredData = [
  breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: data.title, path: postPath },
  ]),
  articleLd({
    headline: data.title,
    description: data.description,
    url: postPath,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    authorName: data.author,
    image: shareImage,
  }),
  ...(data.faq.length > 0 ? [faqLd(data.faq)] : []),
];

const shares = [
  {
    href: `https://x.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(data.title)}`,
    label: 'Share on X',
    icon: 'mingcute:social-x-line',
  },
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
    label: 'Share on LinkedIn',
    icon: 'mingcute:linkedin-line',
  },
  {
    href: `mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(shareUrl)}`,
    label: 'Share by email',
    icon: 'mingcute:mail-line',
  },
];
---
<BaseLayout
  title={pageTitle}
  description={metaDescription}
  ogType="article"
  image={shareImage}
  imageAlt={data.heroImageAlt ?? data.title}
  imageWidth={data.heroImage?.width ?? 1200}
  imageHeight={data.heroImage?.height ?? 630}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  author={data.author === SITE.name ? SITE.name : data.author}
  jsonLd={structuredData}
>
  <Nav />
  <main id="main">
    <!-- Article header -->
    <section class="band band--sm band--bottom">
      <div class="measure" style="display:flex;flex-direction:column;gap:var(--space-250)">
        <a href="/blog/" style="font-size:var(--text-small);font-weight:var(--fw-medium);color:var(--text-subtle)">
          ← Back to all posts
        </a>
        <h1 style="font-size:var(--text-h1);line-height:1.12;letter-spacing:-1px">{data.title}</h1>

        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a href={topicHref} class="chip chip--sm">
            <span class="dot" style={`background:${accent.color}`} aria-hidden="true"></span>
            {topic}
          </a>
          <span class="chip chip--sm chip--muted">{fmt(data.pubDate)}</span>
          {readingTime >= 3 && <span class="chip chip--sm chip--muted">{readingTime} min read</span>}
          <span class="chip chip--sm chip--muted">By {data.author}</span>
        </div>

        {data.heroImage && (
          <div style="border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden">
            <Image
              src={data.heroImage}
              alt={data.heroImageAlt ?? ''}
              widths={[640, 960, 1280]}
              sizes="(max-width: 800px) 100vw, 760px"
              fetchpriority="high"
              loading="eager"
              style="display:block;width:100%;height:auto"
            />
          </div>
        )}
      </div>
    </section>

    <!-- Body -->
    <article class="band band--sm">
      <div class="measure">
        <div class="prose-foxe">
          <Content />
        </div>

        {data.faq.length > 0 && (
          <div style="margin-top:var(--space-700)">
            <Faq items={data.faq} />
          </div>
        )}

        {data.tags.length > 0 && (
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:var(--space-600);padding-top:var(--space-300);border-top:1px solid var(--border)">
            {data.tags.map((t, i) => (
              <a href={tagPath(t)} class="chip chip--sm">
                <span
                  class="dot"
                  style={`background:var(--acc-${(i % 4) + 1})`}
                  aria-hidden="true"
                ></span>
                #{tagLabel(t)}
              </a>
            ))}
          </div>
        )}

        <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-300);margin-top:var(--space-400)">
          <p style="margin:0;font-size:var(--text-ui);color:var(--text-subtle)">By {data.author}</p>
          <ul style="list-style:none;margin:0;padding:0;display:flex;align-items:center;gap:16px">
            {shares.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  style="color:var(--text-subtle);display:inline-flex"
                >
                  <Icon name={s.icon} width={20} height={20} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="band band--sm band--subtle band--top">
        <div class="container-x">
          <h2 style="margin-bottom:var(--space-400);font-size:var(--text-h2);letter-spacing:-0.6px">
            Related content
          </h2>
          <div class="related-grid">
            {related.map((r) => <PostCard post={r} height={110} />)}
          </div>
        </div>
      </section>
    )}

    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

<style>
  .measure {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-300);
  }
  @media (max-width: 960px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
