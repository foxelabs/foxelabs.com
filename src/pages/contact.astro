---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { Icon } from 'astro-icon/components';
import { abs, breadcrumbLd, SITE } from '../config/seo';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Foxe Labs',
  url: abs('/contact'),
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    email: 'support@foxelabs.com',
  },
};

const channels = [
  {
    icon: 'mingcute:mail-line',
    label: 'Email',
    value: 'support@foxelabs.com',
    href: 'mailto:support@foxelabs.com',
    ink: 'var(--b500)',
    soft: 'var(--b50)',
  },
  {
    icon: 'mingcute:location-line',
    label: 'Where we are',
    value: 'Kerala, India — London & New York sessions',
    ink: 'var(--acc-teal-bold)',
    soft: 'var(--acc-teal-soft)',
  },
];

const studioSocials = [
  { href: 'https://x.com/foxelabs',            label: '@foxelabs',  icon: 'mingcute:social-x-line' },
  { href: 'https://github.com/foxelabs',       label: '@foxelabs',  icon: 'mingcute:github-line' },
  { href: 'https://youtube.com/@foxelabs',     label: '@foxelabs',  icon: 'mingcute:youtube-line' },
  { href: 'https://instagram.com/foxelabs',    label: '@foxelabs',  icon: 'mingcute:instagram-line' },
  { href: 'https://www.facebook.com/foxelabs', label: '@foxelabs',  icon: 'mingcute:facebook-line' },
];

const founderSocials = [
  { href: 'https://x.com/Joel_James',          label: '@Joel_James', icon: 'mingcute:social-x-line' },
  { href: 'https://github.com/joel-james',     label: '@joel-james', icon: 'mingcute:github-line' },
  { href: 'https://instagram.com/joeltalks',   label: '@joeltalks',  icon: 'mingcute:instagram-line' },
];
---
<BaseLayout
  title="Contact Foxe Labs — Plugin & Trading Tool Support"
  description="Questions about our software, trading tools, licensing, or a custom build? Get in touch with Foxe Labs."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
    contactLd,
  ]}
>
  <Nav />
  <main id="main">
    <Section variant="light">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-5">
          <Eyebrow class="mb-5">Contact</Eyebrow>
          <h1 style="font-size: var(--text-hero); font-weight: var(--fw-display);" class="mb-5">
            Say <span style="color: var(--accent-ink);">hello</span>.
          </h1>
          <p class="mb-8 leading-relaxed" style="font-size: var(--text-lead-sm); color: var(--ink-body);">
            A plugin question, an EA idea, licensing, or a custom build — send it
            over. No ticket queues, no tier one: your message lands in the inbox
            of the team that wrote the code.
          </p>


          <div class="grid gap-3 mb-9">
            {channels.map((c) => {
              const Tag = c.href ? 'a' : 'div';
              return (
                <Tag
                  href={c.href}
                  class:list={['contact-row flex items-center gap-3 p-3', c.href && 'contact-row--link']}
                  style={`--row-soft: ${c.soft}; --row-ink: ${c.ink}; font-size: var(--text-ui); color: var(--ink-body);`}
                >
                  <span class="w-9 h-9 shrink-0 flex items-center justify-center" style={`background: ${c.soft}; border-radius: var(--r-sm);`}>
                    <Icon name={c.icon} width={17} height={17} style={`color: ${c.ink};`} aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block" style={`font-size: var(--text-small); color: ${c.ink}; font-weight: var(--fw-bold);`}>{c.label}</span>
                    {c.value}
                  </span>
                </Tag>
              );
            })}
          </div>

          <div class="mb-7">
            <p class="mb-3" style="font-size: var(--text-small); color: var(--ink-dim); font-weight: var(--fw-subhead); text-transform: uppercase; letter-spacing: 0.06em;">
              The studio
            </p>
            <div class="flex flex-wrap gap-2">
              {studioSocials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-pill inline-flex items-center gap-1.5 lozenge"
                >
                  <Icon name={s.icon} width={14} height={14} class="social-pill__icon" aria-hidden="true" /> {s.label}
                </a>
              ))}
            </div>
          </div>

          <div>
            <p class="mb-3" style="font-size: var(--text-small); color: var(--ink-dim); font-weight: var(--fw-subhead); text-transform: uppercase; letter-spacing: 0.06em;">
              The human behind it
            </p>
            <div class="flex flex-wrap gap-2">
              {founderSocials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-pill inline-flex items-center gap-1.5 lozenge"
                >
                  <Icon name={s.icon} width={14} height={14} class="social-pill__icon" aria-hidden="true" /> {s.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="card p-7 md:p-9">
            <ContactForm />
          </div>
        </div>
      </div>
    </Section>
  </main>
  <Footer cta={false} />
</BaseLayout>

<style>
  /* Contact channels: a soft tint per channel, deepening on hover. */
  .contact-row {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-md);
    transition: border-color 180ms ease, background-color 180ms ease;
  }
  .contact-row--link:hover {
    background: var(--row-soft);
    border-color: var(--row-ink);
  }

  /* Restrained, theme-aligned social pills — neutral, no lift. */
  .social-pill {
    background: var(--surface-alt);
    color: var(--ink-body);
    border: 1px solid var(--border);
    transition: color 180ms ease, border-color 180ms ease;
  }
  .social-pill__icon {
    color: var(--ink-dim);
    transition: color 180ms ease;
  }
  .social-pill:hover {
    color: var(--ink);
    border-color: var(--accent-ink);
  }
  .social-pill:hover .social-pill__icon {
    color: var(--accent-ink);
  }
  .social-pill:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }
</style>
