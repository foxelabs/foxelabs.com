---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { abs, breadcrumbLd, SITE } from '../config/seo';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Foxe Labs',
  url: abs('/contact'),
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    email: 'support@foxelabs.com',
  },
};

const studioSocials = [
  { href: 'https://x.com/foxelabs', label: 'X' },
  { href: 'https://github.com/foxelabs', label: 'GitHub' },
  { href: 'https://youtube.com/@foxelabs', label: 'YouTube' },
  { href: 'https://instagram.com/foxelabs', label: 'Instagram' },
  { href: 'https://www.facebook.com/foxelabs', label: 'Facebook' },
];

const founderSocials = [
  { href: 'https://x.com/Joel_James', label: '@Joel_James' },
  { href: 'https://github.com/joel-james', label: '@joel-james' },
  { href: 'https://instagram.com/joeltalks', label: '@joeltalks' },
];
---
<BaseLayout
  title="Contact Foxe Labs — Support & Licensing"
  description="Questions about a plugin, a licence, or an expert advisor? Message the team that wrote the code."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
    contactLd,
  ]}
>
  <Nav />
  <main id="main">
    <section class="band band--sm">
      <div class="container-x contact-grid">
        <div style="display:flex;flex-direction:column;gap:var(--space-300);align-items:flex-start">
          <Eyebrow chip color="var(--acc-3)">Contact</Eyebrow>
          <h1 style="font-size:var(--text-title);line-height:1.06;letter-spacing:-1.3px">Say hello.</h1>
          <p style="margin:0;font-size:1.0625rem;line-height:1.6;color:var(--text-subtle)">
            A plugin question, an EA idea, licensing, or a custom build — send it over. No ticket
            queues, no tier one: your message lands in the inbox of the team that wrote the code.
          </p>
          <a href="mailto:support@foxelabs.com" class="btn btn--primary">Email support@foxelabs.com</a>

          <div
            id="support"
            class="card"
            style="padding:22px 24px;gap:18px;margin-top:8px;width:100%"
          >
            <div>
              <div class="kicker">Where we are</div>
              <div style="font-size:0.9375rem;font-weight:var(--fw-medium);margin-top:4px">
                Kerala, India — London &amp; New York sessions
              </div>
            </div>
            <div>
              <div class="kicker">The studio</div>
              <div style="display:flex;gap:14px;margin-top:6px;flex-wrap:wrap">
                {studioSocials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
                    {s.label}
                  </a>
                ))}
              </div>
            </div>
            <div>
              <div class="kicker">The human behind it</div>
              <div style="display:flex;gap:14px;margin-top:6px;flex-wrap:wrap">
                {founderSocials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener noreferrer" style="font-size:var(--text-ui);font-weight:var(--fw-medium)">
                    {s.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="card" style="align-self:start">
          <span class="accent-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <ContactForm />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-800);
  }
  @media (max-width: 960px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-500); }
  }
</style>
