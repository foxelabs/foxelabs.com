---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { Icon } from 'astro-icon/components';
import { abs, breadcrumbLd, SITE, SOCIALS } from '../config/seo';

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Foxe Labs',
  url: abs('/contact'),
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    email: 'support@foxelabs.com',
  },
};

// The studio accounts come from the one list the footer and the Organization
// markup already use, so this page cannot fall behind them.
const founderSocials = [
  { href: 'https://x.com/Joel_James', platform: 'X', label: '@Joel_James', icon: 'mingcute:social-x-line' },
  { href: 'https://github.com/joel-james', platform: 'GitHub', label: '@joel-james', icon: 'mingcute:github-line' },
  { href: 'https://instagram.com/joeltalks', platform: 'Instagram', label: '@joeltalks', icon: 'mingcute:instagram-line' },
];

// What people write about — one hue each, so the page has the home page's colour.
const topics = [
  { icon: 'mingcute:plugin-2-line', title: 'Plugin support', body: 'Setup, bugs, or a feature request.', hue: 'var(--hue-blue)' },
  { icon: 'mingcute:certificate-line', title: 'Licences & billing', body: 'Add-on keys, renewals, refunds.', hue: 'var(--hue-emerald)' },
  { icon: 'mingcute:stock-line', title: 'Trading tools', body: 'Gold Scalpel, TickerLog, or an EA idea.', hue: 'var(--hue-amber)' },
  { icon: 'mingcute:hammer-line', title: 'Custom builds', body: 'A plugin, library, or tool made to order.', hue: 'var(--hue-purple)' },
];
---
<BaseLayout
  title="Contact Foxe Labs — Support & Licensing"
  description="Questions about a plugin, a licence, or an expert advisor? Message the team that wrote the code."
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
    contactLd,
  ]}
>
  <Nav />
  <main id="main">
    <section class="page-hero">
      <div class="cellgrid" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--amber" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--emerald" aria-hidden="true"></div>
      <div class="container-x contact-grid">
        <div style="display:flex;flex-direction:column;gap:var(--space-300);align-items:flex-start">
          <span class="chip chip--muted chip--solid">
            <span class="sync-dot" aria-hidden="true"></span>
            Replies within a working day
          </span>
          <h1 style="font-size:var(--text-hero);line-height:1.05">Say <span class="contact-mark">hello.</span></h1>
          <p style="margin:0;font-size:var(--text-lead);line-height:1.55;color:var(--text-subtle)">
            A plugin question, an EA idea, licensing, or a custom build — send it over. No ticket
            queues, no tier one: your message lands in the inbox of the team that wrote the code.
          </p>
          <a href="mailto:support@foxelabs.com" class="mail-link">
            <span class="mail-link__icon" aria-hidden="true">
              <Icon name="mingcute:mail-line" width={18} height={18} />
            </span>
            <span class="mail-link__text">
              <span class="mail-link__label">Prefer email?</span>
              <span class="mail-link__address">support@foxelabs.com</span>
            </span>
          </a>

          <ul class="topic-grid">
            {topics.map((t) => (
              <li class="topic" style={`--hue:${t.hue}`}>
                <span class="icon-tile icon-tile--sm tint" aria-hidden="true"><Icon name={t.icon} size={18} /></span>
                <span>
                  <strong>{t.title}</strong>
                  <span>{t.body}</span>
                </span>
              </li>
            ))}
          </ul>

          <div
            id="support"
            class="card"
            style="padding:var(--space-300) var(--space-300);gap:var(--space-250);margin-top:8px;width:100%"
          >
            <div>
              <h2 class="kicker" style="color:var(--hue-red)">Where we are</h2>
              <div style="display:flex;align-items:center;gap:10px;font-size:var(--text-md);font-weight:var(--fw-medium);margin-top:6px">
                <span class="icon-tile icon-tile--sm tint" style="--hue:var(--hue-red)"><Icon name="mingcute:location-line" size={18} aria-hidden="true" /></span>
                Kerala, India — London &amp; New York sessions
              </div>
            </div>
            <div>
              <h2 class="kicker" style="color:var(--hue-blue)">The studio</h2>
              <div class="social-row">
                {SOCIALS.map((s) => (
                  <a href={s.href} class="social-btn social-btn--tint" aria-label={s.label} target="_blank" rel="noopener noreferrer">
                    <Icon name={s.icon} width={16} height={16} aria-hidden="true" />
                  </a>
                ))}
              </div>
            </div>
            <div>
              <h2 class="kicker" style="color:var(--hue-purple)">The human behind it</h2>
              <div class="social-row">
                {founderSocials.map((s) => (
                  <a
                    href={s.href}
                    class="social-btn social-btn--tint"
                    aria-label={`Joel James on ${s.platform} — ${s.label}`}
                    title={s.label}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name={s.icon} width={16} height={16} aria-hidden="true" />
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="card" style="align-self:start">
          <div class="form-head">
            <span class="icon-tile tint" style="--hue:var(--hue-emerald)"><Icon name="mingcute:mail-send-line" size={20} aria-hidden="true" /></span>
            <div>
              <h2 style="font-size:1.25rem">Send a message</h2>
              <span class="mono" style="font-size:var(--text-xs);color:var(--text-faint)">// lands with the people who wrote the code</span>
            </div>
          </div>
          <ContactForm />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* The address, not a call to action: the form beside it is the primary path,
     so email reads as a quiet alternative rather than a second button. */
  .mail-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-150);
    padding: var(--space-125) var(--space-200) var(--space-125) var(--space-125);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    color: var(--text);
    transition: background-color 0.1s ease, border-color 0.1s ease;
  }
  .mail-link:hover { background: color-mix(in srgb, var(--hue-amber) 6%, var(--bg-card)); border-color: color-mix(in srgb, var(--hue-amber) 40%, var(--border)); text-decoration: none; }
  .mail-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--hue-amber) 14%, transparent);
    color: var(--hue-amber);
    flex: none;
  }
  .mail-link__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
  }
  .mail-link__label {
    font-size: var(--text-xs);
    line-height: 1.2;
    color: var(--text-subtle);
  }
  .mail-link__address {
    font-size: var(--text-md);
    line-height: 1.25;
    font-weight: var(--fw-medium);
  }

  .hero-glow { position: absolute; width: 720px; height: 560px; pointer-events: none; }
  .hero-glow--amber {
    top: -180px; right: -120px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--hue-amber) 9%, transparent), transparent);
  }
  .hero-glow--emerald {
    bottom: -220px; left: -140px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--hue-emerald) 8%, transparent), transparent);
  }
  .contact-mark { position: relative; display: inline-block; }
  .contact-mark::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0.08em; height: 0.18em;
    background: color-mix(in srgb, var(--hue-amber) 22%, transparent);
    z-index: -1;
  }
  .topic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-250) var(--space-200);
    width: 100%;
  }
  .topic {
    display: flex;
    gap: var(--space-125);
    align-items: flex-start;
  }
  .topic > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .topic strong { font-size: var(--text-md); color: var(--text); font-weight: var(--fw-heading); }
  .topic > span:last-child > span { font-size: var(--text-small); color: var(--text-subtle); line-height: 1.4; }
  .social-btn--tint:hover { color: var(--hue-amber); border-color: color-mix(in srgb, var(--hue-amber) 45%, var(--border)); }
  .form-head {
    display: flex;
    align-items: center;
    gap: var(--space-150);
    padding: var(--space-300) var(--space-400) 0;
  }
  @media (max-width: 520px) {
    .topic-grid { grid-template-columns: 1fr; }
  }

  .contact-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-800);
  }
  @media (max-width: 960px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-500); }
  }
</style>
