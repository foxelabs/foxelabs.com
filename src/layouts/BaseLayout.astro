---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { SITE, organizationLd, websiteLd } from '../config/seo';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a share image. Defaults to the site banner. */
  image?: string;
  /** Alt text for the share image. */
  imageAlt?: string;
  /** Pixel size of the share image. Defaults to the site banner's 1200×630. */
  imageWidth?: number;
  imageHeight?: number;
  /** Open Graph object type, e.g. 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search indexes (e.g. 404). */
  noindex?: boolean;
  /** Article metadata — only used when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** Extra JSON-LD node(s) for this page, on top of the sitewide Organization + WebSite. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Foxe Labs — Open-Source WordPress Tools & Trading Software',
  description = 'Open-source software and trading tools — WordPress plugins, PHP libraries, expert advisors, and a universal trading journal. Built in-house at Foxe Labs.',
  image = '/social-banner.jpg',
  imageAlt = 'Foxe Labs — open-source software and trading tools',
  imageWidth = 1200,
  imageHeight = 630,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;
const ogImageType = ogImage.endsWith('.png')
  ? 'image/png'
  : ogImage.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';

// Sitewide structured data + any page-specific nodes, deduped into one array.
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [organizationLd(), websiteLd(), ...pageLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {/* One icon for every theme: white fox head in a rounded black tile, so it
        reads on light and dark tabs alike. .ico is the fallback for browsers
        without SVG icons — Safari never uses the SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Foxe Labs Blog" href="/rss.xml" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161A1D" media="(prefers-color-scheme: dark)" />
    {/* Runs before the first paint so a dark-theme visitor never sees a white
        flash. It is deliberately inline and un-bundled for that reason. */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('foxe-theme');
          const theme =
            stored ??
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    {structuredData.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
    {import.meta.env.PROD && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "33c34e18a89d4d40ba323b8e1dfe0ba3"}'
      />
    )}
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <script is:inline>
      // The header button flips the theme and remembers the choice. Until
      // someone chooses, the site follows the operating system.
      (function () {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]:not([media])');
        document.addEventListener('click', function (event) {
          const button = event.target.closest('[data-theme-toggle]');
          if (!button) return;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          if (meta) meta.setAttribute('content', next === 'dark' ? '#161A1D' : '#FFFFFF');
          try {
            localStorage.setItem('foxe-theme', next);
          } catch (e) {
            /* Private mode and blocked storage: the toggle still works for this page. */
          }
        });
      })();
    </script>
    <slot />

    <script is:inline>
      (function () {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const nodes = document.querySelectorAll('[data-reveal]');
        if (prefersReduced || !('IntersectionObserver' in window)) {
          nodes.forEach((n) => n.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          // Fire as soon as any part of the section is near the viewport.
          // A percentage threshold silently fails on sections taller than the
          // viewport — 12% of them can never be on screen at once, so they
          // would stay at opacity 0 forever.
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        nodes.forEach((n) => io.observe(n));
      })();
    </script>
  </body>
</html>
