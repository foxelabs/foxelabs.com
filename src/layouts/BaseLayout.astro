---
import '../styles/global.css';
import { SITE, organizationLd, websiteLd } from '../config/seo';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a share image. Defaults to the site banner. */
  image?: string;
  /** Alt text for the share image. */
  imageAlt?: string;
  /** Open Graph object type, e.g. 'article' for blog posts. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search indexes (e.g. 404). */
  noindex?: boolean;
  /** Article metadata — only used when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** Extra JSON-LD node(s) for this page, on top of the sitewide Organization + WebSite. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Foxe Labs — Open-Source WordPress Tools & Trading Software',
  description = 'Open-source software and trading tools — WordPress plugins, PHP libraries, expert advisors, and a universal trading journal. Built in-house at Foxe Labs.',
  image = '/social-banner.png',
  imageAlt = 'Foxe Labs — open-source software and trading tools',
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;

// Sitewide structured data + any page-specific nodes, deduped into one array.
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [organizationLd(), websiteLd(), ...pageLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {/* Black fox on light tabs, white fox on dark tabs (via prefers-color-scheme). */}
    <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href="/favicon-black/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href="/favicon-black/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href="/favicon-white/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)" href="/favicon-white/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-white/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d0d0f" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    {structuredData.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
  </head>
  <body>
    <slot />

    <script is:inline>
      (function () {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const nodes = document.querySelectorAll('[data-reveal]');
        if (prefersReduced || !('IntersectionObserver' in window)) {
          nodes.forEach((n) => n.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        nodes.forEach((n) => io.observe(n));
      })();
    </script>
  </body>
</html>
