---
// Site header. A single flat row: brand, four section links, one primary
// action. The mega-menus are gone — the track trees live on the hub pages
// they belong to, not in the chrome of every page.
const path = Astro.url.pathname;
const isActive = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);

const links = [
  { href: '/software/', label: 'Software' },
  { href: '/trading/', label: 'Trading' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---

<header class="nav">
  <a href="/" class="brand" aria-label="Foxe Labs — home">
    <span class="brand-mark" style="width:28px;height:28px" aria-hidden="true"></span>
    <span class="brand__name">Foxe Labs</span>
  </a>

  <button
    class="nav__toggle"
    type="button"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="nav-links"
    data-nav-toggle
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M3 6h18M3 12h18M3 18h18" />
    </svg>
  </button>

  <nav class="nav__links" id="nav-links" aria-label="Main">
    {links.map((l) => (
      <a href={l.href} class="nav__link" aria-current={isActive(l.href)}>{l.label}</a>
    ))}
  </nav>

  <a href="/contact/" class="btn btn--primary btn--sm">Contact</a>
</header>

<script is:inline>
  // The narrow-screen menu. The list is hidden by the [hidden] attribute so it
  // is closed before hydration and stays closed with JavaScript off — where the
  // toggle button is never shown either.
  (function () {
    var button = document.querySelector('[data-nav-toggle]');
    var list = document.getElementById('nav-links');
    if (!button || !list) return;

    var mq = window.matchMedia('(max-width: 760px)');
    var sync = function () {
      // Above the breakpoint the row is always visible; below it, closed.
      list.hidden = mq.matches;
      button.setAttribute('aria-expanded', 'false');
    };
    sync();
    mq.addEventListener('change', sync);

    button.addEventListener('click', function () {
      var open = list.hidden;
      list.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
