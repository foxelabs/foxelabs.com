---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';

const products = [
  {
    title: 'Expert Advisors',
    description:
      'Battle-tested MQL5 EAs for XAUUSD and prop firm accounts. ICT/SMC-based strategies with rigorous risk controls.',
    badge: 'Live now',
    href: '/trading/expert-advisors',
    icon: 'bot',
    featured: true,
    tone: '',
  },
  {
    title: 'TickerLog',
    description:
      'A universal trading journal that syncs with your broker, analyzes your patterns, and helps you trade better.',
    badge: 'Coming soon',
    href: '#waitlist',
    icon: 'book',
    tone: 'tone-2',
  },
  {
    title: 'Trading Tools',
    description:
      'Indicators, dashboards, and utilities for TradingView Pine Script and MT5. Built for precision.',
    badge: 'Coming soon',
    href: '/trading/tools',
    icon: 'chart',
    tone: 'tone-3',
  },
];
---
<Section id="products" variant="light">
  <div class="max-w-2xl mb-14">
    <Eyebrow class="mb-5">What we're building</Eyebrow>
    <h2 style="font-size: var(--text-h2); font-weight: 800;" class="mb-4">
      Small, sharp tools — each built deep.
    </h2>
    <p style="font-size: var(--text-lead); color: var(--ink-body);">
      Not a platform that tries to do everything. Three products, each solving one
      real problem we hit on a live account.
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {products.map((p) => (
      <article class={`card card--hover p-7 flex flex-col ${p.tone}`} style={p.featured ? 'border-color: var(--accent);' : ''}>
        <div
          class="w-11 h-11 rounded-xl flex items-center justify-center mb-6"
          style="background: var(--accent-soft);"
        >
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="var(--accent-ink)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {p.icon === 'bot' && <><rect x="4" y="7" width="16" height="12" rx="2.5" /><line x1="12" y1="3" x2="12" y2="7" /><circle cx="12" cy="3" r="1" fill="var(--accent-ink)" /><circle cx="9" cy="13" r="1.2" fill="var(--accent-ink)" /><circle cx="15" cy="13" r="1.2" fill="var(--accent-ink)" /><line x1="9" y1="17" x2="15" y2="17" /></>}
            {p.icon === 'book' && <><path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z" /><line x1="8" y1="9" x2="14" y2="9" /><line x1="8" y1="13" x2="14" y2="13" /></>}
            {p.icon === 'chart' && <><line x1="4" y1="20" x2="20" y2="20" /><rect x="6" y="12" width="3" height="6" /><rect x="11" y="8" width="3" height="10" /><rect x="16" y="5" width="3" height="13" /></>}
          </svg>
        </div>

        <h3 style="font-size: var(--text-h3); font-weight: 800;" class="mb-3">{p.title}</h3>
        <p class="text-[15px] mb-7 flex-1" style="color: var(--ink-body);">{p.description}</p>

        <div class="flex items-center justify-between gap-4">
          <Button href={p.href} variant="ghost" arrow class="!py-2 !px-4 !text-[13px]">
            Details
          </Button>
          <span
            class="font-mono text-[10px] px-2.5 py-1.5 rounded-full whitespace-nowrap"
            style="background: var(--accent-soft); color: var(--accent-deep); letter-spacing: 0.08em;"
          >
            {p.badge}
          </span>
        </div>
      </article>
    ))}
  </div>
</Section>
