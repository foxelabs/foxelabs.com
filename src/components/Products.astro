---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import { ACCENTS, accentVars, categoryAccent } from '../config/accents';

// Categories, not products. TickerLog is a product inside Trading Tools and
// lives on its own page — it was listed here as if it were a third category.
const products = [
  {
    title: 'Expert Advisors',
    description:
      'Automated MQL5 strategies for XAUUSD and prop firm accounts, engineered risk-first. Gold Scalpel is live on the MQL5 Market.',
    badge: 'Live now',
    href: '/trading/expert-advisors/',
    icon: 'bot',
    accent: categoryAccent('expert-advisors'),
  },
  {
    title: 'Trading Tools',
    description:
      'TickerLog, our universal trading journal, plus the indicators and dashboards we build for our own desks.',
    badge: 'Launching soon',
    href: '/trading/tools/',
    icon: 'book',
    accent: categoryAccent('tools'),
  },
  {
    title: 'Custom builds',
    description:
      'A strategy of your own that needs coding properly, or a tool that does not exist yet. Tell us what you are trading.',
    badge: 'By request',
    href: '/contact/',
    icon: 'chart',
    accent: ACCENTS[4],
  },
];
---
<Section id="products" variant="light">
  <div class="max-w-2xl mb-14">
    <Eyebrow class="mb-5">What we're building</Eyebrow>
    <h2 style="font-size: var(--text-h2); font-weight: var(--fw-display);" class="mb-4">
      Small, sharp tools — each built deep.
    </h2>
    <p style="font-size: var(--text-lead); color: var(--ink-body);">
      Not a platform that tries to do everything. Focused tools, each solving one
      real problem we hit on a live account.
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {products.map((p) => (
      <article class="category-card card card--hover p-7 flex flex-col" style={accentVars(p.accent)}>
        <div
          class="w-11 h-11 rounded-[8px] flex items-center justify-center mb-6"
          style="background: var(--accent-soft);"
        >
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="var(--accent-ink)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {p.icon === 'bot' && <><rect x="4" y="7" width="16" height="12" rx="2.5" /><line x1="12" y1="3" x2="12" y2="7" /><circle cx="12" cy="3" r="1" fill="var(--accent-ink)" /><circle cx="9" cy="13" r="1.2" fill="var(--accent-ink)" /><circle cx="15" cy="13" r="1.2" fill="var(--accent-ink)" /><line x1="9" y1="17" x2="15" y2="17" /></>}
            {p.icon === 'book' && <><path d="M4 4h11a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z" /><line x1="8" y1="9" x2="14" y2="9" /><line x1="8" y1="13" x2="14" y2="13" /></>}
            {p.icon === 'chart' && <><line x1="4" y1="20" x2="20" y2="20" /><rect x="6" y="12" width="3" height="6" /><rect x="11" y="8" width="3" height="10" /><rect x="16" y="5" width="3" height="13" /></>}
          </svg>
        </div>

        <h3 style="font-size: var(--text-h3); font-weight: var(--fw-heading);" class="mb-3">{p.title}</h3>
        <p class="mb-7 flex-1" style="font-size: var(--text-ui); color: var(--ink-body);">{p.description}</p>

        <div class="flex items-center justify-between gap-4">
          <Button href={p.href} variant="ghost" arrow size="sm">
            Details
          </Button>
          <span
            class="lozenge whitespace-nowrap"
            style="background: var(--accent-soft); color: var(--accent-deep);"
          >
            {p.badge}
          </span>
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  /* Same top-rule treatment the software hub and product grids use. */
  .category-card {
    position: relative;
    border-top: 3px solid var(--accent-ink);
  }
  /* Stretched link: the Details button's hit area covers the whole card, so
     the card is clickable anywhere while the button stays the visible cue. */
  .category-card :global(a.btn)::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .category-card h3 {
    transition: color 0.1s ease;
  }
  .category-card:hover h3 {
    color: var(--accent-ink);
  }
</style>
