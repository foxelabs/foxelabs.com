---
// Google Analytics 4, kept off the main thread until the visitor does something.
//
// gtag.js costs ~166KB and ~340ms of main-thread work that nothing on the page
// waits for. Loading it on idle still spent that budget inside the page's first
// few seconds, so it now waits for the first real interaction — a pointer, a
// key, a scroll, or a touch. The dataLayer queue and the config command still
// run immediately, so the pageview keeps its true load timestamp and flushes
// the moment the script arrives.
//
// The trade: a visitor who opens the page, scrolls nothing, touches nothing and
// leaves is not counted. pagehide gives that case a last chance to fire, but a
// browser tearing the page down may not finish the request.
const GA_ID = 'G-JJEWCLB8DK';
---
{import.meta.env.PROD && (
  <>
    {/* Warms DNS + TLS only; costs nothing on the critical path and saves a
        round trip when the deferred script is finally requested. */}
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      // send_page_view fires from the queue, so the pageview is timestamped at
      // load rather than whenever the script happens to arrive.
      gtag('config', GA_ID);

      (function () {
        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        var loaded = false;
        function loadGa() {
          if (loaded) return;
          loaded = true;
          events.forEach(function (e) { removeEventListener(e, loadGa); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        events.forEach(function (e) {
          addEventListener(e, loadGa, { once: true, passive: true });
        });
        // Backstop for a visitor who leaves without interacting at all.
        addEventListener('pagehide', loadGa, { once: true });
      })();
    </script>
  </>
)}
