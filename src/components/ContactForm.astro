---
// Field and label classes live in global.css so every form matches.
---
<form data-contact-form novalidate style="width:100%">
  <div data-fields style="padding:32px;display:flex;flex-direction:column;gap:18px">
    <div class="form-row">
      <label class="field-label" for="c-name">
        Name
        <input
          id="c-name" type="text" name="name" required maxlength="120" placeholder="Your name"
          class="field"
        />
      </label>
      <label class="field-label" for="c-email">
        Email
        <input
          id="c-email" type="email" name="email" required placeholder="you@example.com"
          class="field"
        />
      </label>
    </div>

    <label class="field-label" for="c-subject">
      Subject
      <input
        id="c-subject" type="text" name="subject" required maxlength="150" placeholder="What's it about?"
        class="field"
      />
    </label>

    <label class="field-label" for="c-license">
      License key (optional)
      <input
        id="c-license" type="text" name="license" maxlength="120" placeholder="FXL-XXXX-XXXX"
        autocomplete="off" spellcheck="false"
        class="field field--mono"
      />
    </label>

    <label class="field-label" for="c-message">
      Message
      <textarea
        id="c-message" name="message" required rows="6" maxlength="5000"
        placeholder="Tell us what you need — the more detail, the faster the answer."
        class="field"
      ></textarea>
    </label>

    <!-- Honeypot -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"
      style="display:none" />

    <button type="submit" data-submit class="btn btn--primary" style="padding:13px 24px">
      <span data-label-text>Send message</span>
    </button>

    <p data-error role="alert" hidden style="margin:0;font-size:var(--text-ui);color:var(--bad)">
      Something went wrong. Try again or email support@foxelabs.com.
    </p>
  </div>

  <div
    data-success
    role="status"
    tabindex="-1"
    hidden
    style="padding:56px 40px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px"
  >
    <span
      style="width:44px;height:44px;border-radius:var(--r-md);background:var(--acc-4);display:flex;align-items:center;justify-content:center;color:#1D1E20;font-size:22px;font-weight:var(--fw-display)"
      aria-hidden="true"
    >✓</span>
    <h2 style="font-size:1.5rem">Message sent — caught by the fox.</h2>
    <p style="margin:0;font-size:0.9375rem;line-height:1.55;color:var(--text-subtle)">
      It just landed in the inbox. Expect a reply within one business day (IST).
    </p>
    <button
      type="button"
      data-reset
      style="all:unset;box-sizing:border-box;cursor:pointer;font-family:inherit;font-size:var(--text-ui);font-weight:var(--fw-medium);color:var(--link);margin-top:6px"
    >
      Send another message
    </button>
  </div>
</form>

<style>
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-200);
  }
  @media (max-width: 520px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    var form = document.querySelector('[data-contact-form]');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    var fields = form.querySelector('[data-fields]');
    var success = form.querySelector('[data-success]');
    var errorEl = form.querySelector('[data-error]');
    var labelText = form.querySelector('[data-label-text]');
    var resetButton = form.querySelector('[data-reset]');
    var inputs = form.querySelectorAll('input, textarea, button');

    function setLoading(loading) {
      inputs.forEach(function (el) {
        el.disabled = loading;
      });
      labelText.textContent = loading ? 'Sending…' : 'Send message';
    }

    resetButton.addEventListener('click', function () {
      form.reset();
      setLoading(false);
      form.dataset.submitting = '0';
      success.hidden = true;
      fields.hidden = false;
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (form.dataset.submitting === '1') return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      form.dataset.submitting = '1';
      errorEl.hidden = true;
      setLoading(true);

      var payload = {
        name: form.querySelector('[name="name"]').value,
        email: form.querySelector('[name="email"]').value,
        subject: form.querySelector('[name="subject"]').value,
        license: form.querySelector('[name="license"]').value,
        message: form.querySelector('[name="message"]').value,
        company: form.querySelector('[name="company"]').value,
      };

      try {
        var res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('request failed');
        fields.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (err) {
        errorEl.hidden = false;
        setLoading(false);
        form.dataset.submitting = '0';
      }
    });
  })();
</script>
