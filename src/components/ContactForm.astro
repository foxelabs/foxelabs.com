---
const fieldClass =
  'px-4 py-3 text-[15px] border rounded-xl outline-none transition-colors disabled:opacity-60 placeholder:text-[var(--ink-dim)]';
const fieldStyle = 'border-color: var(--border); background: var(--surface); color: var(--ink);';
const labelClass = 'font-mono text-[11px] uppercase';
const labelStyle = 'color: var(--ink-dim); letter-spacing: 0.12em;';
---
<form data-contact-form class="w-full" novalidate>
  <div data-fields class="flex flex-col gap-5">
    <div class="grid sm:grid-cols-2 gap-5">
      <div class="flex flex-col gap-2">
        <label for="c-name" class={labelClass} style={labelStyle}>Name</label>
        <input
          id="c-name" type="text" name="name" required maxlength="120" placeholder="Jane Trader"
          class={fieldClass} style={fieldStyle}
        />
      </div>
      <div class="flex flex-col gap-2">
        <label for="c-email" class={labelClass} style={labelStyle}>Email</label>
        <input
          id="c-email" type="email" name="email" required placeholder="you@domain.com"
          class={fieldClass} style={fieldStyle}
        />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label for="c-message" class={labelClass} style={labelStyle}>Message</label>
      <textarea
        id="c-message" name="message" required rows="6" maxlength="5000" placeholder="What's on your mind?"
        class={`${fieldClass} resize-y`} style={fieldStyle}
      ></textarea>
    </div>

    <!-- Honeypot -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"
      class="hidden" style="display:none" />

    <button
      type="submit" data-submit
      class="btn btn--primary self-start !py-3 !px-6 disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span data-label-text>Send message</span>
      <svg data-spinner class="hidden animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity="0.25" />
        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div data-success class="hidden flex-col items-center text-center py-6">
    <span data-success-mark class="inline-flex items-center justify-center rounded-full mb-5"
      style="width: 64px; height: 64px; background: color-mix(in srgb, var(--accent) 14%, transparent);">
      <svg width="34" height="34" viewBox="0 0 52 52" fill="none" aria-hidden="true">
        <circle class="sm-ring" cx="26" cy="26" r="24" stroke="var(--accent-ink)" stroke-width="3" fill="none" />
        <path class="sm-tick" d="M15 27l7.5 7.5L38 19" stroke="var(--accent-ink)" stroke-width="3.5"
          stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </svg>
    </span>
    <p class="text-lg font-semibold mb-1.5" style="color: var(--ink);">Message sent — caught by the fox. 🦊</p>
    <p class="text-sm m-0" style="color: var(--ink-body);">
      It just landed in the inbox. Expect a reply within a day, IST fox time.
    </p>
  </div>
  <p data-error class="hidden mt-4 text-sm font-mono" style="color: var(--red);">
    Something went wrong. Try again or email support@foxelabs.com.
  </p>
</form>

<style>
  [data-success]:not(.hidden) { display: flex; }

  [data-success]:not(.hidden) .sm-ring {
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: sm-draw 520ms ease-out forwards;
  }
  [data-success]:not(.hidden) .sm-tick {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: sm-draw 340ms ease-out 420ms forwards;
  }
  [data-success]:not(.hidden) [data-success-mark] {
    animation: sm-pop 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes sm-draw { to { stroke-dashoffset: 0; } }
  @keyframes sm-pop {
    0% { transform: scale(0.6); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-success]:not(.hidden) .sm-ring,
    [data-success]:not(.hidden) .sm-tick { animation: none; stroke-dashoffset: 0; }
    [data-success]:not(.hidden) [data-success-mark] { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    const form = document.querySelector('[data-contact-form]');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const fields = form.querySelector('[data-fields]');
    const success = form.querySelector('[data-success]');
    const errorEl = form.querySelector('[data-error]');
    const button = form.querySelector('[data-submit]');
    const labelText = form.querySelector('[data-label-text]');
    const spinner = form.querySelector('[data-spinner]');
    const inputs = form.querySelectorAll('input, textarea, button');

    function setLoading(loading) {
      inputs.forEach((el) => (el.disabled = loading));
      labelText.textContent = loading ? 'Sending…' : 'Send message';
      spinner.classList.toggle('hidden', !loading);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.submitting === '1') return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      form.dataset.submitting = '1';
      errorEl.classList.add('hidden');
      setLoading(true);

      const payload = {
        name: form.querySelector('[name="name"]').value,
        email: form.querySelector('[name="email"]').value,
        message: form.querySelector('[name="message"]').value,
        company: form.querySelector('[name="company"]').value,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('request failed');
        fields.classList.add('hidden');
        success.classList.remove('hidden');
      } catch {
        errorEl.classList.remove('hidden');
        setLoading(false);
        form.dataset.submitting = '0';
      }
    });
  })();
</script>
