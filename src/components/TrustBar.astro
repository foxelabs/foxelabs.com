---
/** One qualitative trust item. Icons are drawn inline so the bar has no
 *  icon-font dependency; `tint` colours the stroke only (decorative). */
interface TrustItem {
  label: string;
  icon: 'code' | 'shield' | 'eye' | 'user' | 'box' | 'doc' | 'refresh';
  tint: string;
}

interface Props {
  items?: TrustItem[];
}

// Default set = the trading hub's bar.
const { items = [
  { label: 'MQL5 + Pine Script', icon: 'code', tint: 'var(--acc-green)' },
  { label: 'Prop firm ready', icon: 'shield', tint: 'var(--acc-orange)' },
  { label: 'Documented logic — no black boxes', icon: 'eye', tint: 'var(--acc-red-bright)' },
  { label: 'Built by live traders', icon: 'user', tint: 'var(--acc-purple)' },
] } = Astro.props;
---
<div class="band--invert" style="padding-block: 28px;">
  <div class="container-x">
    <ul class="flex flex-wrap items-center justify-center gap-x-14 gap-y-4 list-none m-0 p-0">
      {items.map((it) => (
        <li class="flex items-center gap-2.5" style="font-size: var(--text-ui); font-weight: var(--fw-medium); color: var(--ink-invert-dim);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={it.tint} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {it.icon === 'code' && <><polyline points="8 6 3 12 8 18" /><polyline points="16 6 21 12 16 18" /></>}
            {it.icon === 'shield' && <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z" />}
            {it.icon === 'eye' && <><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" /><circle cx="12" cy="12" r="2.5" /></>}
            {it.icon === 'user' && <><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></>}
            {it.icon === 'box' && <><path d="M21 8v11H3V8" /><rect x="2" y="4" width="20" height="4" /><line x1="10" y1="12" x2="14" y2="12" /></>}
            {it.icon === 'doc' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><polyline points="9 15 11 17 15 13" /></>}
            {it.icon === 'refresh' && <><polyline points="23 4 23 10 17 10" /><path d="M20.5 15a9 9 0 1 1-2.1-9.4L23 10" /></>}
          </svg>
          {it.label}
        </li>
      ))}
    </ul>
  </div>
</div>
