---
const items = [
  { label: 'MQL5 + Pine Script', icon: 'code', tint: 'var(--gold)' },
  { label: 'Prop firm ready', icon: 'shield', tint: 'var(--amber)' },
  { label: 'Documented logic — no black boxes', icon: 'eye', tint: 'var(--clay)' },
  { label: 'Built by a live trader', icon: 'user', tint: 'var(--gold)' },
];
---
<div class="band--invert" style="padding-block: 28px;">
  <div class="container-x">
    <ul class="flex flex-wrap items-center justify-center gap-x-14 gap-y-4 list-none m-0 p-0">
      {items.map((it) => (
        <li class="flex items-center gap-2.5 text-[13px] font-medium" style="color: var(--ink-invert-dim);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={it.tint} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {it.icon === 'code' && <polyline points="8 6 3 12 8 18" />}
            {it.icon === 'code' && <polyline points="16 6 21 12 16 18" />}
            {it.icon === 'shield' && <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z" />}
            {it.icon === 'eye' && <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" />}
            {it.icon === 'eye' && <circle cx="12" cy="12" r="2.5" />}
            {it.icon === 'user' && <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />}
            {it.icon === 'user' && <circle cx="12" cy="7" r="4" />}
          </svg>
          {it.label}
        </li>
      ))}
    </ul>
  </div>
</div>
