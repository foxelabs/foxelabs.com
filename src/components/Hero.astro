---
import EmailForm from './EmailForm.astro';
import Eyebrow from './ui/Eyebrow.astro';

const candles = [
  { x: 12,  wTop: 40, wBot: 92, bTop: 60, bH: 22, up: true  },
  { x: 30,  wTop: 32, wBot: 78, bTop: 44, bH: 22, up: false },
  { x: 48,  wTop: 46, wBot: 96, bTop: 62, bH: 24, up: true  },
  { x: 66,  wTop: 38, wBot: 86, bTop: 52, bH: 22, up: true  },
  { x: 84,  wTop: 30, wBot: 74, bTop: 42, bH: 24, up: false },
  { x: 102, wTop: 36, wBot: 82, bTop: 50, bH: 22, up: true  },
  { x: 120, wTop: 24, wBot: 70, bTop: 38, bH: 22, up: true  },
  { x: 138, wTop: 20, wBot: 60, bTop: 32, bH: 20, up: false },
  { x: 156, wTop: 14, wBot: 54, bTop: 24, bH: 22, up: true  },
  { x: 174, wTop: 10, wBot: 48, bTop: 20, bH: 20, up: true  },
  { x: 192, wTop: 18, wBot: 44, bTop: 28, bH: 12, up: false },
  { x: 210, wTop: 6,  wBot: 36, bTop: 14, bH: 18, up: true  },
];

// ADS accent hues — illustration only, no track identity.
const UP = 'var(--acc-green)';
const DOWN = 'var(--acc-red)';
---
<section class="band overflow-hidden" data-reveal style="background: var(--surface);">
  <div class="container-x">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <Eyebrow class="mb-6">Algo trading tools · new track, since 2025</Eyebrow>

        <h1 style="font-size: var(--text-hero); font-weight: var(--fw-display);" class="mb-6">
          Built for traders who run on <span style="color: var(--b400);">edge</span>.
        </h1>

        <p class="mb-9 max-w-[520px] leading-relaxed" style="font-size: var(--text-lead-sm); color: var(--ink-body);">
          Expert advisors, a universal trading journal, and precision tools —
          engineered for prop firm traders and serious algo traders.
        </p>

        <EmailForm id="hero-form" />

        <p class="mt-4 text-[13px]" style="color: var(--ink-dim);">
          No spam. First to know when products ship.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="tile" style="--accent-soft: var(--n100); padding: var(--space-300);">
          <div class="flex items-center justify-between mb-5">
            <span class="text-[14px]" style="color: var(--ink); font-weight: var(--fw-bold);">XAUUSD · M15</span>
            <span class="lozenge">Backtest</span>
          </div>

          <svg viewBox="0 0 220 130" class="w-full h-auto" style="max-height: 150px;" role="img" aria-label="Illustrative XAUUSD candlestick chart with a rising trend line">
            <g stroke="var(--border)" stroke-width="0.5">
              <line x1="0" y1="20"  x2="220" y2="20" />
              <line x1="0" y1="50"  x2="220" y2="50" />
              <line x1="0" y1="80"  x2="220" y2="80" />
              <line x1="0" y1="110" x2="220" y2="110" />
            </g>

            {candles.map((c) => (
              <g stroke={c.up ? UP : DOWN} fill={c.up ? UP : DOWN}>
                <line x1={c.x} y1={c.wTop} x2={c.x} y2={c.wBot} stroke-width="1" />
                <rect x={c.x - 4} y={c.bTop} width="8" height={c.bH} stroke="none" />
              </g>
            ))}

            <line
              class="trend-line"
              x1="10" y1="100" x2="216" y2="20"
              stroke="var(--b400)" stroke-width="1.4" stroke-dasharray="4 3" fill="none"
            />
          </svg>

          <div class="grid grid-cols-3 gap-4 mt-6 pt-5" style="border-top: 1px solid var(--border);">
            {[
              ['Focus', 'XAUUSD'],
              ['Sessions', 'LDN · NY'],
              ['Risk', 'Hard limits'],
            ].map(([label, value]) => (
              <div>
                <p class="text-[12px] mb-1" style="color: var(--ink-dim);">{label}</p>
                <p class="font-display text-[16px]" style="color: var(--ink); font-weight: var(--fw-heading);">{value}</p>
              </div>
            ))}
          </div>
        </div>

        <p class="mt-3 text-center text-[12px]" style="color: var(--ink-dim);">
          Illustrative chart — not a performance claim.
        </p>
      </div>
    </div>
  </div>
</section>
