---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';

const stats = [
  { value: 'XAUUSD', label: 'Primary focus', note: 'London and New York sessions.' },
  { value: 'MQL5', label: 'Core stack', note: 'Plus Pine Script and MT5 tooling.' },
  { value: 'In-house', label: 'End to end', note: 'Design, code and support, all under one roof.' },
];
---
<Section id="about" variant="light">
  <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-7">
      <Eyebrow class="mb-5">Behind the studio</Eyebrow>
      <h2 style="font-size: var(--text-h2); font-weight: 700;" class="mb-6">
        A trader who builds like an engineer.
      </h2>

      <div class="space-y-5" style="font-size: var(--text-lead); color: var(--ink-body);">
        <p>
          Foxe Labs is a one-person studio building the trading tools I wished existed.
          Every product starts from a real problem on a live account — a missing risk
          control, a journal that doesn't fit how I trade, an indicator that lies on
          higher timeframes.
        </p>
        <p>
          The focus is XAUUSD, prop firm challenges, and ICT/SMC-driven systems. The
          bias is toward small, sharp tools that do one thing well — not bloated
          platforms that try to do everything.
        </p>
        <p>
          Based in Kerala, India. Trading the London and New York sessions.
        </p>
      </div>
    </div>

    <div class="lg:col-span-5 flex flex-col justify-center gap-8">
      {stats.map((s) => (
        <div class="pl-6" style="border-left: 2px solid var(--gold);">
          <p class="font-display font-bold mb-1" style="font-size: 1.75rem; color: var(--ink);">{s.value}</p>
          <p class="font-mono text-[11px] mb-1.5" style="color: var(--gold-ink); letter-spacing: 0.1em; text-transform: uppercase;">{s.label}</p>
          <p class="text-[14px]" style="color: var(--ink-body);">{s.note}</p>
        </div>
      ))}
    </div>
  </div>
</Section>
