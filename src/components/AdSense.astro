---
// Google AdSense site verification. The loader tag is what AdSense checks for
// when confirming ownership of the domain; it also serves any ad units added
// later. Production only, so local and preview builds stay clean.
//
// is:inline keeps the tag exactly as written — without it Astro treats the
// script as one of its own and bundles it away, and AdSense then sees nothing.
const ADSENSE_CLIENT = 'ca-pub-3721468428020034';
const ADSENSE_SRC = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`;
---
{import.meta.env.PROD && (
  <script is:inline async src={ADSENSE_SRC} crossorigin="anonymous"></script>
)}
