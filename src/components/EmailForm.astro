---
interface Props {
  id?: string;
  buttonLabel?: string;
}
// Each instance needs its own id, or two forms on one page cross-wire their
// aria-describedby error references.
const uid = crypto.randomUUID().slice(0, 8);
const { id = `email-form-${uid}`, buttonLabel = 'Get early access' } = Astro.props;
---
<form data-email-form id={id} novalidate style="width:100%">
  <!-- Honeypot: humans never see it; bots that fill it get a fake 200. -->
  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

  <label class="field-label" for={`${id}-email`} style="margin-bottom:6px">Email address</label>
  <div data-fields class="email-row">
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@domain.com"
      aria-describedby={`${id}-error`}
      class="field"
      style="flex:1"
    />
    <button type="submit" data-submit data-label={buttonLabel} class="btn btn--primary" style="flex:none">
      <span data-label-text>{buttonLabel}</span>
    </button>
  </div>

  <p
    data-success
    role="status"
    tabindex="-1"
    hidden
    style="margin:var(--space-150) 0 0;font-size:var(--text-ui);color:var(--ok)"
  >
    You're on the list!
  </p>
  <p
    data-error
    id={`${id}-error`}
    role="alert"
    hidden
    style="margin:var(--space-150) 0 0;font-size:var(--text-ui);color:var(--bad)"
  >
    Something went wrong. Try again.
  </p>
</form>

<style>
  .email-row {
    display: flex;
    gap: var(--space-125);
  }
  .email-row[hidden] { display: none; }
  @media (max-width: 520px) {
    .email-row { flex-direction: column; }
  }
</style>

<script is:inline>
  (function () {
    if (window.__waitlistFormBound) return;
    window.__waitlistFormBound = true;

    function bind(form) {
      if (form.dataset.bound === '1') return;
      form.dataset.bound = '1';

      var input = form.querySelector('input[name="email"]');
      var success = form.querySelector('[data-success]');
      var errorEl = form.querySelector('[data-error]');
      var fields = form.querySelector('[data-fields]');
      var button = form.querySelector('[data-submit]');
      var labelText = form.querySelector('[data-label-text]');
      var idleLabel = button.getAttribute('data-label') || labelText.textContent;
      var defaultError = errorEl.textContent;

      function setLoading(loading) {
        // aria-disabled + readOnly instead of disabled: a disabled control
        // drops keyboard focus to <body> mid-request; a read-only one keeps it.
        button.setAttribute('aria-disabled', String(loading));
        input.readOnly = loading;
        labelText.textContent = loading ? 'Sending…' : idleLabel;
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (form.dataset.submitting === '1') return;

        if (!input.value || !input.checkValidity()) {
          errorEl.textContent = 'Please enter a valid email address.';
          errorEl.hidden = false;
          input.focus();
          return;
        }

        form.dataset.submitting = '1';
        errorEl.textContent = defaultError;
        errorEl.hidden = true;
        setLoading(true);

        try {
          var res = await fetch('/api/waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: input.value,
              website: form.querySelector('input[name="website"]').value,
            }),
          });
          if (!res.ok) {
            var detail = null;
            try { detail = (await res.json()).error; } catch (_) {}
            errorEl.textContent =
              res.status === 429
                ? 'Too many requests — wait a minute and try again.'
                : detail || defaultError;
            errorEl.hidden = false;
            setLoading(false);
            form.dataset.submitting = '0';
            return;
          }
          fields.hidden = true;
          success.hidden = false;
          success.focus();
        } catch (err) {
          errorEl.hidden = false;
          setLoading(false);
          form.dataset.submitting = '0';
        }
      });
    }

    function bindAll() {
      document.querySelectorAll('[data-email-form]').forEach(bind);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindAll);
    } else {
      bindAll();
    }
  })();
</script>
