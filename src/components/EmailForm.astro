---
interface Props {
  id?: string;
  buttonLabel?: string;
  tone?: 'light' | 'invert';
}
const {
  id = 'email-form',
  buttonLabel = 'Get early access',
  tone = 'light',
} = Astro.props;


// --chart-up clears AA on the navy band, where --accent (b400) sits at ~3.2:1.
const successColor = tone === 'invert' ? 'var(--chart-up)' : 'var(--accent-ink)';
const errorColor = tone === 'invert' ? 'var(--red-invert)' : 'var(--red)';
---
<form data-email-form id={id} class="w-full max-w-md" novalidate>
  <!-- Honeypot: humans never see it; bots that fill it get a fake 200. -->
  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
  <div data-fields class="flex flex-col sm:flex-row gap-2.5">
    <input
      type="email"
      name="email"
      required
      placeholder="you@domain.com"
      aria-label="Email address"
      aria-describedby={`${id}-error`}
      class:list={['field flex-1', tone === 'invert' && 'field--invert']}
    />
    <button
      type="submit"
      data-submit
      data-label={buttonLabel}
      class="btn btn--primary shrink-0 justify-center disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span data-label-text>{buttonLabel}</span>
      <svg data-spinner class="hidden animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity="0.25" />
        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <p data-success role="status" tabindex="-1" class="hidden mt-3 text-[14px]" style={`color: ${successColor};`}>
    You're on the list!
  </p>
  <p data-error id={`${id}-error`} role="alert" class="hidden mt-3 text-[14px]" style={`color: ${errorColor};`}>
    Something went wrong. Try again.
  </p>
</form>

<script is:inline>
  (function () {
    if (window.__waitlistFormBound) return;
    window.__waitlistFormBound = true;

    function bind(form) {
      if (form.dataset.bound === '1') return;
      form.dataset.bound = '1';

      const input = form.querySelector('input[name="email"]');
      const success = form.querySelector('[data-success]');
      const errorEl = form.querySelector('[data-error]');
      const fields = form.querySelector('[data-fields]');
      const button = form.querySelector('[data-submit]');
      const labelText = form.querySelector('[data-label-text]');
      const spinner = form.querySelector('[data-spinner]');
      const idleLabel = button.getAttribute('data-label') || labelText.textContent;
      const defaultError = errorEl.textContent;

      function setLoading(loading) {
        button.disabled = loading;
        input.disabled = loading;
        if (loading) {
          labelText.textContent = 'Sending…';
          spinner.classList.remove('hidden');
        } else {
          labelText.textContent = idleLabel;
          spinner.classList.add('hidden');
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.dataset.submitting === '1') return;

        if (!input.value || !input.checkValidity()) {
          errorEl.textContent = 'Please enter a valid email address.';
          errorEl.classList.remove('hidden');
          input.focus();
          return;
        }

        form.dataset.submitting = '1';
        errorEl.textContent = defaultError;
        errorEl.classList.add('hidden');
        setLoading(true);

        try {
          const res = await fetch('/api/waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: input.value,
              website: form.querySelector('input[name="website"]').value,
            }),
          });
          if (!res.ok) throw new Error('request failed');
          fields.classList.add('hidden');
          success.classList.remove('hidden');
          success.focus();
        } catch {
          errorEl.classList.remove('hidden');
          setLoading(false);
          form.dataset.submitting = '0';
        }
      });
    }

    function bindAll() {
      document.querySelectorAll('[data-email-form]').forEach(bind);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindAll);
    } else {
      bindAll();
    }
  })();
</script>
