---
// The blog's post card grid — used by /blog and by both archive types, so a
// post looks the same wherever it is listed.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { accentVars, topicAccent } from '../config/accents';
import { postTopic, topicPath } from '../config/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Set on each card for the /blog index's client-side topic filter. */
  filterable?: boolean;
}

const { posts, filterable = false } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-7 gap-y-11">
  {posts.map((post) => (
    <a
      href={`/blog/${post.id}/`}
      class="post-link group flex flex-col"
      data-post-topic={filterable ? postTopic(post) : undefined}
      style={accentVars(topicAccent(postTopic(post)))}
    >
      {post.data.heroImage && (
        <Image
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
          widths={[400, 640, 800]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 368px"
          loading="lazy"
          class="w-full h-auto block mb-5"
          style="aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--r-md);"
        />
      )}
      <p class="post-kicker mb-2.5">Article <span style="color: var(--ink-dim);">in</span> <span style="color: var(--accent-ink);">{postTopic(post)}</span></p>
      <h3 class="post-link__title mb-2.5" style="font-size: var(--text-h3);">{post.data.title}</h3>
      <p class="m-0" style="font-size: var(--text-ui); color: var(--ink-body);">{post.data.description}</p>
      <time class="mt-3" style="font-size: var(--text-small); color: var(--ink-dim);">{fmt(post.data.pubDate)}</time>
    </a>
  ))}
</div>

<style>
  /* Each card carries its topic's --accent-*, so the title picks up the same
     hue as its kicker and its filter pill. */
  .post-link__title {
    transition: color 0.1s ease;
  }
  .post-link:hover .post-link__title {
    color: var(--accent-ink);
  }
</style>
