---
// The blog's post card grid — used by /blog and by both archive types, so a
// post looks the same wherever it is listed.
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Three across on the blog index; the archives use the same width. */
  columns?: 3;
  showExcerpt?: boolean;
  showDate?: boolean;
}

const { posts, showExcerpt = true, showDate = true } = Astro.props;
---
<div class="grid-3">
  {posts.map((post) => (
    <PostCard post={post} showExcerpt={showExcerpt} showDate={showDate} />
  ))}
</div>
