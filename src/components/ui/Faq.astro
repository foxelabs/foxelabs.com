---
import type { FaqItem } from '../../config/seo';

interface Props {
  items: FaqItem[];
  /** Heading above the list. */
  heading?: string;
  /** Open the first answer by default, so the pattern is obvious at a glance. */
  openFirst?: boolean;
  class?: string;
}

const {
  items,
  heading = 'Frequently asked questions',
  openFirst = true,
  class: className = '',
} = Astro.props;
---
{/* Native <details> keeps every answer in the served HTML — collapsed for
    readers, but fully present for crawlers and answer engines, and it needs
    no JavaScript to work. */}
{items.length > 0 && (
  <div class:list={[className]} style="max-width: var(--measure); margin-inline: auto;">
    {heading && (
      <h2 style="margin-bottom: var(--space-400); font-size: var(--text-h2); letter-spacing: -0.6px;">
        {heading}
      </h2>
    )}
    <div class="faq">
      {items.map((item, i) => (
        <details class="faq__item" open={openFirst && i === 0}>
          <summary class="faq__q">{item.q}</summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
)}
