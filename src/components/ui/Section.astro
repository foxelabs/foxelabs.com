---
interface Props {
  /** light = page surface, alt = sunken band, ink = the black band. */
  variant?: 'light' | 'alt' | 'ink';
  /** Hairline above/below the band. */
  rule?: 'top' | 'bottom' | 'both';
  size?: 'md' | 'sm';
  id?: string;
  class?: string;
  /** Skip the inner .container-x when the section manages its own width. */
  bare?: boolean;
}

const {
  variant = 'light',
  rule,
  size = 'md',
  id,
  bare = false,
  class: className = '',
} = Astro.props;

const variantClass = variant === 'alt' ? 'band--subtle' : variant === 'ink' ? 'band--ink' : '';
---
<section
  id={id}
  class:list={[
    'band',
    size === 'sm' && 'band--sm',
    variantClass,
    (rule === 'top' || rule === 'both') && 'band--top',
    (rule === 'bottom' || rule === 'both') && 'band--bottom',
    className,
  ]}
>
  {bare ? <slot /> : <div class="container-x"><slot /></div>}
</section>
