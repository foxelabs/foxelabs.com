---
// The Foxe mark. Drawn as a background image rather than an <img> so the
// stylesheet can swap the white artwork for the black one on the light theme;
// the file is fetched once and cached across the site, which an inlined copy
// of the path would not be. Decorative — the brand link carries the label.
interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className = '' } = Astro.props;
---
<span
  class:list={['brand-logo', className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
></span>
