---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'invert';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  arrow = false,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const cls = `btn btn--${variant} ${className}`;

// External links (and mailto/tel) open in a new tab, unless the caller already
// set target explicitly. rel guards against tab-nabbing on the new context.
const isExternal = !!href && /^(https?:)?\/\//.test(href);
const external =
  isExternal && rest.target === undefined
    ? { target: '_blank', rel: 'noopener noreferrer' }
    : {};
---
<Tag
  class={cls}
  href={href}
  type={href ? undefined : type}
  {...external}
  {...rest}
>
  <slot />
  {arrow && (
    <span class="btn__arrow" aria-hidden="true">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7" />
        <polyline points="8 7 17 7 17 16" />
      </svg>
    </span>
  )}
</Tag>
