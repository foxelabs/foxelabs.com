---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'sm';
  /** true appends a forward arrow; 'back' prepends a left-pointing one. */
  arrow?: boolean | 'back';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  arrow = false,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

// External links (and mailto/tel) open in a new tab, unless the caller already
// set target explicitly. rel guards against tab-nabbing on the new context.
const isExternal = !!href && /^(https?:)?\/\//.test(href);
const external =
  isExternal && rest.target === undefined
    ? { target: '_blank', rel: 'noopener noreferrer' }
    : {};
---
<Tag
  class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', className]}
  href={href}
  type={href ? undefined : type}
  {...external}
  {...rest}
>
  {arrow === 'back' && <span aria-hidden="true">←</span>}
  <slot />
  {arrow === true && <span aria-hidden="true">→</span>}
</Tag>
