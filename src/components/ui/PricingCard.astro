---
// Paid-product purchase card: a big price, a commercial
// value checklist, and a slot for the CTA(s), resource links and fine print.
// Used on add-on and trading product pages.
import { Icon } from 'astro-icon/components';

interface Props {
  /** e.g. "From $29.99" or "$149 · one-time". Parsed into kicker/amount/qualifier. */
  price?: string;
  /** Small pill above the price, e.g. "Premium add-on". */
  badge?: string;
  /** Commercial "what you get" lines (licensing/updates/support) — not features. */
  benefits?: string[];
  /** Hue for the checklist ticks — the product's own. */
  hue?: string;
  class?: string;
}

const { price = '', badge, benefits = [], hue = 'var(--hue-emerald)', class: className = '' } = Astro.props;

// Split "From $29.99 · one-time" → kicker "From", amount "$29.99", qualifier "one-time".
const raw = price.trim();
const kickerMatch = raw.match(/^(from|starting at)\s+/i);
const kicker = kickerMatch ? kickerMatch[1] : '';
const afterKicker = kickerMatch ? raw.slice(kickerMatch[0].length) : raw;
const [amount, ...qParts] = afterKicker.split('·').map((s) => s.trim());
const qualifier = qParts.join(' · ');

---
<div class:list={['card', className]} style="align-self:start">
  <div style="padding:var(--space-300);display:flex;flex-direction:column;gap:var(--space-300)">
    {badge && (
      <span class="chip chip--sm chip--muted chip--solid" style="align-self:flex-start">
        <span class="sync-dot" aria-hidden="true"></span>
        {badge}
      </span>
    )}

    {amount && (
      <div>
        {kicker && <div class="kicker">{kicker}</div>}
        <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-top:4px">
          <span style="font-family:var(--font-display);font-size:2.5rem;line-height:1;font-weight:var(--fw-display);letter-spacing:-0.02em">
            {amount}
          </span>
          {qualifier && <span style="font-size:var(--text-md);color:var(--text-subtle)">{qualifier}</span>}
        </div>
      </div>
    )}

    {benefits.length > 0 && (
      <ul class="dot-list" style={`--dot-hue:${hue}`}>
        {benefits.map((b) => (
          <li style={`font-size:var(--text-ui);line-height:1.5;color:var(--text-subtle)`}>
            <Icon name="mingcute:check-line" size={16} style="color:var(--dot-hue);flex:none" aria-hidden="true" />
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}

    <slot />
  </div>
</div>
