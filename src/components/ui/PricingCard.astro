---
// Paid-product purchase card: the four-colour rule, a big price, a commercial
// value checklist, and a slot for the CTA(s), resource links and fine print.
// Used on add-on and trading product pages.
interface Props {
  /** e.g. "From $29.99" or "$149 · one-time". Parsed into kicker/amount/qualifier. */
  price?: string;
  /** Small pill above the price, e.g. "Premium add-on". */
  badge?: string;
  /** Commercial "what you get" lines (licensing/updates/support) — not features. */
  benefits?: string[];
  class?: string;
}

const { price = '', badge, benefits = [], class: className = '' } = Astro.props;

// Split "From $29.99 · one-time" → kicker "From", amount "$29.99", qualifier "one-time".
const raw = price.trim();
const kickerMatch = raw.match(/^(from|starting at)\s+/i);
const kicker = kickerMatch ? kickerMatch[1] : '';
const afterKicker = kickerMatch ? raw.slice(kickerMatch[0].length) : raw;
const [amount, ...qParts] = afterKicker.split('·').map((s) => s.trim());
const qualifier = qParts.join(' · ');

const quad = ['var(--acc-1)', 'var(--acc-2)', 'var(--acc-3)', 'var(--acc-4)'];
---
<div class:list={['card', className]} style="align-self:start">
  <span class="accent-rule" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

  <div style="padding:24px;display:flex;flex-direction:column;gap:var(--space-300)">
    {badge && <span class="chip chip--sm" style="align-self:flex-start">{badge}</span>}

    {amount && (
      <div>
        {kicker && <div class="kicker">{kicker}</div>}
        <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-top:4px">
          <span style="font-size:2.5rem;line-height:1;font-weight:var(--fw-display);letter-spacing:-0.02em">
            {amount}
          </span>
          {qualifier && <span style="font-size:0.9375rem;color:var(--text-subtle)">{qualifier}</span>}
        </div>
      </div>
    )}

    {benefits.length > 0 && (
      <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px">
        {benefits.map((b, i) => (
          <li style="display:flex;align-items:flex-start;gap:10px;font-size:var(--text-ui);line-height:1.5;color:var(--text-subtle)">
            <span
              class="dot"
              style={`background:${quad[i % 4]};margin-top:4px`}
              aria-hidden="true"
            ></span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}

    <slot />
  </div>
</div>
