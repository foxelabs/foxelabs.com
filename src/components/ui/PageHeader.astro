---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Dot colour on the eyebrow chip. */
  color?: string;
  /** Back link above the title, e.g. "← All WordPress Plugins". */
  back?: { href: string; label: string };
}

const { eyebrow, title, lead, color = 'var(--acc-1)', back } = Astro.props;
---
<section class="band band--sm band--bottom">
  <div class="container-x">
    <div style="display:flex;flex-direction:column;gap:var(--space-250);align-items:flex-start;max-width:760px">
      {back && (
        <a href={back.href} style="font-size:var(--text-small);font-weight:var(--fw-medium);color:var(--text-subtle)">
          ← {back.label}
        </a>
      )}
      {eyebrow && <Eyebrow chip color={color}>{eyebrow}</Eyebrow>}
      <h1 style="font-size:var(--text-title);letter-spacing:-1.2px">{title}</h1>
      {lead && (
        <p style="margin:0;max-width:600px;font-size:1.125rem;line-height:1.5;color:var(--text-subtle)">
          {lead}
        </p>
      )}
    </div>
  </div>
</section>
