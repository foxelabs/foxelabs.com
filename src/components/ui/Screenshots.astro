---
// The product tour: one row per captured screen, image and copy trading sides
// down the page. Every screen is on the page at once — nothing is hidden behind
// a tab, so the whole tour is readable, linkable and crawlable.
import { Image } from 'astro:assets';

interface Shot {
  src: ImageMetadata;
  alt: string;
  tab: string;
  heading: string;
  body: string;
  caption?: string;
  crumb?: string;
}

interface Props {
  id: string;
  shots: Shot[];
  heading: string;
  lead?: string;
}

const { id, shots, heading, lead } = Astro.props;
const quad = ['var(--acc-1)', 'var(--acc-2)', 'var(--acc-3)', 'var(--acc-4)'];
---
<div id={id}>
  <div style="max-width:620px;margin-bottom:var(--space-600)">
    <h2 style="margin-bottom:8px;font-size:var(--text-h2);letter-spacing:-0.6px">{heading}</h2>
    {lead && (
      <p style="margin:0;font-size:var(--text-body);line-height:1.55;color:var(--ink-band-subtle)">{lead}</p>
    )}
  </div>

  <div class="tour">
    {shots.map((shot, i) => (
      <div class:list={['tour__row', i % 2 === 1 && 'tour__row--flip']}>
        <div class="tour__shot">
          <Image
            src={shot.src}
            alt={shot.alt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 860px) 100vw, 560px"
            loading={i === 0 ? 'eager' : 'lazy'}
            style="display:block;width:100%;height:auto"
          />
        </div>
        <div class="tour__copy">
          <span class="chip chip--sm" style="align-self:flex-start">
            <span class="dot" style={`background:${quad[i % 4]}`} aria-hidden="true"></span>
            {shot.crumb ?? shot.tab}
          </span>
          <h3 style="font-size:var(--text-h3)">{shot.heading}</h3>
          <p style="margin:0;font-size:0.9375rem;line-height:1.6;color:var(--ink-band-subtle)">{shot.body}</p>
          {shot.caption && (
            <p style="margin:0;font-size:var(--text-small);line-height:1.5;color:var(--ink-band-faint);font-style:italic">
              {shot.caption}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .tour {
    display: flex;
    flex-direction: column;
    gap: var(--space-800);
  }
  .tour__row {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: var(--space-600);
    align-items: center;
  }
  /* Odd rows put the copy first, so the eye zig-zags down the page. */
  .tour__row--flip .tour__shot { order: 2; }
  .tour__shot {
    border: 1px solid var(--ink-band-border);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .tour__copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 860px) {
    .tour { gap: var(--space-600); }
    /* Stacked, the alternation reads as inconsistency — every row goes
       image-then-copy instead. */
    .tour__row { grid-template-columns: 1fr; gap: var(--space-300); }
    .tour__row--flip .tour__shot { order: 0; }
  }
</style>
