---
// The admin tour: tabbed screens on the ink band. One tab per captured screen,
// each with the path it lives at, a heading, and a caption.
import { Image } from 'astro:assets';

interface Shot {
  src: ImageMetadata;
  alt: string;
  tab: string;
  heading: string;
  body: string;
  caption?: string;
  crumb?: string;
}

interface Props {
  id: string;
  shots: Shot[];
  heading: string;
  lead?: string;
}

const { id, shots, heading, lead } = Astro.props;
const quad = ['var(--acc-1)', 'var(--acc-2)', 'var(--acc-3)', 'var(--acc-4)'];
---
<div data-tour={id}>
  <h2 style="margin-bottom:8px;font-size:var(--text-h2);letter-spacing:-0.6px">{heading}</h2>
  {lead && (
    <p style="margin:0 0 var(--space-400);font-size:var(--text-body);color:var(--ink-band-subtle)">{lead}</p>
  )}

  {shots.length > 1 && (
    <div role="tablist" aria-label={heading} aria-orientation="horizontal" style="display:flex;gap:8px;margin-bottom:var(--space-350);flex-wrap:wrap">
      {shots.map((shot, i) => (
        <button
          type="button"
          class="tab"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? undefined : '-1'}
        >
          {shot.tab}
        </button>
      ))}
    </div>
  )}

  {shots.map((shot, i) => (
    <div
      id={`${id}-panel-${i}`}
      role="tabpanel"
      aria-labelledby={`${id}-tab-${i}`}
      hidden={i !== 0}
      tabindex="0"
      class="tour-panel"
    >
      <div class="tour-panel__shot">
        <Image
          src={shot.src}
          alt={shot.alt}
          widths={[640, 960, 1280]}
          sizes="(max-width: 960px) 100vw, 620px"
          loading={i === 0 ? 'eager' : 'lazy'}
          style="display:block;width:100%;height:auto"
        />
      </div>
      <div class="tour-panel__copy">
        {shot.crumb && (
          <span class="chip chip--sm" style="align-self:flex-start">
            <span class="dot" style={`background:${quad[i % 4]}`} aria-hidden="true"></span>
            {shot.crumb}
          </span>
        )}
        <h3 style="font-size:var(--text-h3)">{shot.heading}</h3>
        <p style="margin:0;font-size:var(--text-md);line-height:1.6;color:var(--ink-band-subtle)">{shot.body}</p>
        {shot.caption && (
          <p style="margin:0;font-size:var(--text-small);line-height:1.5;color:var(--ink-band-faint);font-style:italic">
            {shot.caption}
          </p>
        )}
      </div>
    </div>
  ))}
</div>


<script is:inline>
  // Tabs. Every panel is in the HTML; the buttons only toggle [hidden], so all
  // of the copy is served whether or not the script runs.
  (function () {
    document.querySelectorAll('[data-tour]').forEach(function (tour) {
      var list = tour.querySelector('[role="tablist"]');
      if (!list) return;
      var tabs = Array.prototype.slice.call(list.querySelectorAll('[role="tab"]'));
      var panels = Array.prototype.slice.call(tour.querySelectorAll('[role="tabpanel"]'));

      function select(index) {
        tabs.forEach(function (tab, i) {
          tab.setAttribute('aria-selected', String(i === index));
          if (i === index) tab.removeAttribute('tabindex');
          else tab.setAttribute('tabindex', '-1');
        });
        panels.forEach(function (panel, i) {
          panel.hidden = i !== index;
        });
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          select(i);
        });
        tab.addEventListener('keydown', function (event) {
          var next =
            event.key === 'ArrowRight' ? i + 1
            : event.key === 'ArrowLeft' ? i - 1
            : event.key === 'Home' ? 0
            : event.key === 'End' ? tabs.length - 1
            : null;
          if (next === null) return;
          event.preventDefault();
          var target = (next + tabs.length) % tabs.length;
          select(target);
          tabs[target].focus();
        });
      });
    });
  })();
</script>
