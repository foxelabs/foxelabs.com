---
interface Props {
  variant?: 'light' | 'invert';
  hover?: boolean;
  as?: string;
  class?: string;
}

const {
  variant = 'light',
  hover = false,
  as: Tag = 'div',
  class: className = '',
} = Astro.props;

const cls = [
  'card',
  variant === 'invert' ? 'card--invert' : '',
  hover ? 'card--hover' : '',
  className,
].filter(Boolean).join(' ');
---
<Tag class={cls}><slot /></Tag>
