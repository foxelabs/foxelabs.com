---
interface Props {
  class?: string;
  /** Render as a bordered pill with a coloured dot, rather than a plain kicker. */
  chip?: boolean;
  /** Dot colour for the chip form. */
  color?: string;
}
const { class: className = '', chip = false, color = 'var(--acc-1)' } = Astro.props;
---
{chip ? (
  <span class:list={['chip', 'chip--muted', className]}>
    <span class="dot" style={`background:${color}`} aria-hidden="true"></span>
    <slot />
  </span>
) : (
  <span class:list={['eyebrow', className]}><slot /></span>
)}
