---
// The "how we build" 4-up: an accent-tinted icon (or a plain mark), a short
// title, one line of copy. One component for the four pages that render it,
// so the block cannot drift.
import { Icon } from 'astro-icon/components';

interface Item {
  title: string;
  color: string;
  body: string;
  /** Iconify name, e.g. 'mingcute:shield-line'. Falls back to the dot. */
  icon?: string;
}
interface Props {
  items: Item[];
  /** On the ink band the copy uses the band's own subtle colour. */
  onInk?: boolean;
}
const { items, onInk = false } = Astro.props;
const bodyColor = onInk ? 'var(--ink-band-subtle)' : 'var(--text-subtle)';
---
<div class="grid-4">
  {items.map((p) => (
    <div style="display:flex;flex-direction:column;gap:var(--space-125)">
      {p.icon ? (
        <span
          class="icon-tile icon-tile--sm"
          style={`background:color-mix(in srgb, ${p.color} 14%, transparent);color:${p.color}`}
        >
          <Icon name={p.icon} size={20} aria-hidden="true" />
        </span>
      ) : (
        <span class="dot dot--lg" style={`background:${p.color}`} aria-hidden="true"></span>
      )}
      <h3 style="font-size:var(--text-body-lg);font-weight:var(--fw-heading)">{p.title}</h3>
      <p style={`margin:0;font-size:var(--text-ui);line-height:1.55;color:${bodyColor}`}>
        {p.body}
      </p>
    </div>
  ))}
</div>
