---
// The "how we build" cards, in the home page's principle style: a numbered
// tinted chip, the icon in the same hue, a title and one line of copy.
import { Icon } from 'astro-icon/components';

interface Item {
  title: string;
  color: string;
  body: string;
  icon?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<div class="grid-4">
  {items.map((p, i) => (
    <div class="card card--pad" style="gap:var(--space-150)">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <span class="step-chip tint" style={`--hue:${p.color}`}>{String(i + 1).padStart(2, '0')}</span>
        {p.icon && <Icon name={p.icon} size={20} style={`color:${p.color}`} aria-hidden="true" />}
      </div>
      <h3 style="font-size:1.125rem">{p.title}</h3>
      <p style="margin:0;font-size:var(--text-md);line-height:1.55">{p.body}</p>
    </div>
  ))}
</div>
