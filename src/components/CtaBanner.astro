---
import EmailForm from './EmailForm.astro';
import Eyebrow from './ui/Eyebrow.astro';
---
<section id="waitlist" class="band band--invert band--glow" data-reveal>
  <div class="container-x">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-6">
        <Eyebrow class="mb-5">Waitlist</Eyebrow>
        <h2 style="font-size: var(--text-h2); font-weight: 800;" class="mb-4">
          Be first when we launch.
        </h2>
        <p style="font-size: var(--text-lead); color: var(--ink-invert-dim);">
          Early access, launch pricing, and product updates — no spam, unsubscribe anytime.
        </p>
      </div>
      <div class="lg:col-span-6 lg:justify-self-end w-full">
        <EmailForm id="cta-form" tone="invert" />
      </div>
    </div>
  </div>
</section>
