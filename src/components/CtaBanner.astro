---
// The closing band. Same shape on every page it appears on: the four-colour
// rule, one heading, one line, two actions.
interface Props {
  heading?: string;
  body?: string;
  /** Sit on the sunken surface with a hairline above, rather than on white. */
  subtle?: boolean;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const {
  heading = 'Learn how we can help you build better.',
  body = 'Questions about a plugin, a licence, or an expert advisor — ask and get a straight answer from the team that wrote the code.',
  subtle = false,
  primary = { href: '/contact/', label: 'Contact us' },
  secondary = { href: '/software/', label: 'Browse the software' },
} = Astro.props;
---

<section class:list={['band', subtle && 'band--subtle band--top']}>
  <div class="container-x" style="text-align:center">
    <div
      style="max-width:680px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:20px"
    >
      <span class="accent-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      <h2 style="font-size:var(--text-h2-lg);letter-spacing:-0.8px">{heading}</h2>
      <p style="margin:0;font-size:1.03125rem;line-height:1.55;color:var(--text-subtle)">{body}</p>
      <div style="display:flex;gap:12px;margin-top:8px;flex-wrap:wrap;justify-content:center">
        <a href={primary.href} class="btn btn--primary">{primary.label}</a>
        <a href={secondary.href} class="btn btn--ghost">{secondary.label}</a>
      </div>
    </div>
  </div>
</section>
